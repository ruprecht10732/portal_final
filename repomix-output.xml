<file path="src/app/routes/organization/organization-overview/organization-overview.component.html">
<shared-page-layout
  [title]="'organization.profileTitle' | translate"
  [subtitle]="'organization.profileSubtitle' | translate"
  [error]="errorMessage()"
>
  @if (isLoading()) {
    <div class="mx-auto w-full max-w-4xl flex flex-col gap-6 py-6">
      <shared-skeleton height="10rem" width="100%" />
      <shared-skeleton height="14rem" width="100%" />
      <shared-skeleton height="16rem" width="100%" />
    </div>
  } @else {
    <div class="mx-auto w-full max-w-4xl flex flex-col gap-6 py-6">

      <!-- Logo -->
      <shared-card>
        <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-6">
          {{ 'organization.logo.title' | translate }}
        </h4>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
          @if (logoUrl()) {
            <div class="group relative shrink-0">
              <img
                [src]="logoUrl()"
                [alt]="name() || 'Organization logo'"
                class="h-24 w-24 rounded-2xl object-cover border border-zinc-200 bg-white shadow-sm transition-transform group-hover:scale-105"
              />
              <button
                (click)="deleteLogo()"
                [disabled]="logoDeletingInProgress()"
                class="absolute -right-2 -top-2 flex h-7 w-7 items-center justify-center rounded-full bg-white border border-zinc-200 text-zinc-400 shadow-sm hover:text-red-600 hover:border-red-200 transition-all active:scale-90"
                aria-label="Remove logo"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          } @else {
            <div class="h-24 w-24 shrink-0 rounded-2xl bg-zinc-50 border-2 border-dashed border-zinc-200 flex items-center justify-center text-zinc-300">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
            </div>
          }

          <div class="flex-1 min-w-0">
            <app-file-uploader
              [label]="'organization.logo.select' | translate"
              [helpText]="'organization.logo.helpText' | translate"
              [accept]="'image/*'"
              [buttonLabel]="'organization.logo.upload' | translate"
              [uploadingLabel]="'organization.logo.uploading' | translate"
              [errorFallback]="'organization.logo.uploadFailed' | translate"
              [maxSizeBytes]="5242880"
              [maxSizeError]="'organization.logo.maxSize' | translate"
              [disabled]="isSaving() || isLoading()"
              [presign]="presignLogo"
              [finalize]="finalizeLogo"
            />
          </div>
        </div>
      </shared-card>

      <!-- Core Details -->
      <shared-card>
        <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-6">
          {{ 'organization.fields.coreDetails' | translate }}
        </h4>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <shared-input
            class="sm:col-span-2"
            [label]="'organization.fields.name' | translate"
            [value]="name()"
            (valueChange)="name.set($event)"
            [error]="nameError()"
            [required]="true"
          />
          <shared-input
            [label]="'organization.fields.email' | translate"
            [value]="email()"
            (valueChange)="email.set($event)"
            [error]="emailError()"
          />
          <shared-input
            [label]="'organization.fields.phone' | translate"
            [value]="phone()"
            (valueChange)="phone.set($event)"
          />
          <shared-input
            [label]="'organization.fields.vatNumber' | translate"
            [value]="vatNumber()"
            (valueChange)="vatNumber.set($event)"
            [error]="vatError()"
          />
          <shared-input
            [label]="'organization.fields.kvkNumber' | translate"
            [value]="kvkNumber()"
            (valueChange)="kvkNumber.set($event)"
            [error]="kvkError()"
          />
        </div>
      </shared-card>

      <!-- Location -->
      <shared-card>
        <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-6">
          {{ 'organization.fields.location' | translate }}
        </h4>

        <div class="flex flex-col gap-5">
          <shared-autocomplete
            [label]="'organization.fields.addressLine1' | translate"
            [value]="addressLine1()"
            (valueChange)="onAddressLine1Change($event)"
            [options]="addressOptions()"
            [filterMode]="'manual'"
            [placeholder]="'Search business address...'"
          />
          <shared-input
            [label]="'organization.fields.addressLine2' | translate"
            [value]="addressLine2()"
            (valueChange)="addressLine2.set($event)"
          />
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <shared-input
              [label]="'organization.fields.postalCode' | translate"
              [value]="postalCode()"
              (valueChange)="postalCode.set($event)"
            />
            <shared-input
              [label]="'organization.fields.city' | translate"
              [value]="city()"
              (valueChange)="city.set($event)"
            />
          </div>
          <shared-input
            [label]="'organization.fields.country' | translate"
            [value]="country()"
            (valueChange)="country.set($event)"
          />
        </div>
      </shared-card>

      <!-- Footer -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <div>
          @if (successMessage()) {
            <p class="text-sm font-bold text-emerald-600 flex items-center gap-2">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              {{ successMessage() }}
            </p>
          } @else {
            <p class="text-xs text-zinc-400">{{ 'organization.legalDisclaimer' | translate }}</p>
          }
        </div>

        <shared-button
          variant="primary"
          [disabled]="!canSave() || isSaving()"
          [loading]="isSaving()"
          [fullWidth]="false"
          (clicked)="save()"
        >
          {{ 'organization.save' | translate }}
        </shared-button>
      </div>

    </div>
  }
</shared-page-layout>
</file>

<file path="src/app/routes/partners/partners-create/partners-create.component.html">
<div class="flex flex-col w-full pb-16 sm:pb-0">
  <shared-page-header
    [title]="'partners.form.newPartner' | translate"
    [subtitle]="'partners.form.subtitle' | translate"
    [backAriaLabel]="'partners.form.goBack' | translate"
    (back)="cancel()"
  ></shared-page-header>

  @if (error()) {
    <div class="bg-red-50 border-b border-red-500 text-red-900 p-4 text-sm font-medium flex items-start gap-3">
      <span class="font-bold uppercase text-red-600 shrink-0">{{ 'partners.form.errorLabel' | translate }}</span>
      <span>{{ error() }}</span>
    </div>
  }

  <form [formGroup]="form" (ngSubmit)="save()" class="flex-1 flex flex-col">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 sm:p-6">
      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">01</span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
            {{ 'partners.form.companyInfo' | translate }}
          </h2>
        </div>

        <shared-input
          [label]="'partners.form.businessName' | translate"
          [value]="form.controls.businessName.value ?? ''"
          (valueChange)="form.controls.businessName.setValue($event)"
          [required]="true"
          [error]="controlError('businessName', { maxLength: 200 })"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <shared-input
            [label]="'partners.form.kvkNumber' | translate"
            [value]="form.controls.kvkNumber.value ?? ''"
            (valueChange)="form.controls.kvkNumber.setValue($event)"
            [required]="true"
            [error]="controlError('kvkNumber', { maxLength: 20, patternError: invalidKvkError() })"
          />
          <shared-input
            [label]="'partners.form.vatNumber' | translate"
            [value]="form.controls.vatNumber.value ?? ''"
            (valueChange)="form.controls.vatNumber.setValue($event)"
            [required]="true"
            [error]="controlError('vatNumber', { maxLength: 20, patternError: invalidVatError() })"
          />
        </div>
      </section>

      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">02</span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
            {{ 'partners.form.contactInfo' | translate }}
          </h2>
        </div>

        <shared-input
          [label]="'partners.form.contactName' | translate"
          [value]="form.controls.contactName.value ?? ''"
          (valueChange)="form.controls.contactName.setValue($event)"
          [required]="true"
          [error]="controlError('contactName', { maxLength: 120 })"
        />

        <shared-input
          [label]="'partners.form.contactEmail' | translate"
          type="email"
          [value]="form.controls.contactEmail.value ?? ''"
          (valueChange)="form.controls.contactEmail.setValue($event)"
          [required]="true"
          [error]="emailControlError()"
        />

        <shared-input
          [label]="'partners.form.contactPhone' | translate"
          type="tel"
          [value]="form.controls.contactPhone.value ?? ''"
          (valueChange)="form.controls.contactPhone.setValue($event)"
          [required]="true"
          [error]="controlError('contactPhone', { maxLength: 50 })"
        />
      </section>

      <section class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-3">
          <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">03</span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
            {{ 'partners.form.address' | translate }}
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <shared-autocomplete
            [label]="'partners.form.addressLine1' | translate"
            [value]="form.controls.addressLine1.value ?? ''"
            (valueChange)="onAddressLine1Change($event)"
            [options]="addressOptions()"
            [filterMode]="'manual'"
            [placeholder]="'partners.form.addressSearchPlaceholder' | translate"
            [required]="true"
            [error]="controlError('addressLine1', { maxLength: 200 })"
          />
          <shared-input
            [label]="'partners.form.houseNumber' | translate"
            [value]="form.controls.houseNumber.value ?? ''"
            (valueChange)="onHouseNumberChange($event)"
            [required]="true"
            [error]="controlError('houseNumber', { maxLength: 20 })"
          />
          <shared-input
            [label]="'partners.form.addressLine2' | translate"
            [value]="form.controls.addressLine2.value ?? ''"
            (valueChange)="form.controls.addressLine2.setValue($event)"
            [error]="optionalControlError('addressLine2', 200)"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <shared-input
            [label]="'partners.form.postalCode' | translate"
            [value]="form.controls.postalCode.value ?? ''"
            (valueChange)="onPostalCodeChange($event)"
            [required]="true"
            [error]="controlError('postalCode', { maxLength: 20 })"
          />
          <shared-input
            [label]="'partners.form.city' | translate"
            [value]="form.controls.city.value ?? ''"
            (valueChange)="onCityChange($event)"
            [required]="true"
            [error]="controlError('city', { maxLength: 120 })"
          />
          <shared-input
            [label]="'partners.form.country' | translate"
            [value]="form.controls.country.value ?? ''"
            (valueChange)="onCountryChange($event)"
            [required]="true"
            [error]="controlError('country', { maxLength: 120 })"
          />
        </div>
      </section>

      <section class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-3">
          <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">04</span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
            {{ 'partners.form.services' | translate }}
          </h2>
        </div>

        <shared-multiselect
          [label]="'partners.form.serviceTypes' | translate"
          [placeholder]="'partners.form.serviceTypesPlaceholder' | translate"
          [options]="serviceTypeOptions()"
          [value]="form.controls.serviceTypeIds.value ?? []"
          (valueChange)="form.controls.serviceTypeIds.setValue([...$event])"
          [disabled]="serviceTypesLoading()"
          [error]="serviceTypesError() || ''"
        />
      </section>

      <section class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-3">
          <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">05</span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
            {{ 'partners.form.logo' | translate }}
          </h2>
        </div>

        @if (logoError()) {
          <div class="bg-red-50 border border-red-200 text-red-800 px-3 py-2 text-sm">
            {{ logoError() }}
          </div>
        }

        @if (logoPreviewUrl() && !logoImageError()) {
          <div class="flex items-center gap-4 rounded-xl border border-zinc-200 p-3">
            <img
              [src]="logoPreviewUrl()"
              [alt]="createdPartner()?.businessName ?? 'Partner logo'"
              class="h-16 w-16 rounded-lg object-cover border border-zinc-200"
              (error)="logoImageError.set(true)"
            />
            <div class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{{ createdPartner()?.logoFileName }}</span>
              @if (logoPreviewUrl()) {
                <a class="text-blue-600 hover:underline" [href]="logoPreviewUrl()" target="_blank" rel="noopener">
                  {{ 'partners.form.logoDownload' | translate }}
                </a>
              }
            </div>
          </div>
        } @else if (createdPartner()) {
          <div class="flex items-center gap-4 rounded-xl border border-dashed border-zinc-200 p-3">
            <div class="h-16 w-16 rounded-lg bg-zinc-100 flex items-center justify-center text-sm font-semibold text-zinc-600">
              {{ logoInitials() }}
            </div>
            <div class="text-sm text-zinc-500">
              {{ 'partners.form.logoEmpty' | translate }}
            </div>
          </div>
        }

        <app-file-uploader
          [label]="'partners.form.logoSelect' | translate"
          [dropLabel]="'common.upload.dropHint' | translate"
          [helpText]="'partners.form.logoHelp' | translate"
          [accept]="'image/*'"
          [buttonLabel]="'partners.form.logoUpload' | translate"
          [uploadingLabel]="'partners.form.logoUploading' | translate"
          [errorFallback]="'partners.form.errors.logoUploadFailed' | translate"
          [maxSizeBytes]="5242880"
          [maxSizeError]="'partners.form.logoMaxSize' | translate"
          [disabled]="!createdPartner() || saving() || logoLoading()"
          [presign]="presignLogo"
          [finalize]="finalizeLogo"
        />
      </section>
    </div>

    <div class="p-4 sm:p-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-3 sm:gap-4">
      @if (submitAttempted() && form.invalid) {
        <p class="text-xs font-semibold uppercase tracking-wide text-red-600 sm:mr-auto">
          {{ 'partners.form.validation.required' | translate }}
        </p>
      }
      <shared-button
        variant="secondary"
        type="button"
        (clicked)="cancel()"
        class="w-full sm:w-auto"
      >
        {{ 'partners.form.cancel' | translate }}
      </shared-button>

      <shared-button
        variant="primary"
        type="button"
        class="w-full sm:w-auto"
        [disabled]="saving()"
        [loading]="saving()"
        (clicked)="createdPartner() ? goToEdit() : save()"
      >
        @if (createdPartner()) {
          {{ 'partners.form.editPartner' | translate }}
        } @else {
          {{ saving() ? ('partners.form.saving' | translate) : ('partners.form.createPartner' | translate) }}
        }
      </shared-button>
    </div>
  </form>
</div>
</file>

<file path="src/app/routes/partners/partners-edit/partners-edit.component.html">
<div class="flex flex-col w-full pb-16 sm:pb-0">
  <shared-page-header
    [title]="partner()?.businessName ?? ('partners.form.editPartner' | translate)"
    [subtitle]="'partners.form.editSubtitle' | translate"
    [backAriaLabel]="'partners.form.goBack' | translate"
    (back)="cancel()"
  ></shared-page-header>

  @if (error()) {
    <div class="bg-red-50 border-b border-red-500 text-red-900 p-4 text-sm font-medium flex items-start gap-3">
      <span class="font-bold uppercase text-red-600 shrink-0">{{ 'partners.form.errorLabel' | translate }}</span>
      <span>{{ error() }}</span>
    </div>
  }

  @if (loading()) {
    <div class="flex-1 flex items-center justify-center py-12">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-black" aria-hidden="true"></div>
      <span class="sr-only">{{ 'partners.form.loading' | translate }}</span>
    </div>
  } @else {
    <form [formGroup]="form" (ngSubmit)="save()" class="flex-1 flex flex-col">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 sm:p-6">
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">01</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'partners.form.companyInfo' | translate }}
            </h2>
          </div>

          <shared-input
            [label]="'partners.form.businessName' | translate"
            [value]="form.controls.businessName.value ?? ''"
            (valueChange)="form.controls.businessName.setValue($event)"
            [required]="true"
            [error]="controlError('businessName', { maxLength: 200 })"
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <shared-input
              [label]="'partners.form.kvkNumber' | translate"
              [value]="form.controls.kvkNumber.value ?? ''"
              (valueChange)="form.controls.kvkNumber.setValue($event)"
              [required]="true"
              [error]="controlError('kvkNumber', { maxLength: 20, patternError: invalidKvkError() })"
            />
            <shared-input
              [label]="'partners.form.vatNumber' | translate"
              [value]="form.controls.vatNumber.value ?? ''"
              (valueChange)="form.controls.vatNumber.setValue($event)"
              [required]="true"
              [error]="controlError('vatNumber', { maxLength: 20, patternError: invalidVatError() })"
            />
          </div>
        </section>

        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">02</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'partners.form.contactInfo' | translate }}
            </h2>
          </div>

          <shared-input
            [label]="'partners.form.contactName' | translate"
            [value]="form.controls.contactName.value ?? ''"
            (valueChange)="form.controls.contactName.setValue($event)"
            [required]="true"
            [error]="controlError('contactName', { maxLength: 120 })"
          />

          <shared-input
            [label]="'partners.form.contactEmail' | translate"
            type="email"
            [value]="form.controls.contactEmail.value ?? ''"
            (valueChange)="form.controls.contactEmail.setValue($event)"
            [required]="true"
            [error]="emailControlError()"
          />

          <shared-input
            [label]="'partners.form.contactPhone' | translate"
            type="tel"
            [value]="form.controls.contactPhone.value ?? ''"
            (valueChange)="form.controls.contactPhone.setValue($event)"
            [required]="true"
            [error]="controlError('contactPhone', { maxLength: 50 })"
          />
        </section>

        <section class="space-y-4 md:col-span-2">
          <div class="flex items-center gap-3">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">03</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'partners.form.address' | translate }}
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <shared-autocomplete
              [label]="'partners.form.addressLine1' | translate"
              [value]="form.controls.addressLine1.value ?? ''"
              (valueChange)="onAddressLine1Change($event)"
              [options]="addressOptions()"
              [filterMode]="'manual'"
              [placeholder]="'partners.form.addressSearchPlaceholder' | translate"
              [required]="true"
              [error]="controlError('addressLine1', { maxLength: 200 })"
            />
            <shared-input
              [label]="'partners.form.houseNumber' | translate"
              [value]="form.controls.houseNumber.value ?? ''"
              (valueChange)="onHouseNumberChange($event)"
              [required]="true"
              [error]="controlError('houseNumber', { maxLength: 20 })"
            />
            <shared-input
              [label]="'partners.form.addressLine2' | translate"
              [value]="form.controls.addressLine2.value ?? ''"
              (valueChange)="form.controls.addressLine2.setValue($event)"
              [error]="optionalControlError('addressLine2', 200)"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <shared-input
              [label]="'partners.form.postalCode' | translate"
              [value]="form.controls.postalCode.value ?? ''"
              (valueChange)="onPostalCodeChange($event)"
              [required]="true"
              [error]="controlError('postalCode', { maxLength: 20 })"
            />
            <shared-input
              [label]="'partners.form.city' | translate"
              [value]="form.controls.city.value ?? ''"
              (valueChange)="onCityChange($event)"
              [required]="true"
              [error]="controlError('city', { maxLength: 120 })"
            />
            <shared-input
              [label]="'partners.form.country' | translate"
              [value]="form.controls.country.value ?? ''"
              (valueChange)="onCountryChange($event)"
              [required]="true"
              [error]="controlError('country', { maxLength: 120 })"
            />
          </div>
        </section>

        <section class="space-y-4 md:col-span-2">
          <div class="flex items-center gap-3">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">04</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'partners.form.services' | translate }}
            </h2>
          </div>

          <shared-multiselect
            [label]="'partners.form.serviceTypes' | translate"
            [placeholder]="'partners.form.serviceTypesPlaceholder' | translate"
            [options]="serviceTypeOptions()"
            [value]="form.controls.serviceTypeIds.value ?? []"
            (valueChange)="form.controls.serviceTypeIds.setValue([...$event])"
            [disabled]="serviceTypesLoading()"
            [error]="serviceTypesError() || ''"
          />
        </section>

        <section class="space-y-4 md:col-span-2">
          <div class="flex items-center gap-3">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">05</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'partners.form.logo' | translate }}
            </h2>
          </div>

          @if (logoError()) {
            <div class="bg-red-50 border border-red-200 text-red-800 px-3 py-2 text-sm">
              {{ logoError() }}
            </div>
          }

          @if (logoPreviewUrl() && !logoImageError()) {
            <div class="flex items-center gap-4 rounded-xl border border-zinc-200 p-3">
              <img
                [src]="logoPreviewUrl()"
                [alt]="partner()?.businessName ?? 'Partner logo'"
                class="h-16 w-16 rounded-lg object-cover border border-zinc-200"
                (error)="logoImageError.set(true)"
              />
              <div class="flex flex-col gap-1 text-sm">
                <span class="font-medium">{{ partner()?.logoFileName }}</span>
                <a class="text-blue-600 hover:underline" [href]="logoPreviewUrl()" target="_blank" rel="noopener">
                  {{ 'partners.form.logoDownload' | translate }}
                </a>
              </div>
              <div class="ml-auto">
                <shared-button
                  variant="ghost"
                  size="compact"
                  [fullWidth]="false"
                  [uppercase]="false"
                  (clicked)="deleteLogo()"
                  [disabled]="logoLoading()"
                >
                  {{ 'partners.form.logoDelete' | translate }}
                </shared-button>
              </div>
            </div>
          } @else {
            <div class="flex items-center gap-4 rounded-xl border border-dashed border-zinc-200 p-3">
              <div class="h-16 w-16 rounded-lg bg-zinc-100 flex items-center justify-center text-sm font-semibold text-zinc-600">
                {{ logoInitials() }}
              </div>
              <div class="text-sm text-zinc-500">
                {{ 'partners.form.logoEmpty' | translate }}
              </div>
            </div>
          }

          <app-file-uploader
            [label]="'partners.form.logoSelect' | translate"
            [dropLabel]="'common.upload.dropHint' | translate"
            [helpText]="'partners.form.logoHelpEdit' | translate"
            [accept]="'image/*'"
            [buttonLabel]="'partners.form.logoUpload' | translate"
            [uploadingLabel]="'partners.form.logoUploading' | translate"
            [errorFallback]="'partners.form.errors.logoUploadFailed' | translate"
            [maxSizeBytes]="5242880"
            [maxSizeError]="'partners.form.logoMaxSize' | translate"
            [disabled]="saving() || loading()"
            [presign]="presignLogo"
            [finalize]="finalizeLogo"
          />
        </section>
      </div>

      <div class="p-4 sm:p-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-3 sm:gap-4">
        @if (submitAttempted() && form.invalid) {
          <p class="text-xs font-semibold uppercase tracking-wide text-red-600 sm:mr-auto">
            {{ 'partners.form.validation.required' | translate }}
          </p>
        }
        <shared-button
          variant="secondary"
          type="button"
          (clicked)="cancel()"
          class="w-full sm:w-auto"
        >
          {{ 'partners.form.cancel' | translate }}
        </shared-button>

        <shared-button
          variant="primary"
          type="submit"
          class="w-full sm:w-auto"
          [disabled]="form.invalid || saving()"
          [loading]="saving()"
        >
          {{ saving() ? ('partners.form.saving' | translate) : ('partners.form.savePartner' | translate) }}
        </shared-button>
      </div>
    </form>
  }
</div>
</file>

<file path="src/app/shared/components/data-grid/data-grid-toolbar.component.html">
<!-- Desktop Toolbar -->
<div class="hidden sm:flex flex-col gap-3 py-4">
  <!-- Main toolbar row -->
  <div class="flex items-center gap-3">
    <!-- Search -->
    <div class="w-72">
      <shared-input
        class="w-full"
        [value]="localSearchTerm()"
        (valueChange)="onSearchValueChange($event)"
        [placeholder]="'dataGrid.searchPlaceholder' | translate"
        [ariaLabel]="'dataGrid.searchAriaLabel' | translate"
      />
    </div>

    <!-- Filter dropdown -->
    @if (filterableColumns().length > 0) {
      <div cdkOverlayOrigin #filterOrigin="cdkOverlayOrigin">
        <button
          #filterTrigger
          type="button"
          class="inline-flex items-center gap-2 rounded-lg border bg-white px-3 py-2 text-sm font-medium text-zinc-700 transition-all hover:bg-zinc-50 focus:outline-none focus:border-black"
          [class.border-black]="showFilters()"
          [class.border-zinc-200]="!showFilters()"
          [attr.aria-expanded]="showFilters()"
          aria-haspopup="true"
          [attr.aria-controls]="'filter-panel'"
          (click)="toggleFilters()"
        >
          <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <span>{{ 'dataGrid.addFilter' | translate }}</span>
          <svg class="w-4 h-4 text-zinc-400 transition-transform" [class.rotate-180]="showFilters()" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Filter popover via CDK Overlay -->
        <ng-template
          cdkConnectedOverlay
          [cdkConnectedOverlayOrigin]="filterOrigin"
          [cdkConnectedOverlayOpen]="showFilters()"
          (overlayOutsideClick)="closeFilters()"
          (detach)="closeFilters()"
        >
          <div 
            id="filter-panel"
            class="w-80 rounded-xl border border-zinc-200 bg-white mt-2"
          >
            <div class="p-4">
              @if (!activeFilterColumn()) {
                <!-- Column selection -->
                <div class="space-y-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
                    {{ 'dataGrid.selectColumn' | translate }}
                  </p>
                  <div class="grid gap-1">
                    @for (col of filterableColumns(); track col.id) {
                      <button
                        type="button"
                        class="flex items-center gap-3 w-full rounded-lg px-3 py-2.5 text-left text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-100 focus:outline-none focus:bg-zinc-100"
                        (click)="selectFilterColumn(col.id)"
                      >
                        <span class="flex-1">{{ col.header }}</span>
                        <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </button>
                    }
                  </div>
                </div>
              } @else {
                <!-- Filter value input -->
                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <button
                      type="button"
                      class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 transition-colors"
                      (click)="activeFilterColumn.set(null)"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                      </svg>
                      {{ 'dataGrid.back' | translate }}
                    </button>
                  </div>
                  
                  <div class="space-y-2">
                    <span class="block text-sm font-semibold text-zinc-900">
                      {{ activeFilterColumnData()?.header }}
                    </span>
                    @if (activeFilterUiConfig().inputType === 'select') {
                      <shared-select
                        [options]="activeFilterUiConfig().options ?? []"
                        [value]="filterValue()"
                        (valueChange)="filterValue.set($event ?? '')"
                        [placeholder]="'dataGrid.selectOption' | translate"
                        [ariaLabel]="'dataGrid.filterValueFor' | translate:{column: activeFilterColumnData()?.header}"
                      />
                    } @else {
                      <shared-input
                        [value]="filterValue()"
                        (valueChange)="filterValue.set($event)"
                        (keydown.enter)="applyFilter()"
                        [placeholder]="'dataGrid.enterValue' | translate"
                        [ariaLabel]="'dataGrid.filterValueFor' | translate:{column: activeFilterColumnData()?.header}"
                      />
                    }
                  </div>

                  <shared-button
                    variant="primary"
                    [fullWidth]="true"
                    [disabled]="!filterValue().trim()"
                    (clicked)="applyFilter()"
                  >
                    {{ 'dataGrid.apply' | translate }}
                  </shared-button>
                </div>
              }
            </div>
          </div>
        </ng-template>
      </div>
    }

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Column picker -->
    @if (columnPickerEnabled() && allColumns().length > 0) {
      <div cdkOverlayOrigin #columnPickerOrigin="cdkOverlayOrigin">
        <button
          #columnPickerTrigger
          type="button"
          class="inline-flex items-center gap-2 rounded-lg border bg-white px-3 py-2 text-sm font-medium text-zinc-700 transition-all hover:bg-zinc-50 focus:outline-none focus:border-black"
          [class.border-black]="showColumnPicker()"
          [class.border-zinc-200]="!showColumnPicker()"
          [attr.aria-expanded]="showColumnPicker()"
          aria-haspopup="true"
          [attr.aria-label]="'dataGrid.toggleColumnVisibility' | translate"
          (click)="toggleColumnPicker()"
        >
          <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
          </svg>
          <span>{{ 'dataGrid.columns' | translate }}</span>
        </button>

        <ng-template
          cdkConnectedOverlay
          [cdkConnectedOverlayOrigin]="columnPickerOrigin"
          [cdkConnectedOverlayOpen]="showColumnPicker()"
          (overlayOutsideClick)="closeColumnPicker()"
          (detach)="closeColumnPicker()"
        >
          <div class="w-64 max-h-[calc(100vh-200px)] overflow-y-auto rounded-xl border border-zinc-200 bg-white mt-2">
            <div class="sticky top-0 bg-white px-4 py-3 border-b border-zinc-100">
              <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
                {{ 'dataGrid.showHideColumns' | translate }}
              </span>
            </div>
            <div class="p-2 space-y-0.5">
              @for (column of allColumns(); track column.id) {
                <div class="flex items-center gap-3 px-2 py-1.5 rounded-lg hover:bg-zinc-50 transition-colors">
                  <shared-checkbox
                    [checked]="isColumnVisible(column)"
                    (checkedChange)="onColumnVisibilityToggle(column.id)"
                    [label]="column.header"
                    class="flex-1"
                  />
                  @if (column.frozen) {
                    <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" [attr.title]="'dataGrid.frozen' | translate">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                  }
                </div>
              }
            </div>
          </div>
        </ng-template>
      </div>
    }

    <!-- Action buttons -->
    @if (hasDirtyRows() || hasSelection()) {
      <div class="h-6 w-px bg-zinc-200"></div>
      
      <div class="flex items-center gap-2">
        @if (hasDirtyRows()) {
          <shared-button
            variant="ghost"
            size="compact"
            [fullWidth]="false"
            [ariaLabel]="'dataGrid.cancelChanges' | translate"
            (clicked)="onCancel()"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            {{ 'dataGrid.cancel' | translate }}
          </shared-button>

          <shared-button
            variant="primary"
            size="default"
            [fullWidth]="false"
            [disabled]="!isOnline()"
            [ariaLabel]="isOnline() ? ('dataGrid.saveChanges' | translate) : ('dataGrid.cannotSaveOffline' | translate)"
            (clicked)="onSave()"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {{ 'dataGrid.save' | translate }}
          </shared-button>
        }

        @if (hasSelection()) {
          <shared-button
            variant="danger"
            size="compact"
            [fullWidth]="false"
            [ariaLabel]="'dataGrid.deleteSelected' | translate:{count: selectedCount()}"
            (clicked)="onDelete()"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            {{ 'dataGrid.delete' | translate }}
          </shared-button>
        }
      </div>
    }
  </div>

  <!-- Active filters row -->
  @if (filters().length > 0) {
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-xs font-medium text-zinc-500 uppercase tracking-wide">{{ 'dataGrid.activeFilters' | translate }}:</span>
      @for (filter of filters(); track filter.columnId) {
        <span class="group inline-flex items-center gap-1.5 rounded-full bg-zinc-900 pl-3 pr-1.5 py-1 text-xs font-medium text-white">
          <span class="text-zinc-400">{{ columns() | columnLabel:filter.columnId }}</span>
          <span class="text-white">{{ filter.value }}</span>
          <button 
            type="button"
            class="ml-0.5 flex h-5 w-5 items-center justify-center rounded-full text-zinc-400 transition-colors hover:bg-white/20 hover:text-white focus:outline-none"
            [attr.aria-label]="'dataGrid.removeFilter' | translate:{column: (columns() | columnLabel:filter.columnId)}"
            (click)="removeFilter(filter.columnId)"
          >
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </span>
      }
      <button
        type="button"
        class="text-xs font-medium text-zinc-500 hover:text-zinc-900 underline underline-offset-2 transition-colors"
        (click)="onClearAll()"
      >
        {{ 'dataGrid.clearAll' | translate }}
      </button>
    </div>
  }
</div>

<!-- Mobile Toolbar -->
<div class="flex sm:hidden flex-col gap-4 py-4">
  <div class="w-full">
    <shared-input
      class="w-full"
      [value]="localSearchTerm()"
      (valueChange)="onSearchValueChange($event)"
      [placeholder]="'dataGrid.searchPlaceholder' | translate"
      [ariaLabel]="'dataGrid.searchAriaLabel' | translate"
    />
  </div>

  <div class="flex flex-wrap items-center gap-2">
    @if (filterableColumns().length > 0) {
      <shared-button
        variant="ghost"
        size="compact"
        [fullWidth]="false"
        [active]="showFilters() || hasActiveFilters()"
        [iconOnly]="true"
        [ariaExpanded]="showFilters()"
        [ariaControls]="'filter-panel-mobile'"
        [ariaLabel]="'dataGrid.toggleFilters' | translate"
        (clicked)="toggleFilters()"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        @if (filters().length > 0) {
          <span class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-zinc-900 px-1 text-[10px] font-bold text-white">
            {{ filters().length }}
          </span>
        }
      </shared-button>
    }

    @if (hasActiveFilters()) {
      <shared-button
        variant="ghost"
        size="compact"
        [fullWidth]="false"
        [iconOnly]="true"
        [ariaLabel]="'dataGrid.clearFilters' | translate"
        (clicked)="onClearAll()"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </shared-button>
    }

    @if (columnPickerEnabled() && allColumns().length > 0) {
      <shared-button
        variant="ghost"
        size="compact"
        [fullWidth]="false"
        [active]="showColumnPicker()"
        [iconOnly]="true"
        [ariaExpanded]="showColumnPicker()"
        ariaHaspopup="true"
        [ariaLabel]="'dataGrid.toggleColumnVisibility' | translate"
        (clicked)="toggleColumnPicker()"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
        </svg>
      </shared-button>

      <app-bottom-sheet
        [isOpen]="showColumnPicker()"
        [title]="'dataGrid.showHideColumns' | translate"
        (closed)="closeColumnPicker()"
      >
        <div class="flex flex-col gap-1 p-4">
          @for (column of allColumns(); track column.id) {
            <shared-checkbox
              [checked]="isColumnVisible(column)"
              (checkedChange)="onColumnVisibilityToggle(column.id)"
              [label]="column.header"
            />
          }
        </div>
      </app-bottom-sheet>
    }

    @if (hasDirtyRows() || hasSelection()) {
      <div class="h-6 w-px bg-zinc-200"></div>
      
      <div class="flex items-center gap-2">
        @if (hasDirtyRows()) {
          <shared-button
            variant="ghost"
            size="compact"
            [fullWidth]="false"
            [iconOnly]="true"
            [ariaLabel]="'dataGrid.cancelChanges' | translate"
            (clicked)="onCancel()"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </shared-button>

          <shared-button
            variant="primary"
            size="compact"
            [fullWidth]="false"
            [iconOnly]="true"
            [disabled]="!isOnline()"
            [ariaLabel]="isOnline() ? ('dataGrid.saveChanges' | translate) : ('dataGrid.cannotSaveOffline' | translate)"
            (clicked)="onSave()"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </shared-button>
        }

        @if (hasSelection()) {
          <shared-button
            variant="danger"
            size="compact"
            [fullWidth]="false"
            [iconOnly]="true"
            [ariaLabel]="'dataGrid.deleteSelected' | translate:{count: selectedCount()}"
            (clicked)="onDelete()"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </shared-button>
        }
      </div>
    }
  </div>
</div>

@if (isMobile()) {
  <app-bottom-sheet
    [isOpen]="showFilters()"
    [title]="'dataGrid.filters' | translate"
    (closed)="closeFilters()"
  >
    <div id="filter-panel-mobile" class="flex flex-col gap-6 p-5">
      @if (hasActiveFilters()) {
        <div class="flex justify-end">
          <shared-button
            variant="ghost"
            size="compact"
            class="text-red-600 hover:bg-red-50"
            (clicked)="onClearAll()"
          >
            {{ 'dataGrid.clearAllFilters' | translate }}
          </shared-button>
        </div>
      }

      @if (filters().length > 0) {
        <div class="flex flex-col gap-2">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
            {{ 'dataGrid.activeFilters' | translate }}
          </h4>
          @for (filter of filters(); track filter.columnId) {
            <div class="flex items-center justify-between rounded-lg border border-zinc-200 bg-zinc-50 p-3">
              <div class="flex flex-col">
                <span class="text-xs font-medium text-zinc-500">{{ columns() | columnLabel:filter.columnId }}</span>
                <span class="text-sm font-semibold text-zinc-900">{{ filter.value }}</span>
              </div>
              <button
                type="button"
                class="p-2 text-zinc-400 touch-manipulation active:text-red-600"
                (click)="removeFilter(filter.columnId)"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          }
        </div>
      }

      <div class="flex flex-col gap-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
          {{ 'dataGrid.addFilter' | translate }}
        </h4>
        
        @if (!activeFilterColumn()) {
          <shared-select
            [options]="filterableColumnOptions()"
            [value]="''"
            (valueChange)="selectFilterColumn($event)"
            [placeholder]="'dataGrid.selectColumn' | translate"
          />
        } @else {
          <div class="flex flex-col gap-4 rounded-xl border border-zinc-200 bg-white p-4">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-zinc-900">{{ activeFilterColumnData()?.header }}</span>
              <button type="button" class="text-zinc-400" (click)="activeFilterColumn.set(null)">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            @if (activeFilterUiConfig().inputType === 'select') {
              <shared-select
                [options]="activeFilterUiConfig().options ?? []"
                [value]="filterValue()"
                (valueChange)="filterValue.set($event ?? '')"
                [placeholder]="'dataGrid.selectOption' | translate"
              />
            } @else {
              <shared-input
                [value]="filterValue()"
                (valueChange)="filterValue.set($event)"
                (keydown.enter)="applyFilter()"
                [placeholder]="'dataGrid.enterValue' | translate"
              />
            }

            <shared-button
              variant="primary"
              [fullWidth]="true"
              [disabled]="!filterValue().trim()"
              (clicked)="applyFilter()"
            >
              {{ 'dataGrid.apply' | translate }}
            </shared-button>
          </div>
        }
      </div>
    </div>
  </app-bottom-sheet>
}
</file>

<file path="src/app/shared/components/data-grid/data-grid.types.ts">
/**
 * Enterprise Data Grid Types
 * Defines all interfaces and types for the data grid component
 */

import {
  DEBOUNCE_MS,
  TIMEOUT_MS,
  MOBILE_BREAKPOINT,
  ROW_HEIGHT,
  CARD_PREVIEW_FIELD_COUNT,
  MAX_MOBILE_COLUMNS,
} from '../../../core/config';
import type { ThumbnailConfig } from './data-grid-thumbnail-cell.component';

/** Address mapping configuration for address cells */
export interface AddressFieldMapping {
  /** Field key for full address label */
  label?: string;
  /** Field key for street */
  street?: string;
  /** Field key for house number */
  houseNumber?: string;
  /** Field key for zip/postcode */
  zipCode?: string;
  /** Field key for city */
  city?: string;
  /** Field key for state/province */
  state?: string;
  /** Field key for country */
  country?: string;
  /** Field key for latitude */
  latitude?: string;
  /** Field key for longitude */
  longitude?: string;
}

/** Column definition for the data grid */
export interface GridColumn<T = unknown> {
  /** Unique identifier for the column */
  id: string;
  /** Header text to display */
  header: string;
  /** Property key to access from row data */
  field: keyof T | string;
  /** Column width (CSS value) */
  width?: string;
  /** Minimum column width */
  minWidth?: string;
  /** Maximum column width */
  maxWidth?: string;
  /** Whether column is sortable */
  sortable?: boolean;
  /** Whether column is filterable */
  filterable?: boolean;
  /** Whether column is editable */
  editable?: boolean;
  /** Editability scope (defaults to always when editable is true) */
  editableWhen?: 'always' | 'new-only';
  /** Custom cell renderer type */
  cellType?: 'text' | 'number' | 'date' | 'boolean' | 'select' | 'custom' | 'address' | 'icon' | 'color' | 'thumbnail';
  /** Address field mapping for address cell type */
  addressMapping?: AddressFieldMapping;
  /** Thumbnail display configuration */
  thumbnailConfig?: ThumbnailConfig;
  /** Options for select type cells */
  selectOptions?: readonly { label: string; value: unknown }[];
  /** Metadata for select options (icon/color/description) */
  metaOptions?: readonly { label?: string; value: unknown; icon?: string | null; color?: string | null; description?: string | null }[];
  /** Validation function for editable cells */
  validator?: (value: unknown, row: T) => string | null;
  /** Custom cell template identifier */
  templateId?: string;
  /** Whether column is visible */
  visible?: boolean | undefined;
  /** Alignment for cell content */
  align?: 'left' | 'center' | 'right';
  /** Whether column is frozen */
  frozen?: boolean;
}

/** Sort configuration */
export interface SortConfig {
  /** Column ID being sorted */
  columnId: string;
  /** Sort direction */
  direction: 'asc' | 'desc';
}

/** Filter configuration */
export interface FilterConfig {
  /** Column ID being filtered */
  columnId: string;
  /** Filter value */
  value: string;
  /** Filter operator */
  operator: 'contains' | 'equals' | 'startsWith' | 'endsWith' | 'gt' | 'lt' | 'gte' | 'lte';
}

/** Pagination configuration */
export interface PaginationConfig {
  /** Current page (1-indexed) */
  page: number;
  /** Items per page */
  pageSize: number;
  /** Total items count */
  totalItems: number;
  /** Available page size options */
  pageSizeOptions: readonly number[];
}

/** Row state for tracking edits and selection */
export interface RowState<T> {
  /** Original row data */
  original: T;
  /** Current/edited row data */
  current: T;
  /** Whether row is selected */
  selected: boolean;
  /** Whether row is in edit mode */
  editing: boolean;
  /** Whether row is dirty (has unsaved changes) */
  dirty: boolean;
  /** Whether row is being saved */
  saving: boolean;
  /** Row-level error message */
  error: string | null;
  /** Cell-level validation errors */
  cellErrors: Record<string, string>;
  /** Whether this is a new (unsaved) row */
  isNew: boolean;
  /** Timestamp for optimistic concurrency */
  version?: number | undefined;
  /** Whether row was recently updated by another user */
  recentlyUpdated: boolean;
}

/** Grid loading states */
export type LoadingState = 'idle' | 'loading' | 'saving' | 'error';

/** Navigation mode for pagination */
export type NavigationMode = 'pagination' | 'infinite-scroll';

/** Cell edit event */
export interface CellEditEvent<T> {
  rowId: string | number;
  columnId: string;
  oldValue: unknown;
  newValue: unknown;
  row: T;
}

/** Row selection event */
export interface SelectionChangeEvent<T> {
  selectedRows: T[];
  allSelected: boolean;
}

/** Sort change event */
export interface SortChangeEvent {
  sort: SortConfig | null;
}

/** Filter change event */
export interface FilterChangeEvent {
  filters: FilterConfig[];
}

/** Page change event */
export interface PageChangeEvent {
  page: number;
  pageSize: number;
}

/** Server-side data request */
export interface DataRequest {
  page: number;
  pageSize: number;
  sort: SortConfig | null;
  filters: FilterConfig[];
  searchTerm: string;
}

/** Server-side data response */
export interface DataResponse<T> {
  data: T[];
  totalItems: number;
  page: number;
  pageSize: number;
}

/** Bulk operation result */
export interface BulkOperationResult<T> {
  successful: T[];
  failed: { row: T; error: string }[];
}

/** Real-time update event */
export interface RealTimeUpdate<T> {
  type: 'create' | 'update' | 'delete';
  rowId: string | number;
  data?: T;
  timestamp: number;
}

/** Grid configuration */
export interface GridConfig<T> {
  /** Unique row identifier field */
  rowIdField: keyof T;
  /** Navigation mode */
  navigationMode: NavigationMode;
  /** Enable row selection */
  selectable: boolean;
  /** Enable multi-row selection */
  multiSelect: boolean;
  /** Enable column resizing */
  resizable: boolean;
  /** Enable row reordering */
  reorderable: boolean;
  /** Enable virtual scrolling */
  virtualScroll: boolean;
  /** Virtual scroll row height (px) */
  rowHeight: number;
  /** Debounce time for search (ms) */
  searchDebounce: number;
  /** Auto-refresh interval (ms), 0 to disable */
  autoRefreshInterval: number;
  /** Enable stale data detection */
  staleDataDetection: boolean;
  /** Stale data threshold (ms) */
  staleDataThreshold: number;
  /** Enable offline queue */
  offlineQueue: boolean;
  /** Max offline queue size */
  maxOfflineQueueSize: number;
  
  // ============ Mobile/Card View Configuration ============
  
  /** Enable card view on mobile (switches from table to cards below breakpoint) */
  cardViewEnabled: boolean;
  /** Breakpoint (px) below which card view is used */
  mobileBreakpoint: number;
  /** Field to use as card title/header */
  cardTitleField?: keyof T | string;
  /** Field to use as subtitle (e.g. phone/email) */
  cardSubtitleField?: keyof T | string;
  /** Secondary subtitle field */
  cardSecondarySubtitleField?: keyof T | string;
  /** Field to use for status chip */
  statusField?: keyof T | string;
  /** Number of fields to show before "expand" in card view */
  cardPreviewFieldCount: number;
  /** Enable column visibility picker in toolbar */
  columnPickerEnabled: boolean;
  /** Maximum columns visible on mobile (table view) */
  maxMobileColumns: number;
  /** Enable add-row bar on mobile/card view */
  mobileAddRowEnabled: boolean;
  /** Show per-row view action (eye icon) */
  rowViewActionEnabled: boolean;
  /** Show per-row delete action (trash icon) */
  rowDeleteActionEnabled: boolean;
  /** Predicate to determine if delete action is allowed for a row */
  rowDeleteActionPredicate?: (row: T) => boolean;
}

/** Default grid configuration */
export const DEFAULT_GRID_CONFIG: GridConfig<unknown> = {
  rowIdField: 'id' as keyof unknown,
  navigationMode: 'pagination',
  selectable: true,
  multiSelect: true,
  resizable: true,
  reorderable: false,
  virtualScroll: false,
  rowHeight: ROW_HEIGHT,
  searchDebounce: DEBOUNCE_MS.search,
  autoRefreshInterval: 0,
  staleDataDetection: true,
  staleDataThreshold: TIMEOUT_MS.staleData,
  offlineQueue: true,
  maxOfflineQueueSize: 100,
  
  // Mobile/Card View defaults
  cardViewEnabled: true,
  mobileBreakpoint: MOBILE_BREAKPOINT,
  cardPreviewFieldCount: CARD_PREVIEW_FIELD_COUNT,
  columnPickerEnabled: true,
  maxMobileColumns: MAX_MOBILE_COLUMNS,
  mobileAddRowEnabled: true,
  rowViewActionEnabled: false,
  rowDeleteActionEnabled: false,
};

/** Cell position for keyboard navigation */
export interface CellPosition {
  rowIndex: number;
  columnIndex: number;
}

/** Announced message for screen readers */
export interface AriaAnnouncement {
  message: string;
  politeness: 'polite' | 'assertive';
}
</file>

