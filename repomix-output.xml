<file path="src/app/shared/components/menu/menu.component.html">
<div class="relative" cdkOverlayOrigin #origin="cdkOverlayOrigin">
  <shared-button
    #trigger
    class="touch-manipulation"
    [variant]="triggerVariant()"
    [size]="triggerSize()"
    [shape]="triggerShape()"
    [iconOnly]="iconOnly()"
    [fullWidth]="fullWidth()"
    [disabled]="disabled()"
    [tooltip]="tooltip()"
    [ariaLabel]="(ariaLabel() || triggerLabel()) | translate"
    [ariaExpanded]="isOpen()"
    [ariaControls]="menuId"
    [ariaHaspopup]="'menu'"
    (clicked)="toggle()"
    (keydown)="onTriggerKeydown($event)"
  >
    @if (iconOnly()) {
      <ng-content select="[menuTrigger]"></ng-content>
      <span class="sr-only">{{ triggerLabel() | translate }}</span>
    } @else {
      <span class="text-xs font-semibold">{{ triggerLabel() | translate }}</span>
      @if (showChevron()) {
        <svg
          class="h-4 w-4 text-zinc-500 transition-transform duration-200"
          [class.rotate-180]="isOpen()"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
        </svg>
      }
    }
  </shared-button>

  <ng-template
    cdkConnectedOverlay
    [cdkConnectedOverlayOrigin]="origin"
    [cdkConnectedOverlayOpen]="isOpen()"
    [cdkConnectedOverlayHasBackdrop]="true"
    [cdkConnectedOverlayBackdropClass]="'cdk-overlay-transparent-backdrop'"
    (backdropClick)="close()"
    (detach)="close()"
  >
    <div
      #menuPanel
      [id]="menuId"
      role="menu"
      tabindex="-1"
      (keydown)="onMenuKeydown($event)"
      class="w-72 max-w-[90vw] rounded-xl border border-zinc-200 bg-white shadow-xl ring-1 ring-zinc-900/5 outline-none focus:outline-none"
    >
      @if (sections().length) {
        <div class="divide-y divide-zinc-100">
          @for (section of sections(); track section.label ?? $index) {
            <div class="px-2 py-2">
              @if (section.label) {
                <p class="px-2 pb-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400">
                  {{ section.label | translate }}
                </p>
              }
              <ul class="space-y-0.5">
                @for (item of section.items; track item.label) {
                  <li>
                    @if (item.items?.length) {
                      <div class="px-2 py-2 text-[10px] font-bold uppercase tracking-wide text-zinc-400">
                        {{ item.label | translate }}
                      </div>
                      <ul class="space-y-0.5">
                        @for (child of item.items; track child.label) {
                          <li>
                            @if (child.route) {
                              <a
                                [routerLink]="child.route"
                                role="menuitem"
                                data-menu-item="true"
                                [attr.aria-disabled]="isDisabled(child)"
                                [attr.tabindex]="isDisabled(child) ? -1 : 0"
                                (click)="selectItem(child)"
                                class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm text-zinc-700 transition-colors 
                                       hover:bg-zinc-50 active:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2"
                                [class.text-zinc-400]="isDisabled(child)"
                                [class.pointer-events-none]="isDisabled(child)"
                              >
                                {{ child.label | translate }}
                              </a>
                            } @else if (child.href) {
                              <a
                                [href]="child.href"
                                role="menuitem"
                                data-menu-item="true"
                                [attr.aria-disabled]="isDisabled(child)"
                                [attr.tabindex]="isDisabled(child) ? -1 : 0"
                                (click)="selectItem(child)"
                                class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm text-zinc-700 transition-colors 
                                       hover:bg-zinc-50 active:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2"
                                [class.text-zinc-400]="isDisabled(child)"
                                [class.pointer-events-none]="isDisabled(child)"
                              >
                                {{ child.label | translate }}
                              </a>
                            } @else {
                              <button
                                type="button"
                                role="menuitem"
                                data-menu-item="true"
                                [attr.aria-disabled]="isDisabled(child)"
                                [attr.tabindex]="isDisabled(child) ? -1 : 0"
                                (click)="selectItem(child)"
                                class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm text-zinc-700 transition-colors 
                                       hover:bg-zinc-50 active:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2"
                                [class.text-zinc-400]="isDisabled(child)"
                                [class.pointer-events-none]="isDisabled(child)"
                              >
                                {{ child.label | translate }}
                              </button>
                            }
                          </li>
                        }
                      </ul>
                    } @else {
                      @if (item.route) {
                        <a
                          [routerLink]="item.route"
                          role="menuitem"
                          data-menu-item="true"
                          [attr.aria-disabled]="isDisabled(item)"
                          [attr.tabindex]="isDisabled(item) ? -1 : 0"
                          (click)="selectItem(item)"
                          class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm text-zinc-700 transition-colors 
                                 hover:bg-zinc-50 active:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2"
                          [class.text-zinc-400]="isDisabled(item)"
                          [class.pointer-events-none]="isDisabled(item)"
                        >
                          {{ item.label | translate }}
                        </a>
                      } @else if (item.href) {
                        <a
                          [href]="item.href"
                          role="menuitem"
                          data-menu-item="true"
                          [attr.aria-disabled]="isDisabled(item)"
                          [attr.tabindex]="isDisabled(item) ? -1 : 0"
                          (click)="selectItem(item)"
                          class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm text-zinc-700 transition-colors 
                                 hover:bg-zinc-50 active:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2"
                          [class.text-zinc-400]="isDisabled(item)"
                          [class.pointer-events-none]="isDisabled(item)"
                        >
                          {{ item.label | translate }}
                        </a>
                      } @else {
                        <button
                          type="button"
                          role="menuitem"
                          data-menu-item="true"
                          [attr.aria-disabled]="isDisabled(item)"
                          [attr.tabindex]="isDisabled(item) ? -1 : 0"
                          (click)="selectItem(item)"
                          class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm text-zinc-700 transition-colors 
                                 hover:bg-zinc-50 active:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2"
                          [class.text-zinc-400]="isDisabled(item)"
                          [class.pointer-events-none]="isDisabled(item)"
                        >
                          {{ item.label | translate }}
                        </button>
                      }
                    }
                  </li>
                }
              </ul>
            </div>
          }
        </div>
      } @else {
        <div class="px-4 py-3 text-sm text-zinc-500 italic text-center">
          {{ 'menu.noItems' | translate }}
        </div>
      }
    </div>
  </ng-template>
</div>
