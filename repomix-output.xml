<file path="src/app/shared/components/ai-advisor-panel/ai-advisor-panel.component.html">
<div class="flex flex-col gap-4">
  <!-- Header with refresh button -->
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-semibold">{{ 'leads.detail.ai.title' | translate }}</h3>
    <div class="flex items-center gap-2">
      @if (noNewInfo() && canRefresh()) {
        <shared-button
          variant="secondary"
          size="compact"
          [disabled]="refreshing() || loading()"
          (clicked)="forceRefresh.emit()"
          [title]="'leads.detail.ai.forceRegenerateHint' | translate"
        >
          {{ 'leads.detail.ai.forceRegenerate' | translate }}
        </shared-button>
      }
      @if (canRefresh()) {
        <shared-button
          variant="secondary"
          size="compact"
          [disabled]="refreshing() || loading()"
          (clicked)="refresh.emit()"
        >
          @if (refreshing()) {
            <span class="flex items-center gap-2">
              <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              {{ 'leads.detail.ai.analyzing' | translate }}
            </span>
          } @else {
            {{ 'leads.detail.ai.refresh' | translate }}
          }
        </shared-button>
      }
    </div>
  </div>

  @if (loading()) {
    <div class="flex flex-col items-center justify-center py-12 text-zinc-500">
      <svg class="animate-spin h-8 w-8 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-sm">{{ 'leads.detail.ai.loading' | translate }}</p>
    </div>
  } @else if (error()) {
    <div class="bg-zinc-50 border border-zinc-200 rounded-lg p-6 text-center">
      <svg class="mx-auto h-12 w-12 text-zinc-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-sm text-zinc-600 mb-3">{{ error() }}</p>
      @if (canRefresh()) {
        <shared-button variant="secondary" size="compact" (clicked)="refresh.emit()">
          {{ 'leads.detail.ai.tryAgain' | translate }}
        </shared-button>
      }
    </div>
  } @else if (!analysis()) {
    <div class="bg-zinc-50 border border-zinc-200 rounded-lg p-6 text-center">
      <svg class="mx-auto h-12 w-12 text-zinc-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
      </svg>
      @if (canRefresh()) {
        <p class="text-sm text-zinc-600 mb-3">{{ 'leads.detail.ai.empty' | translate }}</p>
        <shared-button variant="primary" size="compact" (clicked)="refresh.emit()">
          {{ 'leads.detail.ai.generate' | translate }}
        </shared-button>
      } @else {
        <p class="text-sm text-zinc-600">{{ 'leads.detail.ai.closed' | translate }}</p>
      }
    </div>
  } @else if (isDefault()) {
    @let a = analysis()!;
    
    <!-- Default analysis banner -->
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-4">
      <div class="flex items-start gap-3">
        <svg class="shrink-0 h-5 w-5 text-amber-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <div class="flex-1">
          <p class="text-sm font-medium text-amber-800">{{ 'leads.detail.ai.defaultTitle' | translate }}</p>
          <p class="text-sm text-amber-700 mt-1">{{ 'leads.detail.ai.defaultSubtitle' | translate }}</p>
        </div>
      </div>
    </div>

    <!-- Summary -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <h4 class="text-sm font-semibold text-blue-900 mb-2">{{ 'leads.detail.ai.defaultGuideTitle' | translate }}</h4>
      <p class="text-sm text-blue-800">{{ a.summary }}</p>
    </div>

    <!-- Generate Analysis CTA -->
    @if (canRefresh()) {
      <div class="mt-2 pt-4 border-t border-zinc-200 text-center">
        <p class="text-sm text-zinc-500 mb-3">{{ 'leads.detail.ai.defaultCta' | translate }}</p>
        <shared-button
          variant="primary"
          size="default"
          [disabled]="refreshing()"
          (clicked)="refresh.emit()"
        >
          @if (refreshing()) {
            <span class="flex items-center gap-2">
              <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              {{ 'leads.detail.ai.generating' | translate }}
            </span>
          } @else {
            {{ 'leads.detail.ai.generate' | translate }}
          }
        </shared-button>
      </div>
    }
  } @else {
    @let a = analysis()!;

    <!-- Stale analysis warning -->
    @if (isStale()) {
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mb-2 flex items-center gap-2" role="alert">
        <svg class="h-4 w-4 text-amber-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <span class="text-sm text-amber-800">{{ 'leads.detail.ai.stale' | translate }}</span>
      </div>
    }

    <!-- No new information banner -->
    @if (noNewInfo()) {
      <output class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-2">
        <div class="flex items-start gap-2">
          <svg class="h-4 w-4 text-blue-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
          </svg>
          <div>
            <p class="text-sm font-medium text-blue-800">{{ 'leads.detail.ai.noNewInfoTitle' | translate }}</p>
            <p class="text-xs text-blue-700 mt-1">{{ 'leads.detail.ai.noNewInfoBody' | translate }}</p>
          </div>
        </div>
      </output>
    }
    
    <!-- Urgency Badge -->
    <div class="flex items-start gap-3 p-4 rounded-lg border" [ngClass]="getUrgencyColor(a.urgencyLevel)">
      <div class="shrink-0">
        @if (a.urgencyLevel === 'High') {
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
        } @else if (a.urgencyLevel === 'Medium') {
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
          </svg>
        } @else {
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        }
      </div>
      <div>
        <p class="font-semibold text-sm">{{ 'leads.detail.ai.urgency' | translate }}: {{ getUrgencyLabel(a.urgencyLevel) }}</p>
        @if (a.urgencyReason) {
          <p class="text-sm mt-1">{{ a.urgencyReason }}</p>
        }
      </div>
    </div>

    <!-- Summary -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <h4 class="text-sm font-semibold text-blue-900 mb-2">{{ 'leads.detail.ai.summary' | translate }}</h4>
      <p class="text-sm text-blue-800">{{ a.summary }}</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-zinc-200 p-3">
        <p class="text-xs uppercase text-zinc-500">{{ 'leads.detail.ai.leadQuality' | translate }}</p>
        <p class="text-sm font-semibold mt-1">{{ a.leadQuality }}</p>
      </div>
      <div class="rounded-lg border border-zinc-200 p-3">
        <p class="text-xs uppercase text-zinc-500">{{ 'leads.detail.ai.recommendedAction' | translate }}</p>
        <p class="text-sm font-semibold mt-1">{{ a.recommendedAction }}</p>
      </div>
      <div class="rounded-lg border border-zinc-200 p-3">
        <p class="text-xs uppercase text-zinc-500">{{ 'leads.detail.ai.preferredChannel' | translate }}</p>
        <p class="text-sm font-semibold mt-1">{{ a.preferredContactChannel }}</p>
      </div>
      <div class="rounded-lg border border-zinc-200 p-3">
        <p class="text-xs uppercase text-zinc-500">{{ 'leads.detail.ai.missingInformation' | translate }}</p>
        @if (a.missingInformation.length > 0) {
          <ul class="mt-2 space-y-1 text-sm">
            @for (item of a.missingInformation; track item) {
              <li class="flex items-start gap-2">
                <span class="text-red-500">•</span>
                <span>{{ item }}</span>
              </li>
            }
          </ul>
        } @else {
          <p class="text-sm text-zinc-500 mt-1">{{ 'leads.detail.ai.noneMissing' | translate }}</p>
        }
      </div>
    </div>

    <!-- Contact Message -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
      <h4 class="text-sm font-semibold text-green-900 mb-3">
        {{ 'leads.detail.ai.contactMessageTitle' | translate:{ channel: getChannelLabel(a.preferredContactChannel) } }}
      </h4>
      <div class="space-y-3">
        <textarea
          rows="4"
          class="w-full rounded-lg border-green-300 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-green-500 focus:ring-green-500 shadow-sm"
          [value]="editableMessage()"
          (input)="editableMessage.set($any($event.target).value)"
          [placeholder]="'leads.detail.ai.contactMessagePlaceholder' | translate"
        ></textarea>

        <div class="flex items-center justify-end gap-2">
          <shared-button
            variant="secondary"
            size="compact"
            [disabled]="!editableMessage()"
            (clicked)="copyMessage()"
          >
            @if (copied()) {
              <span class="flex items-center gap-1 text-green-700">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {{ 'leads.detail.ai.copied' | translate }}
              </span>
            } @else {
              <span class="flex items-center gap-1">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                {{ 'leads.detail.ai.copy' | translate }}
              </span>
            }
          </shared-button>

          @if (a.preferredContactChannel === 'WhatsApp') {
            @if (consumerPhone()) {
              <a
                [href]="getWhatsAppUrl(consumerPhone(), editableMessage())"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-[#25D366] hover:bg-[#128C7E] text-white text-sm font-semibold rounded-lg transition-colors shadow-sm"
              >
                {{ 'leads.detail.ai.openWhatsApp' | translate }}
              </a>
            } @else {
              <span class="text-sm text-zinc-500">{{ 'leads.detail.ai.missingPhone' | translate }}</span>
            }
          } @else {
            @if (consumerEmail()) {
              <a
                [href]="getEmailUrl(consumerEmail(), editableMessage())"
                class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 hover:bg-black text-white text-sm font-semibold rounded-lg transition-colors shadow-sm"
              >
                {{ 'leads.detail.ai.openEmail' | translate }}
              </a>
            } @else {
              <span class="text-sm text-zinc-500">{{ 'leads.detail.ai.missingEmail' | translate }}</span>
            }
          }
        </div>
      </div>
    </div>

    <!-- Photo Analysis Section -->
    @if (photoAnalysisLoading()) {
      <div class="border border-purple-200 rounded-lg p-4 bg-purple-50">
        <div class="flex items-center gap-3">
          <svg class="animate-spin h-5 w-5 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="text-sm text-purple-700">{{ 'leads.detail.ai.photo.loading' | translate }}</span>
        </div>
      </div>
    } @else if (photoAnalysis()) {
      @let pa = photoAnalysis()!;
      <div class="border border-purple-200 rounded-lg overflow-hidden">
        <button
          type="button"
          class="w-full flex items-center justify-between p-4 bg-purple-50 hover:bg-purple-100 transition-colors"
          (click)="photoAnalysisExpanded.set(!photoAnalysisExpanded())"
        >
          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <div class="text-left">
              <h4 class="text-sm font-semibold text-purple-900">{{ 'leads.detail.ai.photo.title' | translate }}</h4>
              <p class="text-xs text-purple-700">{{ pa.photoCount }} {{ pa.photoCount === 1 ? ('leads.detail.ai.photo.photoSingular' | translate) : ('leads.detail.ai.photo.photoPlural' | translate) }} • {{ pa.confidenceLevel }} {{ 'leads.detail.ai.photo.confidence' | translate }}</p>
            </div>
          </div>
          <svg
            class="h-5 w-5 text-purple-600 transition-transform duration-200"
            [class.rotate-180]="photoAnalysisExpanded()"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        @if (photoAnalysisExpanded()) {
          <div class="p-4 border-t border-purple-200 bg-white space-y-4">
            <!-- Summary -->
            @if (pa.summary) {
              <div>
                <h5 class="text-xs uppercase text-purple-600 font-semibold mb-1">{{ 'leads.detail.ai.photo.summary' | translate }}</h5>
                <p class="text-sm text-zinc-700">{{ pa.summary }}</p>
              </div>
            }

            <!-- Observations -->
            @if (pa.observations.length > 0) {
              <div>
                <h5 class="text-xs uppercase text-purple-600 font-semibold mb-2">{{ 'leads.detail.ai.photo.observations' | translate }}</h5>
                <ul class="space-y-1.5">
                  @for (obs of pa.observations; track obs) {
                    <li class="flex items-start gap-2 text-sm text-zinc-700">
                      <span class="text-purple-500 mt-0.5">•</span>
                      <span>{{ obs }}</span>
                    </li>
                  }
                </ul>
              </div>
            }

            <!-- Scope Assessment -->
            @if (pa.scopeAssessment) {
              <div>
                <h5 class="text-xs uppercase text-purple-600 font-semibold mb-1">{{ 'leads.detail.ai.photo.scope' | translate }}</h5>
                <p class="text-sm text-zinc-700">{{ pa.scopeAssessment }}</p>
              </div>
            }

            <!-- Cost Indicators -->
            @if (pa.costIndicators) {
              <div>
                <h5 class="text-xs uppercase text-purple-600 font-semibold mb-1">{{ 'leads.detail.ai.photo.cost' | translate }}</h5>
