<file path="src/app/routes/leads/lead-detail/lead-detail-timeline-tab.component.ts">
import { ChangeDetectionStrategy, Component, input, output, inject } from '@angular/core';
import { TranslateService } from '@ngx-translate/core';
import type { LeadTimelineItem, PipelineStage } from '../../../core/services/leads.types';
import { PIPELINE_STAGE_I18N_KEYS } from '../../../core/services/leads.types';
import { ButtonComponent } from '../../../shared/components/button/button.component';

@Component({
  selector: 'app-lead-detail-timeline-tab',
  templateUrl: './lead-detail-timeline-tab.component.html',
  styleUrl: './lead-detail-timeline-tab.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
  imports: [ButtonComponent],
})
export class LeadDetailTimelineTabComponent {
  private readonly translate = inject(TranslateService);

  timelineItems = input<LeadTimelineItem[]>([]);
  timelineLoading = input<boolean>(false);
  timelineError = input<string | null>(null);
  copiedContactMessage = input<string | null>(null);
  leadPhone = input<string>('');
  leadEmail = input<string | null>(null);

  formatHumanDateTime = input<(value: string | undefined) => string>((value) => value ?? '-');
  getTimelineTypeLabel = input<(type: LeadTimelineItem['type']) => string>(String);
  getTimelineTypeBadgeClass = input<(type: LeadTimelineItem['type']) => string>(() => '');
  getTimelinePartnerSummary = input<(item: LeadTimelineItem) => string | null>(() => null);
  getTimelineEstimation = input<(item: LeadTimelineItem) => { priceRange?: string; scope?: string; notes?: string } | null>(() => null);
  getTimelineRecommendedAction = input<(item: LeadTimelineItem) => string | null>(() => null);
  getTimelineContactMessage = input<(item: LeadTimelineItem) => { channel: 'WhatsApp' | 'Email'; message: string } | null>(() => null);
  getTimelineMissingInformation = input<(item: LeadTimelineItem) => string[]>(() => []);
  getTimelineScore = input<(item: LeadTimelineItem) => { score: number; preAi?: number; version?: string } | null>(() => null);
  getTimelineDraftedQuote = input<(item: LeadTimelineItem) => { quoteId: string; quoteNumber: string; itemCount: number; catalogItems: number; adHocItems: number } | null>(() => null);

  openCallLogger = output<void>();
  openWhatsApp = output<{ phone: string; message: string }>();
  composeEmail = output<{ email: string | undefined; message: string }>();
  copyContactMessage = output<{ itemId: string; message: string }>();
  viewDraftQuote = output<string>();

  protected getStageTitle(item: LeadTimelineItem): string {
    const oldStage = item.metadata['oldStage'] as PipelineStage | undefined;
    const newStage = item.metadata['newStage'] as PipelineStage | undefined;
    if (oldStage && newStage) {
      const oldLabel = PIPELINE_STAGE_I18N_KEYS[oldStage]
        ? this.translate.instant(PIPELINE_STAGE_I18N_KEYS[oldStage])
        : oldStage;
      const newLabel = PIPELINE_STAGE_I18N_KEYS[newStage]
        ? this.translate.instant(PIPELINE_STAGE_I18N_KEYS[newStage])
        : newStage;
      return `${oldLabel} → ${newLabel}`;
    }
    return this.t('leads.detail.timeline.stageUpdated');
  }

  protected formatEstimationNotes(value: string): string {
    const escaped = this.escapeHtml(value);
    const bolded = escaped.replaceAll(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    return bolded.replaceAll(/\r?\n/g, '<br />');
  }

  private escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;');
  }

  protected t(key: string, params?: Record<string, unknown>): string {
    return this.translate.instant(key, params);
  }
}
</file>

<file path="src/app/routes/partners/partners-detail/partners-detail.component.html">
<div class="flex flex-col h-full pb-16 sm:pb-0">
  <div class="border-b border-zinc-200">
    <shared-page-header
      [title]="partner()?.businessName ?? ('partners.detail.title' | translate)"
      [subtitle]="'partners.detail.subtitle' | translate"
      [backAriaLabel]="'partners.detail.goBack' | translate"
      (back)="goBack()"
    >
      @if (partner()) {
        <ng-container actions>
          <div class="flex items-center gap-2">
            <shared-button
              variant="secondary"
              size="compact"
              [fullWidth]="false"
              (clicked)="editPartner()"
            >
              <lucide-icon name="pencil" class="h-4 w-4 mr-2" aria-hidden="true"></lucide-icon>
              {{ 'partners.detail.edit' | translate }}
            </shared-button>
            <shared-button
              variant="danger"
              size="compact"
              [fullWidth]="false"
              (clicked)="openDeleteDialog()"
            >
              <lucide-icon name="trash-2" class="h-4 w-4 mr-2" aria-hidden="true"></lucide-icon>
              {{ 'partners.detail.delete' | translate }}
            </shared-button>
          </div>
        </ng-container>
      }
    </shared-page-header>
  </div>

  <!-- Mobile actions -->
  @if (partner()) {
    <div class="sm:hidden border-b border-gray-100 bg-white px-5 py-3">
      <div class="grid grid-cols-2 gap-2">
        <shared-button variant="secondary" size="compact" [fullWidth]="true" (clicked)="editPartner()">
          <lucide-icon name="pencil" class="h-4 w-4"></lucide-icon>
          {{ 'partners.detail.edit' | translate }}
        </shared-button>
        <shared-button variant="danger" size="compact" [fullWidth]="true" (clicked)="openDeleteDialog()">
          <lucide-icon name="trash-2" class="h-4 w-4"></lucide-icon>
          {{ 'partners.detail.delete' | translate }}
        </shared-button>
      </div>
    </div>
  }

  @if (error()) {
    <div class="flex-1 flex flex-col items-center justify-center p-12 gap-4">
      <p class="text-sm text-zinc-600">{{ error() }}</p>
      <shared-button variant="secondary" [fullWidth]="false" (clicked)="goBack()">
        {{ 'partners.detail.goBack' | translate }}
      </shared-button>
    </div>
  } @else if (loading()) {
    <div class="flex-1 flex flex-col items-center justify-center p-12 gap-4">
      <div class="animate-spin h-10 w-10 border-4 border-zinc-100 border-t-black"></div>
      <p class="text-xs font-mono uppercase text-zinc-400">{{ 'partners.detail.loading' | translate }}</p>
    </div>
  } @else if (partner(); as p) {
    <div class="flex-1 overflow-y-auto">
      <div class="w-full p-4 sm:p-6 lg:p-8 overflow-x-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-6">
          <div class="flex flex-col gap-6">
            <app-partner-detail-hero-card
              [businessName]="p.businessName"
              [contactEmail]="p.contactEmail"
              [logoPreviewUrl]="logoPreviewUrl()"
              [logoDownloadUrl]="logoDownloadUrl()"
              [logoInitials]="logoInitials()"
              [logoImageError]="logoImageError()"
              [logoError]="logoError()"
              [createdAt]="formatDate(p.createdAt)"
              [updatedAt]="formatDate(p.updatedAt)"
              (logoFailed)="logoImageError.set(true)"
            />

            <app-partner-detail-company-card
              [titleKey]="'partners.detail.companyInfo'"
              [rows]="companyRows()"
              [editingKey]="editingField()"
              [editValue]="editValue()"
              (startEdit)="startEditFromEvent($event)"
              (cancelEdit)="cancelEdit()"
              (saveEdit)="saveEditFromEvent($event)"
              (editValueChange)="editValue.set($event)"
            />
          </div>

          <div class="flex flex-col gap-6">
            <app-partner-detail-contact-card
              [titleKey]="'partners.detail.contactInfo'"
              [rows]="contactRows()"
              [editingKey]="editingField()"
              [editValue]="editValue()"
              [whatsappUrl]="whatsappUrl()"
              [phoneUrl]="contactPhoneUrl()"
              [emailUrl]="contactEmailUrl()"
              (startEdit)="startEditFromEvent($event)"
              (cancelEdit)="cancelEdit()"
              (saveEdit)="saveEditFromEvent($event)"
              (editValueChange)="editValue.set($event)"
              (openWhatsApp)="openWhatsApp()"
              (openCall)="openCall()"
              (openEmail)="openEmail()"
            />

            <app-partner-detail-address-card
              [titleKey]="'partners.detail.address'"
              [rows]="addressRows()"
              [editingKey]="editingField()"
              [editValue]="editValue()"
              [mapAddress]="mapAddress()"
              [latitude]="mapLatitude()"
              [longitude]="mapLongitude()"
              [googleMapsUrl]="googleMapsUrl()"
              (startEdit)="startEditFromEvent($event)"
              (cancelEdit)="cancelEdit()"
              (saveEdit)="saveEditFromEvent($event)"
              (editValueChange)="editValue.set($event)"
              (addressSelect)="applyAddressSuggestion($event)"
              (openGoogleMaps)="openGoogleMaps()"
            />

            <app-partner-detail-services-card
              [serviceTypeIds]="p.serviceTypeIds ?? []"
              [serviceTypeLabels]="serviceTypeLabels()"
              [serviceTypesLoading]="serviceTypesLoading()"
              [serviceTypesError]="serviceTypesError()"
              [serviceTypesEditing]="serviceTypesEditing()"
              [serviceTypesSaving]="serviceTypesSaving()"
              [serviceTypeOptions]="serviceTypeOptions()"
              [serviceTypeSelection]="serviceTypeSelection()"
              (openEdit)="openServiceTypesEdit()"
              (closeEdit)="closeServiceTypesEdit()"
              (saveEdit)="saveServiceTypes()"
              (removeServiceType)="removeServiceType($event)"
              (selectionChange)="serviceTypeSelection.set($event)"
            />

            <app-partner-detail-offers-card
              [offers]="partnerOffers()"
              [loading]="offersLoading()"
              [error]="offersError()"
              [partnerPhone]="p.contactPhone"
              [partnerName]="p.businessName"
              (refresh)="refreshOffers()"
            />
          </div>
        </div>
      </div>
    </div>
  }

  <shared-confirm-dialog
    [isOpen]="showDeleteDialog()"
    [title]="'partners.detail.deleteConfirmTitle' | translate"
    [message]="'partners.detail.deleteConfirmMessage' | translate"
    [confirmText]="'partners.detail.deleteConfirm' | translate"
    [cancelText]="'partners.detail.deleteCancel' | translate"
    confirmVariant="danger"
    [confirmDisabled]="deleting()"
    (confirm)="confirmDelete()"
    (cancelled)="closeDeleteDialog()"
  />
</div>
</file>

