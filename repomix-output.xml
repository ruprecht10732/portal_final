@if (isOpen()) {
  <button
    class="file-preview-backdrop"
    type="button"
    (click)="onBackdropClick()"
    aria-label="Close preview"
  ></button>
}

<dialog
  [attr.open]="isOpen() ? '' : null"
  class="file-preview-dialog"
  [attr.aria-modal]="true"
  [attr.aria-labelledby]="titleId()"
  [attr.aria-describedby]="descriptionId()"
  (keydown.escape)="onCloseClick()"
  tabindex="-1"
>
  <div class="file-preview-header">
    <h2 class="file-preview-title" [id]="titleId()">
      {{ title() || 'File preview' }}
    </h2>
    <button
      type="button"
      class="file-preview-close"
      (click)="onCloseClick()"
      aria-label="Close preview"
    >
      <lucide-icon name="x" class="h-4 w-4" aria-hidden="true"></lucide-icon>
    </button>
  </div>

  <div class="file-preview-body" [id]="descriptionId()">
    @if (isLoading()) {
      <div class="file-preview-state">Loading preview...</div>
    } @else if (error()) {
      <div class="file-preview-error">{{ error() }}</div>
    } @else if (fileUrl()) {
      @if (isImage()) {
        <img class="file-preview-image" [src]="fileUrl()!" [alt]="fileName()" />
      } @else if (safeUrl()) {
        <iframe
          class="file-preview-frame"
