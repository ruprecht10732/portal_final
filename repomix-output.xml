<section class="rounded-xl border border-zinc-200 bg-white p-5">
  <div class="flex items-center justify-between gap-3 mb-3">
    <h3 class="text-sm font-semibold text-black uppercase tracking-wide">
      {{ 'partners.offersCard.title' | translate }}
    </h3>
    <div class="flex items-center gap-2">
      <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-semibold text-zinc-600">
        {{ offers().length }}
      </span>
      <shared-button
        type="button"
        variant="ghost"
        size="compact"
        [iconOnly]="true"
        [fullWidth]="false"
        [disabled]="loading()"
        [ariaLabel]="'partners.offersCard.refresh' | translate"
        [tooltip]="'partners.offersCard.refresh' | translate"
        (clicked)="refresh.emit()"
      >
        <lucide-icon name="refresh-cw" class="h-4 w-4" aria-hidden="true"></lucide-icon>
      </shared-button>
    </div>
  </div>

  @if (error()) {
    <div class="text-sm text-red-600">{{ error() }}</div>
  } @else if (loading()) {
    <div class="text-sm text-zinc-500">{{ 'partners.offersCard.loading' | translate }}</div>
  } @else if (sortedOffers().length === 0) {
    <p class="text-sm text-zinc-500">{{ 'partners.offersCard.empty' | translate }}</p>
  } @else {
    <ul class="space-y-3">
      @for (offer of sortedOffers(); track offer.id) {
        <li class="offer-item rounded-lg border border-zinc-100 p-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="status-badge {{ statusClass(offer.status) }}">
                  {{ statusLabel(offer.status) | translate }}
                </span>
                <span class="text-xs font-medium text-zinc-600 uppercase">
                  {{ offer.pricingSource === 'quote'
                    ? ('partners.offersCard.pricingSource.quote' | translate)
                    : ('partners.offersCard.pricingSource.estimate' | translate) }}
                </span>
              </div>
              <div class="text-sm font-semibold text-zinc-900">
                {{ centsToEuros(offer.vakmanPriceCents) }}
                <span class="text-xs font-normal text-zinc-400 ml-1">
                  {{ 'partners.offersCard.price.partnerLabel' | translate }}
                </span>
                <span class="text-zinc-300 mx-1">·</span>
                {{ centsToEuros(offer.customerPriceCents) }}
                <span class="text-xs font-normal text-zinc-400 ml-1">
                  {{ 'partners.offersCard.price.customerLabel' | translate }}
                </span>
              </div>
              <div class="text-xs text-zinc-500 mt-1">
                {{ 'partners.offersCard.createdAt' | translate:{ date: formatDate(offer.createdAt) } }}
                @if (offer.expiresAt) {
                  <span class="text-zinc-300 mx-1">·</span>
                  {{ 'partners.offersCard.expiresAt' | translate:{ date: formatDate(offer.expiresAt) } }}
                }
              </div>
              @if (offer.status === 'rejected' && offer.rejectionReason) {
                <div class="mt-1 text-xs text-red-600">
                  <span class="font-medium">{{ 'partners.offersCard.rejectionReason' | translate }}</span>
                  {{ offer.rejectionReason }}
                </div>
              }
            </div>

            <div class="flex items-center gap-1 shrink-0">
              @if (isActionable(offer)) {
                <shared-button
                  type="button"
                  variant="ghost"
                  size="compact"
                  [iconOnly]="true"
                  [fullWidth]="false"
                  [ariaLabel]="'partners.offersCard.whatsapp' | translate"
                  [tooltip]="'partners.offersCard.whatsappTooltip' | translate"
                  (clicked)="openWhatsApp(offer)"
                >
                  <lucide-icon name="message-circle" class="h-4 w-4 text-green-600" aria-hidden="true"></lucide-icon>
                </shared-button>
              }
              <shared-button
                type="button"
                variant="ghost"
                size="compact"
                [iconOnly]="true"
                [fullWidth]="false"
                [ariaLabel]="'partners.offersCard.preview' | translate"
                [tooltip]="'partners.offersCard.previewTooltip' | translate"
                (clicked)="previewOffer(offer)"
              >
                <lucide-icon name="eye" class="h-4 w-4" aria-hidden="true"></lucide-icon>
              </shared-button>
            </div>
          </div>
        </li>
      }
    </ul>
  }
</section>
</file>

