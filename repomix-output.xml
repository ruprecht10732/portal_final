@import 'https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined';

:host {
  display: block;
  width: 100%;
}

.calendar {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
  max-width: 100%;
}

.calendar-header {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.75rem;
}

.calendar-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  width: 100%;
}

.calendar-header-row.secondary {
  flex-wrap: wrap;
  justify-content: space-between;
}

.calendar-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.calendar-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  width: 100%;
  flex-wrap: wrap;
}

.calendar-views {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #71717a;
}

.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.legend-swatch {
  display: inline-block;
  width: 0.65rem;
  height: 0.65rem;
  border: 1px solid #18181b;
}

.legend-swatch.is-selected {
  background: #18181b;
}

.legend-swatch.in-range {
  background: #f4f4f5;
}

.legend-swatch.is-unavailable {
  border-color: #a1a1aa;
  background: #e4e4e7;
}

.view-button {
  border: 1px solid #e5e7eb;
  background: #fff;
  padding: 0.4rem 0.6rem;
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.view-button[aria-selected='true'] {
  border-color: #18181b;
  background: #18181b;
  color: #fff;
}

.calendar-title h3 {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #52525b;
}

.month-control,
.today-button {
  border: 1px solid #e5e7eb;
  background: #fff;
  padding: 0.5rem 0.75rem;
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.month-control:hover,
.today-button:hover {
  border-color: #18181b;
}

.month-control {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
}

.grid-scroll {
  width: 100%;
  overflow-x: auto;
}

table[ngGrid] {
  width: 100%;
  border-collapse: collapse;
  border: 1px solid #18181b;
  font-size: 0.875rem;
  table-layout: fixed;
}

th,
td {
  text-align: center;
  padding: 0.35rem;
}

.week-number {
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: #71717a;
  width: 2.5rem;
}

thead th {
  font-size: 0.625rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #71717a;
  border-bottom: 1px solid #18181b;
  background: #fafafa;
}

td.is-disabled {
  color: #d4d4d8;
}

td.is-active {
  outline: 3px solid #18181b;
  outline-offset: -3px;
}

.day-button {
  width: 100%;
  padding: 0.75rem 0;
  border: none;
  background: transparent;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.15rem;
}

.day-button:hover {
  background: #f4f4f5;
}

.day-button.in-range {
  background: #f4f4f5;
}

.day-button.is-preview {
  background: #e4e4e7;
}

.day-button.is-selected {
  background: #18181b;
  color: #fff;
}


.day-button.is-unavailable {
  color: #a1a1aa;
  cursor: not-allowed;
  pointer-events: none;
  background: transparent;
}

.day-button.range-start,
.day-button.range-end {
  background: #18181b;
  color: #fff;
  position: relative;
}

.day-button.range-start::after,
.day-button.range-end::after {
  content: '';
  position: absolute;
  inset: 4px;
  border: 1px solid #fff;
  pointer-events: none;
}

.day-button.is-today {
  font-weight: 700;
  box-shadow: inset 0 0 0 1px #18181b;
}

.day-button.is-holiday {
  position: relative;
}

.holiday-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: #ef4444;
  margin-left: 4px;
}

.holiday-label {
  font-size: 0.55rem;
  color: #ef4444;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  max-width: 70px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (width <= 639px) {
  .week-number {
    display: none;
  }

  .holiday-label {
    display: none;
  }
}

.day-button:focus-visible,
.month-control:focus-visible,
.today-button:focus-visible,
.view-button:focus-visible {
  outline: 3px solid #18181b;
  outline-offset: 2px;
}

.calendar-header .month-control {
  min-height: 2.5rem;
}

@media (width >= 640px) {
  .calendar-header-row {
    gap: 1.5rem;
  }

  .calendar-title {
    align-items: center;
    justify-self: center;
  }

  .calendar-actions {
    justify-content: flex-end;
    gap: 0.75rem;
    width: auto;
  }

  .calendar-views {
    justify-content: flex-start;
  }

  .calendar-title h3 {
    font-size: 0.875rem;
    letter-spacing: 0.15em;
  }

  .view-button,
  .today-button {
    font-size: 0.7rem;
  }

  table[ngGrid] {
    font-size: 0.95rem;
  }

  th,
  td {
    padding: 0.5rem;
  }

  .day-button {
    padding: 0.6rem 0;
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
