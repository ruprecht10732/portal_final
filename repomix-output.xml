                    <span class="font-mono">{{ item.color }}</span>
                  </div>
                } @else {
                  <span class="text-sm text-zinc-500">—</span>
                }
              </dd>
            </div>

            <div>
              <dt class="text-xs font-bold uppercase tracking-wider text-zinc-400">
                {{ 'services.detail.fields.displayOrder' | translate }}
              </dt>
              <dd class="mt-1 text-sm text-zinc-700">
                {{ item.displayOrder }}
              </dd>
            </div>
          </dl>
        </section>
      </div>

      <!-- Section C: Metadata -->
      <section class="p-4 sm:p-6">
        <div class="flex items-center gap-3 mb-6">
          <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">C</span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
            {{ 'services.detail.sections.metadata' | translate }}
          </h2>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <dt class="text-xs font-bold uppercase tracking-wider text-zinc-400">
              {{ 'services.detail.fields.createdAt' | translate }}
            </dt>
            <dd class="mt-1 text-sm text-zinc-600">
              {{ item.createdAt | date:'medium' }}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-wider text-zinc-400">
              {{ 'services.detail.fields.updatedAt' | translate }}
            </dt>
            <dd class="mt-1 text-sm text-zinc-600">
              {{ item.updatedAt | date:'medium' }}
            </dd>
          </div>
        </dl>
      </section>
    </div>
  }

  <shared-confirm-dialog
    [isOpen]="showDeleteDialog()"
    [title]="'services.detail.deleteConfirmTitle' | translate"
    [message]="'services.detail.deleteConfirmMessage' | translate"
    [confirmText]="'services.detail.deleteConfirm' | translate"
    [cancelText]="'services.detail.deleteCancel' | translate"
    confirmVariant="danger"
    [confirmDisabled]="deleting()"
    (confirm)="confirmDelete()"
    (cancelled)="closeDeleteDialog()"
  />
</div>
