                  }

                  <div class="mt-1.5 flex items-center gap-2">
                    <span
                      class="inline-block border px-1.5 py-0.5 text-[10px] font-semibold"
                      [class]="statusColor(appt.status)"
                    >
                      {{ statusLabel(appt.status) }}
                    </span>
                    <span class="text-[10px] text-zinc-400">{{ typeLabel(appt.type) }}</span>
                  </div>
                </div>
              </div>
            </div>
          }
        }
      }
    }
