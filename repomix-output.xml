<file path="src/app/routes/app-shell/authenticated-sidebar.component.html">
<div class="flex h-svh w-full flex-col-reverse bg-zinc-50 md:flex-row">
  <aside
    class="fixed bottom-0 z-50 flex h-16 w-full flex-row items-center justify-between border-t border-zinc-200 bg-zinc-100 px-2 shadow-lg md:relative md:h-full md:w-20 md:flex-col md:justify-start md:border-r md:border-t-0 md:px-2 md:py-6 md:shadow-none"
  >
    <nav
      class="no-scrollbar flex flex-1 flex-row items-center justify-around gap-1 overflow-x-auto px-2 md:flex-col md:justify-start md:gap-4 md:overflow-y-auto md:px-0"
      [attr.aria-label]="'sidebar.primary' | translate"
    >
      @for (item of items(); track item.route) {
        <shared-button
          class="sidebar-item touch-manipulation"
          [routerLink]="item.route"
          routerLinkActive
          #activeLink="routerLinkActive"
          [variant]="activeLink.isActive ? 'primary' : 'ghost'"
          size="compact"
          [iconOnly]="true"
          shape="square"
          [fullWidth]="false"
          [ariaLabel]="item.label | translate"
          [attr.title]="item.label | translate"
          [tooltip]="item.label | translate"
        >
          @switch (item.icon) {
            @case ('dashboard') {
              <lucide-icon name="layout-dashboard" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('leads') {
              <lucide-icon name="users" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('partners') {
              <lucide-icon name="briefcase" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('appointments') {
              <lucide-icon name="calendar-check" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('services') {
              <lucide-icon name="wrench" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('offertes') {
              <lucide-icon name="file-text" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('catalog') {
              <lucide-icon name="book-open" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('organization') {
              <lucide-icon name="building" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
            @case ('profile') {
              <lucide-icon name="user" class="h-6 w-6 md:h-5 md:w-5"></lucide-icon>
            }
          }
        </shared-button>
      }
    </nav>

    <div class="hidden flex-col items-center gap-4 border-t border-zinc-100 pt-6 md:flex">
      <shared-button
        class="sidebar-toggle"
        variant="ghost"
        size="compact"
        [iconOnly]="true"
        shape="square"
        [fullWidth]="false"
        [ariaLabel]="
          isExpanded() ? ('sidebar.collapse' | translate) : ('sidebar.expand' | translate)
        "
        [tooltip]="isExpanded() ? ('sidebar.collapse' | translate) : ('sidebar.expand' | translate)"
        (clicked)="toggleExpanded()"
      >
        <lucide-icon name="arrow-left-right" class="h-5 w-5"></lucide-icon>
      </shared-button>

      <shared-menu
        triggerLabel="navigation.profile"
        ariaLabel="navigation.profile"
        [iconOnly]="true"
        [showChevron]="false"
        [triggerVariant]="'ghost'"
        [triggerSize]="'compact'"
        [triggerShape]="'square'"
        [fullWidth]="false"
        [sections]="profileMenu"
        [tooltip]="'navigation.profile' | translate"
        (itemSelected)="handleProfileMenuSelection($event)"
      >
        <lucide-icon menuTrigger name="user" class="h-6 w-6"></lucide-icon>
      </shared-menu>
    </div>
  </aside>

  @if (isExpanded()) {
    <app-authenticated-sidebar-panel
      class="border-r border-zinc-200 bg-white fixed inset-0 z-40 w-full pt-safe-top pb-20 md:static md:h-auto md:w-auto md:pb-0"
      [title]="activeTitle()"
      [items]="panelItems()"
    ></app-authenticated-sidebar-panel>
  }
</div>
