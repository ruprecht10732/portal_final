<file path="src/app/shared/components/data-grid/data-grid.component.html">
<div 
  #gridContainer
  class="group relative flex flex-col w-full overflow-hidden isolate"
  [attr.aria-label]="ariaLabel() | translate"
>
  @if (showToolbar()) {
    <div class="border-b border-zinc-200 z-20 relative">
      <data-grid-toolbar
        [columns]="store.visibleColumns()"
        [allColumns]="store.columns()"
        [columnPickerEnabled]="store.config().columnPickerEnabled"
        [searchTerm]="store.searchTerm()"
        [filters]="store.filters()"
        [hasSelection]="store.hasSelection()"
        [selectedCount]="store.selectedCount()"
        [hasDirtyRows]="store.hasDirtyRows()"
        [isOnline]="store.isOnline()"
        [hasPendingOps]="store.hasPendingOfflineOps()"
        (searchChange)="onSearchChange($event)"
        (filterChange)="onFilterChange($event)"
        (clearFilters)="onClearFilters()"
        (saveRequest)="onSaveRequest()"
        (cancelRequest)="onCancelRequest()"
        (deleteRequest)="onDeleteRequest(getSelectedRows())"
        (columnVisibilityChange)="store.toggleColumnVisibility($event)"
      />
    </div>
  }

  <div class="flex flex-col">
    @if (!store.isOnline()) {
      <output 
        class="flex items-center justify-between bg-amber-50 px-4 py-2.5 text-amber-900 border-b border-amber-100"
        aria-live="polite"
      >
        <div class="flex items-center gap-3">
          <div class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-100 text-amber-600">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wide opacity-90">
            {{ 'dataGrid.offlineMode' | translate }}
          </span>
        </div>
        @if (store.hasPendingOfflineOps()) {
          <span class="text-xs font-medium text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full">
            {{ 'dataGrid.changesPending' | translate:{count: store.offlineQueue().length} }}
          </span>
        }
      </output>
    }

    @if (store.loadingState() === 'error' && error()) {
      <div 
        class="flex items-center gap-3 bg-red-50 px-4 py-3 text-red-900 border-b border-red-100"
        role="alert"
        aria-live="assertive"
      >
        <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <span class="text-sm font-medium">{{ error() }}</span>
      </div>
    }

    @if (store.isDataStale()) {
      <output class="flex items-center justify-between bg-blue-50 px-4 py-2 text-blue-900 border-b border-blue-100">
        <span class="text-xs font-semibold uppercase tracking-wide opacity-90">
          {{ 'dataGrid.dataMayBeOutdated' | translate }}
        </span>
        <button
          type="button"
          class="text-xs font-semibold text-blue-700 hover:text-blue-800 hover:underline focus:outline-none"
          (click)="refresh()"
        >
          {{ 'dataGrid.refresh' | translate }}
        </button>
      </output>
    }
  </div>

  @if (store.loadingState() === 'loading' && store.rows().length === 0) {
    <div class="w-full p-6 space-y-4" aria-busy="true">
      <div class="flex gap-4 pb-4 border-b border-zinc-100">
        @for (i of [1,2,3,4,5]; track i) {
          <div class="h-4 bg-zinc-100 rounded animate-pulse" [style.width.%]="20"></div>
        }
      </div>
      @for (row of [1,2,3,4,5,6]; track row) {
        <div class="flex gap-4 py-2">
          @for (col of [1,2,3,4,5]; track col) {
            <div class="h-8 bg-zinc-50 rounded animate-pulse" [style.width.%]="20" [style.opacity]="1 - (row * 0.1)"></div>
          }
        </div>
      }
    </div>
  }

  @if (store.loadingState() !== 'loading' || store.rows().length > 0) {
    
    @if (store.showCardView()) {
      @defer (on viewport) {
        <div class="flex flex-col bg-zinc-50/50">
          <data-grid-cards
            [columns]="store.columns()"
            [rows]="store.rows()"
            [selectable]="store.config().selectable"
            [rowIdField]="store.config().rowIdField"
            [cardTitleField]="store.config().cardTitleField"
            [cardSubtitleField]="store.config().cardSubtitleField"
            [cardSecondarySubtitleField]="store.config().cardSecondarySubtitleField"
            [statusField]="store.config().statusField"
            [previewFieldCount]="store.config().cardPreviewFieldCount"
            [rowDeleteActionEnabled]="store.config().rowDeleteActionEnabled"
            [rowDeleteActionPredicate]="store.config().rowDeleteActionPredicate ?? null"
            (rowSelect)="store.toggleRowSelection($event)"
            (rowClick)="onRowDoubleClick($event)"
            (cellValueChange)="store.updateCellValue($event.rowIndex, $event.columnId, $event.value)"
            (cellEditEvent)="onCellEdit($event)"
            (deleteRow)="onCardDelete($event)"
          />

          @if (store.rows().length > 0 && store.config().mobileAddRowEnabled) {
            <div class="p-4 pt-0">
              <button
                type="button"
                class="flex w-full items-center justify-center gap-3 rounded-lg border border-dashed border-zinc-300 bg-white py-3 text-sm font-medium text-zinc-600 transition-colors active:bg-zinc-50"
                (click)="onAddRow()"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                {{ 'dataGrid.addRow' | translate }}
              </button>
            </div>
          }
        </div>
      } @placeholder {
        <div class="p-4 space-y-4">
          <div class="h-32 rounded-lg bg-zinc-100 animate-pulse"></div>
          <div class="h-32 rounded-lg bg-zinc-100 animate-pulse"></div>
        </div>
      }
    } 
    
    @else {
      <div class="relative flex-1 min-w-0">
        @if (store.canScrollLeft()) {
          <div class="absolute left-0 top-0 bottom-0 w-12 bg-linear-to-r from-white via-white/20 to-transparent pointer-events-none z-20"></div>
          <div class="absolute left-0 top-0 bottom-0 w-px bg-zinc-200 z-20"></div>
        }
        @if (store.canScrollRight()) {
          <div class="absolute right-0 top-0 bottom-0 w-12 bg-linear-to-l from-white via-white/20 to-transparent pointer-events-none z-20"></div>
          <div class="absolute right-0 top-0 bottom-0 w-px bg-zinc-200 z-20"></div>
        }

        <section 
          class="overflow-x-auto h-full overflow-y-auto max-w-full"
          [attr.aria-label]="(ariaLabel() | translate) + ' ' + ('dataGrid.tableSuffix' | translate)"
          (scroll)="onTableScroll($event)"
        >
          <table
            [attr.aria-rowcount]="store.pagination().totalItems"
            [attr.aria-colcount]="store.visibleColumns().length + (store.config().selectable ? 1 : 0)"
            class="w-max min-w-full border-collapse"
          >
            <thead class="sticky top-0 z-10 bg-zinc-50/95 backdrop-blur-sm shadow-[inset_0_-1px_0_0_#e4e4e7]">
              <tr class="sr-only" hidden>
                @if (store.config().selectable) {
                  <th scope="col">{{ 'dataGrid.selectColumn' | translate }}</th>
                }
                @for (column of store.visibleColumns(); track column.id) {
                  <th scope="col">{{ column.header }}</th>
                }
              </tr>
              <tr data-grid-header
                class="text-left text-xs font-semibold uppercase tracking-wider text-zinc-500"
                [columns]="store.visibleColumns()"
                [sort]="store.sort()"
                [allSelected]="store.allSelected()"
                [partiallySelected]="store.partiallySelected()"
                [selectable]="store.config().selectable"
                (sortChange)="onSortChange($event)"
                (selectAll)="store.toggleAllSelection()"
                (columnResize)="onColumnResize($event)"
              ></tr>
            </thead>

            <data-grid-body
              class="bg-white divide-y divide-zinc-100"
              [columns]="store.visibleColumns()"
              [rows]="store.rows()"
              [focusedCell]="store.focusedCell()"
              [editingCell]="store.editingCell()"
              [selectable]="store.config().selectable"
              [rowIdField]="store.config().rowIdField"
              [rowViewActionEnabled]="store.config().rowViewActionEnabled"
              [rowDeleteActionEnabled]="store.config().rowDeleteActionEnabled"
              [rowDeleteActionPredicate]="store.config().rowDeleteActionPredicate ?? null"
              [statusField]="store.config().statusField"
              (cellFocus)="store.setFocusedCell($event)"
              (cellEdit)="store.startCellEdit($event.rowIndex, $event.columnIndex)"
              (cellValueChange)="store.updateCellValue($event.rowIndex, $event.columnId, $event.value)"
              (cellEditComplete)="store.completeCellEdit($event)"
              (rowSelect)="store.toggleRowSelection($event)"
              (rowDoubleClick)="onRowDoubleClick($event)"
              (rowDelete)="onRowDelete($event)"
              (navigate)="store.navigateCell($event)"
              (cellEditEvent)="onCellEdit($event)"
            />
          </table>
        </section>

        @if (store.rows().length > 0) {
          <div class="border-t border-zinc-200 bg-white/70 opacity-0 pointer-events-none transition-opacity duration-200 group-hover:opacity-100 group-hover:pointer-events-auto">
            <button
              type="button"
              class="flex w-full cursor-pointer items-center justify-center gap-4 bg-white/50 py-3 backdrop-blur-sm transition-colors hover:bg-zinc-50"
              (click)="onAddRow()"
            >
              <div class="h-px flex-1 bg-linear-to-r from-transparent via-zinc-300 to-transparent"></div>
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-zinc-500">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                {{ 'dataGrid.addRow' | translate }}
              </div>
              <div class="h-px flex-1 bg-linear-to-r from-transparent via-zinc-300 to-transparent"></div>
            </button>
          </div>
        }
      </div>
    }

    @if (store.rows().length === 0) {
      <output class="flex flex-col items-center justify-center p-12 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-zinc-50 shadow-sm ring-1 ring-zinc-900/5">
          <svg class="h-8 w-8 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
        </div>
        
        <h3 class="mt-6 text-sm font-semibold text-zinc-900 uppercase tracking-wide">
          {{ 'dataGrid.noData' | translate }}
        </h3>
        
        <p class="mt-1 text-sm text-zinc-500 max-w-xs">
          @if (store.filters().length > 0 || store.searchTerm()) {
            {{ 'dataGrid.tryAdjustingFilters' | translate }}
          } @else {
            {{ 'dataGrid.noResultsYet' | translate }}
          }
        </p>

        @if (store.filters().length === 0 && !store.searchTerm() && (!store.showCardView() || store.config().mobileAddRowEnabled)) {
          <div class="mt-6">
            <shared-button
              variant="secondary"
              size="default"
              [fullWidth]="false"
              (clicked)="onAddRow()"
            >
              <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              {{ 'dataGrid.addFirstRow' | translate }}
            </shared-button>
          </div>
        }
      </output>
    }

    @if (store.rows().length > 0 && store.config().navigationMode === 'pagination') {
      <div class="border-t border-zinc-200 bg-zinc-50/50">
        <data-grid-pagination
          [pagination]="store.pagination()"
          [totalPages]="store.totalPages()"
          [pageNumbers]="store.pageNumbers()"
          (pageChange)="onPageChange($event)"
          (pageSizeChange)="onPageSizeChange($event)"
        />
      </div>
    }

    @if (store.config().navigationMode === 'infinite-scroll') {
      @if (store.pagination().page < store.totalPages()) {
        <div class="flex justify-center border-t border-zinc-200 bg-zinc-50/50 p-4">
          <shared-button
            variant="secondary"
            size="default"
            [fullWidth]="false"
            (clicked)="onPageChange(store.pagination().page + 1)"
          >
            {{ 'dataGrid.loadMore' | translate }}
          </shared-button>
        </div>
      }
    }
  }

  <output
    #announcer
    class="sr-only"
    [attr.aria-live]="currentAnnouncement()?.politeness ?? 'polite'"
    aria-atomic="true"
  >
    {{ currentAnnouncement()?.message }}
  </output>
</div>
</file>

