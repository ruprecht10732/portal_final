<tbody class="divide-y divide-zinc-200 bg-white">
  @for (row of rows(); track trackByRowId($index, row); let rowIndex = $index) {
    <tr
      role="row"
      [attr.aria-selected]="row.selected"
      [attr.aria-rowindex]="rowIndex + 2"
      class="group transition-colors duration-200 ease-in-out"
      [class.bg-white]="
        rowIndex % 2 === 0 && !row.recentlyUpdated && !row.error && !row.dirty && !row.isNew
      "
      [class.bg-zinc-50]="
        rowIndex % 2 === 1 && !row.recentlyUpdated && !row.error && !row.dirty && !row.isNew
      "
      [class.bg-green-50]="row.recentlyUpdated"
      [class.bg-red-50]="row.error"
      [class.bg-amber-50]="row.dirty && !row.isNew && !row.error && !row.recentlyUpdated"
      [class.bg-blue-50]="row.isNew && !row.error && !row.recentlyUpdated"
      [class.hover:bg-zinc-100]="!row.recentlyUpdated && !row.error && !row.dirty && !row.isNew"
    >
      @if (selectable()) {
        <td
          role="gridcell"
          [attr.aria-colindex]="1"
          class="w-12 border-b border-r border-zinc-200 sticky left-0 z-20 bg-inherit p-0"
          [class.border-b-0]="rowIndex === rows().length - 1"
          [attr.title]="getRowStatusTooltip(row)"
        >
          <div class="relative flex h-full w-full items-center justify-center">
            @if (row.saving) {
              <svg
                class="absolute h-4 w-4 animate-spin text-zinc-500"
                viewBox="0 0 24 24"
                fill="none"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                />
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                />
              </svg>
            } @else {
              @if (row.dirty || row.error || row.isNew || row.recentlyUpdated) {
                <span
                  class="absolute inset-y-0 left-0 w-1"
                  [class.bg-green-500]="row.recentlyUpdated"
                  [class.bg-red-500]="row.error && !row.recentlyUpdated"
                  [class.bg-amber-500]="
                    row.dirty && !row.isNew && !row.error && !row.recentlyUpdated
                  "
                  [class.bg-blue-500]="row.isNew && !row.error && !row.recentlyUpdated"
                ></span>
              }
              <div class="flex items-center justify-center p-3">
                <shared-checkbox
                  [checked]="row.selected"
                  [ariaLabel]="'dataGrid.selectRow' | translate: { rowIndex: rowIndex + 1 }"
                  [dense]="true"
                  (checkedChange)="onRowSelect(rowIndex)"
                />
              </div>
            }
          </div>
        </td>
      }

      @for (column of columns(); track column.id; let colIndex = $index) {
        <td
          #cellRef
          role="gridcell"
          [attr.aria-colindex]="getAriaColIndex(colIndex)"
          [attr.tabindex]="isCellFocused(rowIndex, colIndex) ? 0 : -1"
          (click)="onCellClick(rowIndex, colIndex)"
          (keydown)="onCellKeydown($event, rowIndex, colIndex)"
          (focus)="cellFocus.emit({ rowIndex: rowIndex, columnIndex: colIndex })"
          class="relative whitespace-nowrap border-b border-zinc-200 px-3 py-2.5 text-sm outline-none transition-colors"
          [class.border-r]="colIndex !== columns().length - 1"
          [class.border-r-0]="colIndex === columns().length - 1"
          [class.border-b-0]="rowIndex === rows().length - 1"
          [class.sticky]="column.frozen"
          [class.z-10]="column.frozen"
          [class.bg-inherit]="column.frozen"
          [class.shadow-[2px_0_4px_-2px_rgba(0,0,0,0.1)]]="column.frozen"
          [style.width]="column.width"
          [style.min-width]="column.minWidth ?? '80px'"
          [style.max-width]="column.maxWidth"
          [style.left]="column.frozen ? getFrozenColumnLeft(colIndex) : null"
          [class.text-center]="column.align === 'center'"
          [class.text-right]="column.align === 'right'"
          [class.ring-2]="isCellFocused(rowIndex, colIndex)"
          [class.ring-black]="isCellFocused(rowIndex, colIndex)"
          [class.ring-inset]="isCellFocused(rowIndex, colIndex)"
          [class.z-[15]]="isCellFocused(rowIndex, colIndex)"
        >
          @if (isCellEditable(rowIndex, column)) {
            <div class="flex flex-col gap-1">
              <div #inputRef class="relative w-full">
                @switch (column.cellType) {
                  @case ('address') {
                    <data-grid-address-cell
                      [value]="getInputStringValue(row, column)"
                      (valueChange)="onInputChange(rowIndex, column, $event)"
                      (addressSelect)="onAddressSelect(rowIndex, column, $event)"
                    />
                  }
                  @case ('icon') {
                    <data-grid-icon-cell
                      [value]="getInputStringValue(row, column) || null"
                      (valueChange)="onInputChange(rowIndex, column, $event ?? '')"
                    />
                  }
                  @case ('color') {
                    <data-grid-color-cell
                      [value]="getInputStringValue(row, column) || null"
                      (valueChange)="onInputChange(rowIndex, column, $event)"
                    />
                  }
                  @case ('thumbnail') {
                    <data-grid-thumbnail-cell
                      [value]="getInputStringValue(row, column) || null"
                      [config]="column.thumbnailConfig"
                    />
                  }
                  @case ('select') {
                    <div class="relative">
                      <select
                        class="w-full appearance-none rounded-md border bg-transparent px-2.5 py-1.5 pr-8 text-sm focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900"
                        [class.text-zinc-500]="getInputValue(row, column) === ''"
                        [class.border-transparent]="!getCellError(row, column.id)"
                        [class.border-red-500]="getCellError(row, column.id)"
                        [class.bg-red-50]="getCellError(row, column.id)"
                        [attr.aria-invalid]="getCellError(row, column.id) ? true : null"
                        [attr.aria-describedby]="
                          getCellError(row, column.id) ? getCellErrorId(rowIndex, column.id) : null
                        "
                        (change)="onInputChange(rowIndex, column, $event)"
                        (keydown.enter)="onInputEnter($event)"
                        (focus)="cellFocus.emit({ rowIndex: rowIndex, columnIndex: colIndex })"
                      >
                        <option value="" disabled [selected]="getInputValue(row, column) === ''">
                          {{ 'dataGrid.selectOption' | translate }}
                        </option>
                        @for (option of column.selectOptions ?? []; track option.value) {
                          <option
                            [value]="option.value"
                            [selected]="option.value === getInputValue(row, column)"
                          >
                            {{ option.label }}
                          </option>
                        }
                      </select>
                      <div
                        class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-zinc-500"
                      >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          />
                        </svg>
                      </div>
                    </div>
                  }
                  @case ('boolean') {
                    <div class="flex justify-center">
                      <input
                        type="checkbox"
                        class="h-4 w-4 rounded border-zinc-300 text-black focus:ring-black"
                        [checked]="!!getCellValue(row, column)"
                        (change)="onInputChange(rowIndex, column, $event)"
                        (focus)="cellFocus.emit({ rowIndex: rowIndex, columnIndex: colIndex })"
                        [attr.aria-invalid]="getCellError(row, column.id) ? true : null"
                        [attr.aria-describedby]="
                          getCellError(row, column.id) ? getCellErrorId(rowIndex, column.id) : null
                        "
                      />
                    </div>
                  }
                  @default {
                    <input
                      [type]="getInputType(column)"
                      class="w-full rounded-md border bg-transparent px-2.5 py-1.5 text-base sm:text-sm focus:border-zinc-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900"
                      [class.pr-8]="isActionColumn(colIndex)"
                      [value]="getInputValue(row, column)"
                      [class.text-zinc-500]="getInputValue(row, column) === ''"
                      [class.border-transparent]="!getCellError(row, column.id)"
                      [class.border-red-500]="getCellError(row, column.id)"
                      [class.bg-red-50]="getCellError(row, column.id)"
                      [attr.aria-invalid]="getCellError(row, column.id) ? true : null"
                      [attr.aria-describedby]="
                        getCellError(row, column.id) ? getCellErrorId(rowIndex, column.id) : null
                      "
                      (input)="onInputChange(rowIndex, column, $event)"
                      (keydown.enter)="onInputEnter($event)"
                      (focus)="cellFocus.emit({ rowIndex: rowIndex, columnIndex: colIndex })"
                    />
                  }
                }

                @if (
                  isActionColumn(colIndex) &&
                  (rowViewActionEnabled() || (rowDeleteActionEnabled() && canDeleteRow(row)))
                ) {
                  <div
                    class="absolute right-1 top-1/2 z-20 flex -translate-y-1/2 items-center gap-1 rounded-md bg-inherit py-0.5 pl-1 opacity-0 transition-opacity duration-200 group-hover:opacity-100 focus-within:opacity-100"
                  >
                    @if (rowViewActionEnabled()) {
                      <button
                        type="button"
                        class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border border-zinc-200 bg-white text-zinc-600 shadow-sm transition-colors hover:bg-zinc-50 hover:text-black focus:outline-none focus:ring-2 focus:ring-black"
                        aria-label="{{ 'dataGrid.viewDetails' | translate }}"
                        title="{{ 'dataGrid.viewDetails' | translate }}"
                        (click)="onRowDoubleClick(rowIndex); $event.stopPropagation()"
                      >
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M2.458 12C3.732 7.943 7.522 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.478 0-8.268-2.943-9.542-7z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                      </button>
                    }
                    @if (rowDeleteActionEnabled() && canDeleteRow(row)) {
                      <button
                        type="button"
                        class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border border-zinc-200 bg-white text-red-600 shadow-sm transition-colors hover:bg-red-50 hover:border-red-200 focus:outline-none focus:ring-2 focus:ring-red-600"
                        aria-label="{{ 'dataGrid.delete' | translate }}"
                        title="{{ 'dataGrid.delete' | translate }}"
                        (click)="onRowDelete(rowIndex); $event.stopPropagation()"
                      >
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0h8m-9 0V5a2 2 0 012-2h4a2 2 0 012 2v2"
                          />
                        </svg>
                      </button>
                    }
                  </div>
                }
              </div>

              @if (getCellError(row, column.id)) {
                <span
                  class="block px-1 text-[10px] font-bold uppercase tracking-wider text-red-600"
                  role="alert"
                  [id]="getCellErrorId(rowIndex, column.id)"
                >
                  {{ getCellError(row, column.id) }}
                </span>
              }
            </div>
          } @else {
            <div
              class="flex min-h-7 items-center gap-2"
              [class.justify-between]="isActionColumn(colIndex)"
            >
              <span
                class="truncate"
                [title]="getCellDisplayValue(row, column)"
                [class.text-zinc-400]="
                  getCellValue(row, column) === null ||
                  getCellValue(row, column) === undefined ||
                  getCellValue(row, column) === ''
                "
              >
                @if (column.cellType === 'boolean') {
                  @if (getCellValue(row, column)) {
                    <div
                      class="flex items-center gap-1.5 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700"
                    >
                      <svg
                        class="h-3.5 w-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      <span>Yes</span>
                    </div>
                  } @else {
                    <div
                      class="flex items-center gap-1.5 rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-500"
                    >
                      <svg
                        class="h-3.5 w-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M6 18L18 6M6 6l12 12"
                        />
                      </svg>
                      <span>No</span>
                    </div>
                  }
                } @else if (column.cellType === 'color') {
                  <div class="flex items-center gap-2">
                    <span
                      class="h-4 w-4 shrink-0 rounded-full border border-zinc-200 shadow-sm"
                      [style.backgroundColor]="hexOrTransparent(getCellValue(row, column))"
                      aria-hidden="true"
                    ></span>
                    <span class="truncate font-mono text-xs">{{
                      getCellValue(row, column) ?? '—'
                    }}</span>
                  </div>
                } @else if (isStatusColumn(column)) {
                  <shared-status-badge
                    [status]="$any(getCellValue(row, column))"
                    type="lead"
                  ></shared-status-badge>
                } @else if (column.cellType === 'select') {
                  @let meta = getSelectMeta(column, getCellValue(row, column));
                  @if (meta) {
                    <span class="inline-flex items-center gap-2" [title]="meta.description ?? ''">
                      @if (meta.color) {
                        <span
                          class="h-2 w-2 shrink-0 rounded-full"
                          [style.backgroundColor]="hexOrTransparent(meta.color)"
                          aria-hidden="true"
                        ></span>
                      }
                      @if (meta.icon) {
                        <lucide-icon
                          [name]="meta.icon"
                          class="h-4 w-4 shrink-0 text-zinc-500"
                        ></lucide-icon>
                      }
                      <span class="truncate">{{
                        meta.label ??
                          (column.selectOptions | optionLabel: getCellValue(row, column))
                      }}</span>
                    </span>
                  } @else {
                    {{ column.selectOptions | optionLabel: getCellValue(row, column) }}
                  }
                } @else if (column.cellType === 'thumbnail') {
                  <data-grid-thumbnail-cell
                    [value]="getInputStringValue(row, column) || null"
                    [config]="column.thumbnailConfig"
                  />
                } @else if (column.cellType === 'date') {
                  <span class="tabular-nums">{{ getRelativeDateValue(row, column) }}</span>
                } @else {
                  {{ getCellValue(row, column) ?? '—' }}
                }
              </span>

              @if (
                isActionColumn(colIndex) &&
                (rowViewActionEnabled() || (rowDeleteActionEnabled() && canDeleteRow(row)))
              ) {
                <div
                  class="ml-2 flex items-center gap-1 opacity-0 transition-opacity duration-200 group-hover:opacity-100 has-focus:opacity-100"
                >
                  @if (rowViewActionEnabled()) {
                    <button
                      type="button"
                      class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border border-zinc-200 bg-white text-zinc-600 shadow-sm transition-colors hover:bg-zinc-50 hover:text-black focus:outline-none focus:ring-2 focus:ring-black"
                      aria-label="{{ 'dataGrid.viewDetails' | translate }}"
                      title="{{ 'dataGrid.viewDetails' | translate }}"
                      (click)="onRowDoubleClick(rowIndex); $event.stopPropagation()"
                    >
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M2.458 12C3.732 7.943 7.522 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.478 0-8.268-2.943-9.542-7z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                    </button>
                  }
                  @if (rowDeleteActionEnabled() && canDeleteRow(row)) {
                    <button
                      type="button"
                      class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border border-zinc-200 bg-white text-red-600 shadow-sm transition-colors hover:bg-red-50 hover:border-red-200 focus:outline-none focus:ring-2 focus:ring-red-600"
                      aria-label="{{ 'dataGrid.delete' | translate }}"
                      title="{{ 'dataGrid.delete' | translate }}"
                      (click)="onRowDelete(rowIndex); $event.stopPropagation()"
                    >
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0h8m-9 0V5a2 2 0 012-2h4a2 2 0 012 2v2"
                        />
                      </svg>
                    </button>
                  }
                </div>
              }
            </div>
          }
        </td>
      }
    </tr>
  } @empty {}
</tbody>
</file>

<file path="src/app/shared/components/data-grid/data-grid-cards.component.html">
<ul class="flex flex-col w-full divide-y divide-zinc-100 bg-white dark:divide-zinc-800 dark:bg-zinc-900"
  [attr.aria-label]="'dataGrid.dataCards' | translate"> @for (row of rows(); track trackByRowId($index, row); let
  rowIndex = $index) { <li class="relative">
    <button type="button"
      class="group relative flex w-full flex-col text-left transition-colors duration-200 hover:bg-zinc-50 active:bg-zinc-100 dark:hover:bg-zinc-800/50 dark:active:bg-zinc-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500"
      [class.bg-blue-50]="row.selected"
      [class.dark:bg-blue-900/10]="row.selected"
      [attr.aria-pressed]="row.selected ? 'true' : 'false'"
      (click)="onCardClick(rowIndex, $event)" (keydown)="onCardKeydown($event, rowIndex)">
      
      <div class="flex w-full items-start gap-4 p-4 text-left"> 
        @if (selectable()) { 
          <div class="flex h-12 w-6 shrink-0 items-center justify-center -ml-1" data-row-select>
            <shared-checkbox
              [checked]="row.selected" [ariaLabel]="'dataGrid.selectRow' | translate:{rowIndex: rowIndex + 1}"
              [dense]="true" (checkedChange)="onSelect(rowIndex)" /> 
          </div> 
        }

        <div class="relative flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-zinc-100 ring-1 ring-inset ring-black/5 dark:bg-zinc-800 dark:ring-white/10">
          @if (getThumbnailUrl(row)) {
            <img
              [src]="getThumbnailUrl(row)!"
              [alt]="getTitleText(row)"
              class="h-full w-full rounded-full object-cover"
            />
          } @else {
            <span class="text-sm font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400">
              {{ getInitials(row) }}
            </span>
          }
        </div>

        <div class="flex min-w-0 flex-1 flex-col justify-center gap-0.5 min-h-12">
          <div class="flex items-start justify-between gap-4">
            <h3 class="truncate text-base font-semibold leading-6 text-zinc-900 dark:text-zinc-100">
              {{ getTitleText(row) }}
            </h3>
            
            <div class="flex shrink-0 items-center gap-1 text-zinc-400">
              <svg
                class="h-5 w-5 transition-transform group-hover:translate-x-0.5"
                fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>

          @if (getSubtitleText(row)) {
          <p class="truncate text-sm text-zinc-500 dark:text-zinc-400">
            {{ getSubtitleText(row) }}
          </p>
          }

          @if (getSecondarySubtitleText(row)) {
          <p class="truncate text-xs font-medium text-zinc-400 dark:text-zinc-500 mt-0.5">
            {{ getSecondarySubtitleText(row) }}
          </p>
          }

          @if (getStatusValue(row)) {
          <div class="mt-3 flex items-center gap-3">
            <shared-status-badge [status]="$any(getStatusValue(row))" type="lead"
              class="origin-left"></shared-status-badge>

            @if (row.recentlyUpdated) {
            <span class="flex h-2.5 w-2.5 relative">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-blue-500"></span>
            </span>
            }
          </div>
          }
        </div>
      </div>

      @if (row.error) {
      <div
        class="flex w-full items-center gap-2 border-t border-red-100 bg-red-50/50 px-4 py-2.5 text-xs font-medium text-red-600 dark:border-red-900/30 dark:bg-red-900/10 dark:text-red-400">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {{ row.error }}
      </div>
      }
    </button>
    
    @if (rowDeleteActionEnabled() && canDeleteRow(row)) {
    <button type="button"
      class="absolute right-4 top-4 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/50 text-zinc-400 backdrop-blur-sm transition-all hover:bg-red-50 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-500/20 active:scale-90 dark:bg-zinc-800/50 dark:hover:bg-red-900/30 dark:hover:text-red-400"
      aria-label="{{ 'dataGrid.delete' | translate }}" title="{{ 'dataGrid.delete' | translate }}"
      (click)="onDelete(rowIndex, $event); $event.stopPropagation()">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0h8m-9 0V5a2 2 0 012-2h4a2 2 0 012 2v2" />
      </svg>
    </button>
    }

    <app-bottom-sheet [isOpen]="isEditing(rowIndex)"
      [title]="row.isNew ? ('dataGrid.newRecord' | translate) : ('dataGrid.editRecord' | translate)"
      (close)="closeEdit()">
      <div class="flex flex-col gap-5 p-6">
        @if (getEditableColumns(row).length === 0) {
        <div class="flex flex-col items-center justify-center py-8 text-zinc-500">
          <p class="text-sm">{{ 'dataGrid.noEditableFields' | translate }}</p>
        </div>
        } @else {
        <div class="flex flex-col gap-4">
          @for (column of getEditableColumns(row); track column.id) {
          <div class="flex flex-col gap-1.5">
            @if (column.cellType === 'boolean') {
            <shared-checkbox [checked]="!!getCellValue(row, column)"
              (checkedChange)="onCellValueChange(rowIndex, column, $event)" [label]="column.header" />
            } @else if (column.cellType === 'select') {
            <shared-select [options]="column.selectOptions ?? []" [value]="getInputValue(row, column)"
              (valueChange)="onCellValueChange(rowIndex, column, $event)" [label]="column.header"
              [placeholder]="'dataGrid.selectAnOption' | translate" />
            } @else if (column.cellType === 'color') {
            <shared-color-picker [value]="getInputString(row, column)"
              (valueChange)="onCellValueChange(rowIndex, column, $event)" [label]="column.header"
              placeholder="#3B82F6" />
            } @else if (column.cellType === 'thumbnail') {
            <div class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-zinc-700">{{ column.header }}</span>
              <data-grid-thumbnail-cell
                [value]="getInputString(row, column) || null"
                [config]="column.thumbnailConfig"
              />
            </div>
            } @else {
            <shared-input [type]="column.cellType === 'number' ? 'number' : 'text'"
              [value]="getInputString(row, column)" (valueChange)="onCellValueChange(rowIndex, column, $event)"
              [label]="column.header" [placeholder]="'dataGrid.enterValue' | translate" />
            }
          </div>
          }
        </div>
        }
        <div class="pt-2">
          <shared-button [fullWidth]="true" variant="primary" size="default" (clicked)="closeEdit()">
            {{ row.isNew ? ('dataGrid.create' | translate) : ('dataGrid.save' | translate) }}
          </shared-button>
        </div>
      </div>
    </app-bottom-sheet>
  </li>

  }

  @if (rows().length === 0) { <li
    class="flex flex-col items-center justify-center gap-3 border-dashed border-zinc-200 py-16 text-center dark:border-zinc-800">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-50 text-zinc-300 dark:bg-zinc-800/50 dark:text-zinc-600">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg> </div> <span class="text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500"> {{
      'dataGrid.noResults' | translate }} </span>
  </li> }

</ul>
</file>

<file path="src/app/shared/components/features/lead-services-card/lead-services-card.component.html">
<shared-card class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white font-sans">
  
  <div class="flex items-center justify-between px-5 py-4">
    <div class="flex items-center gap-3">
      <h2 class="text-sm font-semibold text-slate-900">Services</h2>
      <span class="flex h-5 items-center justify-center rounded-md bg-slate-100 px-2 text-xs font-medium text-slate-600">
        {{ services().length }}
      </span>
    </div>
    
    <button
      type="button"
      class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 text-slate-500 hover:border-slate-300 hover:text-slate-900 active:bg-slate-50"
      (click)="openAdd.emit()"
      title="Add New Service"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    </button>
  </div>

  @if (showAddForm()) {
    <div class="border-t border-b border-slate-200 bg-slate-50 p-5">
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wide text-slate-500">New Scope Configuration</h3>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <shared-select
            label="Service Type"
            class="w-full bg-white"
            [options]="serviceTypeOptions()"
            [value]="newServiceType()"
            (valueChange)="newServiceTypeChange.emit($event)"
          />
          <shared-input
            label="Source"
            class="bg-white"
            placeholder="e.g. Inbound Call"
            [value]="newServiceSource()"
            (valueChange)="newServiceSourceChange.emit($event)"
          />
        </div>
        
        <shared-textarea
          id="new-service-note"
          label="Consumer Note"
          class="bg-white"
          placeholder="Context for this service..."
          [rows]="2"
          [value]="newServiceConsumerNote()"
          (valueChange)="newServiceConsumerNoteChange.emit($event)"
        />
        
        <div class="flex items-center justify-between pt-2">
          <shared-checkbox
            label="Close active service"
            [checked]="closeCurrentService()"
            (checkedChange)="closeCurrentServiceChange.emit($event)"
            [dense]="true"
          />
          
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="text-xs font-medium text-slate-500 hover:text-slate-900 hover:underline"
              (click)="cancelAdd.emit()"
            >
              Cancel
            </button>
            <button
              type="button"
              class="rounded-md bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 disabled:opacity-50"
              [disabled]="!newServiceType() || saving()"
              (click)="addService.emit()"
            >
              {{ saving() ? 'Saving...' : 'Confirm Scope' }}
            </button>
          </div>
        </div>
      </div>
    </div>
  }

  <div class="flex flex-col border-t border-slate-100">
    @if (services().length === 0) {
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <p class="text-sm font-medium text-slate-900">No services active</p>
        <p class="text-xs text-slate-500 mt-1">Configure a new scope above.</p>
      </div>
    } @else {
      @for (service of services(); track service.id) {
        <button
          type="button"
          class="group relative flex w-full items-start justify-between border-b border-slate-100 px-5 py-4 text-left last:border-0 hover:bg-slate-50"
          [class.bg-slate-50]="isSelected(service)"
          (click)="selectService.emit(service)"
        >
          @if (isSelected(service)) {
            <div class="absolute inset-y-0 left-0 w-0.75 bg-slate-900"></div>
          }

          <div class="flex flex-col gap-1">
            <span 
              class="text-sm font-semibold text-slate-900"
              [class.text-indigo-600]="isSelected(service)"
            >
              {{ serviceTypeLabels()[service.serviceType] || service.serviceType }}
            </span>
            <div class="flex items-center gap-2 text-xs text-slate-500">
              <span>{{ service.createdAt | date: 'MMM d, y' }}</span>
              <span class="text-slate-300">•</span>
              <span>{{ service.source || 'Direct' }}</span>
            </div>
          </div>

          <div class="flex items-center gap-4">
             <span
              class="inline-flex items-center rounded border px-2 py-1 text-[10px] font-bold uppercase tracking-wider"
              [class.border-slate-200]="!isSelected(service)"
              [class.bg-white]="!isSelected(service)"
              [class.text-slate-500]="!isSelected(service)"
              [class.border-indigo-200]="isSelected(service)"
              [class.bg-indigo-50]="isSelected(service)"
              [class.text-indigo-700]="isSelected(service)"
            >
              {{ statusLabels()[service.status] || service.status }}
            </span>
          </div>
        </button>
      }
    }
  </div>
</shared-card>
</file>

<file path="src/app/shared/components/input/input.component.ts">
import { Component, computed, input, model, signal, ChangeDetectionStrategy } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { FieldShellComponent } from '../field-shell/field-shell.component';

@Component({
  selector: 'shared-input',
  standalone: true,
  imports: [FormsModule, FieldShellComponent],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <shared-field-shell
      [label]="label()"
      [required]="required()"
      [hint]="hint()"
      [error]="error()"
      [uid]="uid"
      [hintId]="hintId"
      [errorId]="errorId"
    >
      <div class="relative w-full group">
        <input
          [id]="uid"
          [type]="inputType()"
          [placeholder]="placeholder()"
          [(ngModel)]="value"
          [disabled]="disabled()"
          [readonly]="readonly()"
          [required]="required()"
          [attr.min]="min() || null"
          [attr.max]="max() || null"
          [attr.aria-required]="required()"
          [attr.aria-invalid]="!!error()"
          [attr.aria-label]="ariaLabel() || label() || placeholder()"
          [attr.aria-describedby]="describedBy()"
             class="peer block w-full h-11 rounded-lg border border-zinc-200 bg-white px-3 py-2.5 text-base text-zinc-900 placeholder:text-zinc-400
               outline-none transition-all duration-200 ease-out
                 focus:border-zinc-900 focus:ring-2 focus:ring-zinc-900/10
               disabled:cursor-not-allowed disabled:bg-zinc-50 disabled:text-zinc-500
                 read-only:cursor-default read-only:bg-zinc-50
                 md:text-sm
                 
                 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none
                 
               data-[type=date]:min-h-11 data-[type=date]:py-1.75
                 
                 file:mr-4 file:h-full file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-zinc-900"
          
          [attr.data-type]="inputType()"
          [class.border-red-600]="!!error()"
          [class.focus:border-red-600]="!!error()"
          [class.focus:ring-red-600]="!!error()"
          [class.focus:ring-red-100]="!!error()"
          [class.text-red-900]="!!error()"
          [class.placeholder:text-red-300]="!!error()"
          
          [class.pr-10]="suffixCount() === 1"
          [class.pr-20]="suffixCount() === 2"
        />

        @if (suffixCount() > 0) {
          <div class="absolute right-0 top-0 bottom-0 flex items-center gap-1 pr-2 z-10">
            
            @if (showPasswordToggle()) {
              <button
                type="button"
                (click)="togglePasswordVisibility()"
                class="flex h-8 w-8 items-center justify-center rounded-md text-zinc-400 transition-colors cursor-pointer touch-manipulation
                       hover:bg-zinc-100 hover:text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900"
                [attr.aria-label]="passwordToggleLabel()"
                [attr.aria-pressed]="isPasswordVisible()"
                tabindex="-1"
              >
                @if (isPasswordVisible()) {
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-5.523 0-10-4.477-10-10 0-1.028.154-2.018.441-2.949M6.1 6.1A9.953 9.953 0 0112 5c5.523 0 10 4.477 10 10 0 1.2-.212 2.35-.6 3.414M9.88 9.88a3 3 0 104.24 4.24" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                  </svg>
                } @else {
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.522 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.478 0-8.268-2.943-9.542-7z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                }
              </button>
            }

            @if (showClearButton()) {
              <button
                type="button"
                (click)="clear()"
                class="flex h-8 w-8 items-center justify-center rounded-md text-zinc-400 transition-colors cursor-pointer touch-manipulation
                       hover:bg-zinc-100 hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900"
                aria-label="Clear input"
                tabindex="-1"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            }
          </div>
        }
      </div>
    </shared-field-shell>
  `,
  styles: `
    :host {
      display: block;
      width: 100%;
    }
  `,
})
export class InputComponent {
  value = model<string>('');
  id = input<string | undefined>(undefined);
  label = input<string>('');
  type = input('text');
  placeholder = input('');
  disabled = input(false);
  readonly = input(false);
  required = input(false);
  hint = input<string>('');
  error = input<string>('');
  ariaLabel = input<string | undefined>(undefined);
  clearable = input(true);
  passwordToggle = input(false);
  passwordToggleLabel = input('Toggle password visibility');
  min = input<string | undefined>(undefined);
  max = input<string | undefined>(undefined);

  protected readonly isPasswordVisible = signal(false);
  protected readonly showPasswordToggle = computed(() => this.passwordToggle() && this.type() === 'password');
  
  protected readonly showClearButton = computed(() => 
    this.clearable() && !!this.value() && !this.readonly() && !this.disabled()
  );

  protected readonly suffixCount = computed(() => {
    let count = 0;
    if (this.showPasswordToggle()) count++;
    if (this.showClearButton()) count++;
    return count;
  });

  protected readonly inputType = computed(() => {
    const baseType = this.type();
    if (!this.showPasswordToggle()) return baseType;
    return this.isPasswordVisible() ? 'text' : 'password';
  });

  protected readonly uid = this.id() || 'input-' + Math.random().toString(36).substring(2, 9);
  protected readonly hintId = this.uid + '-hint';
  protected readonly errorId = this.uid + '-error';

  protected describedBy() {
    const ids = [];
    if (this.error()) ids.push(this.errorId);
    if (this.hint()) ids.push(this.hintId);
    return ids.join(' ') || undefined;
  }

  protected clear(): void {
    if (this.disabled() || this.readonly()) return;
    this.value.set('');
  }

  protected togglePasswordVisibility(): void {
    if (this.disabled()) return;
    this.isPasswordVisible.update(visible => !visible);
  }
}
