      [subtitle]="isEditMode() ? (existingQuote()?.quoteNumber ?? '') : ('offertes.newDraft' | translate)"
      [backAriaLabel]="'offertes.goBack' | translate"
      (back)="cancel()"
    >
      <div actions class="flex flex-wrap items-center gap-2">
        <shared-split-action
          [primaryLabel]="'offertes.save'"
          [primaryVariant]="'primary'"
          [menuVariant]="'secondary'"
          [size]="'compact'"
          [primaryDisabled]="!canSave() || saving()"
          [primaryLoading]="saving()"
          [menuSections]="headerActionSections()"
          [menuTriggerLabel]="'offertes.actions'"
          (primaryClicked)="saveDraft()"
          (actionSelected)="onHeaderAction($event)"
        >
          <lucide-icon name="save" class="h-4 w-4" primaryIcon></lucide-icon>
        </shared-split-action>
      </div>
    </shared-page-header>
  </div>

  <!-- Mobile save action bar -->
  <div class="sm:hidden border-b border-gray-100 bg-white px-5 py-3">
    <shared-button variant="primary" size="compact" [fullWidth]="true" [disabled]="!canSave() || saving()" [loading]="saving()" (clicked)="saveDraft()">
      <lucide-icon name="save" class="h-4 w-4"></lucide-icon>
      {{ 'offertes.save' | translate }}
    </shared-button>
  </div>

  <!-- Error Alert -->
  @if (error()) {
    <div class="bg-red-50 border-b border-red-500 text-red-900 p-4 text-sm font-medium flex items-start gap-3">
      <span class="font-bold uppercase text-red-600 shrink-0">{{ 'offertes.errorLabel' | translate }}</span>
      <span>{{ error() }}</span>
    </div>
  }

  <!-- Loading State -->
  @if (loading()) {
    <div class="flex-1 flex flex-col items-center justify-center p-12 gap-4">
      <div class="animate-spin h-10 w-10 border-4 border-zinc-100 border-t-black"></div>
      <p class="text-xs font-mono uppercase text-zinc-400">{{ 'offertes.loading' | translate }}</p>
    </div>
  } @else {
    <div class="flex-1 flex flex-col lg:flex-row">
      <!-- Main Content -->
      <div class="flex-1 flex flex-col">
        <!-- Section 1: Lead Selection -->
        <section class="p-4 sm:p-6 border-b border-zinc-200">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">01</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'offertes.selectLead' | translate }}
            </h2>
          </div>

          @if (selectedLead(); as lead) {
            <!-- Selected lead card -->
            <div class="flex items-start justify-between gap-4 p-4 bg-zinc-50 border border-zinc-200 rounded-lg">
              <div class="flex flex-col gap-1">
                <span class="font-semibold text-zinc-900">
                  {{ lead.consumer.firstName }} {{ lead.consumer.lastName }}
                </span>
                <span class="text-sm text-zinc-500">
                  {{ lead.address.street }} {{ lead.address.houseNumber }}, {{ lead.address.zipCode }} {{ lead.address.city }}
                </span>
                @if (lead.consumer.phone) {
                  <span class="text-sm text-zinc-400">{{ lead.consumer.phone }}</span>
                }
              </div>
              <button
                type="button"
                (click)="clearLead()"
                class="text-zinc-400 hover:text-zinc-600 p-1"
                [attr.aria-label]="'offertes.changeLead' | translate"
              >
                <lucide-icon name="x" class="h-4 w-4"></lucide-icon>
              </button>
            </div>
          } @else {
            <!-- Lead search -->
            <shared-autocomplete
              [label]="''"
              [placeholder]="'offertes.searchLeadPlaceholder' | translate"
              [value]="leadSearchQuery()"
              (valueChange)="onLeadSearchChange($event); onLeadSelected($event)"
              [options]="leadOptions()"
              filterMode="manual"
            />
          }

          <div class="mt-6">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-3">
              {{ 'offertes.validityNotes' | translate }}
            </h3>
            <div class="grid grid-cols-1 gap-4">
              <shared-input
                [label]="'offertes.validUntil' | translate"
                type="date"
                [value]="summaryForm.controls.validUntil.value ?? ''"
                (valueChange)="summaryForm.controls.validUntil.setValue($event)"
              />
              <shared-textarea
                [label]="'offertes.notes' | translate"
                [rows]="3"
                [placeholder]="'offertes.notesPlaceholder' | translate"
                [value]="summaryForm.controls.notes.value ?? ''"
                (valueChange)="summaryForm.controls.notes.setValue($event)"
              />
              <shared-checkbox
                [label]="'offertes.financingDisclaimer' | translate"
                [checked]="financingDisclaimer()"
                (checkedChange)="financingDisclaimer.set($event)"
              />
            </div>
          </div>
        </section>

        <!-- AI Generate Panel -->
        @if (selectedLead()) {
          <section class="p-4 sm:p-6 border-b border-zinc-200 bg-linear-to-r from-zinc-50 to-white">
            <button
              type="button"
              (click)="toggleGeneratePanel()"
              class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-zinc-500 hover:text-zinc-800 transition-colors w-full"
            >
              <lucide-icon name="sparkles" class="h-4 w-4"></lucide-icon>
              {{ 'offertes.generate.title' | translate }}
              <lucide-icon
                [name]="showGeneratePanel() ? 'chevron-up' : 'chevron-down'"
                class="h-4 w-4 ml-auto"
              ></lucide-icon>
            </button>

            @if (showGeneratePanel()) {
              <div class="mt-4 space-y-4">
                <p class="text-sm text-zinc-500">
                  {{ 'offertes.generate.description' | translate }}
                </p>

                <!-- Service selector -->
                @if (leadServices().length > 1) {
                  <div>
                    <label for="generate-service-select" class="block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1">
                      {{ 'offertes.generate.service' | translate }}
                    </label>
                    <shared-select
                      id="generate-service-select"
                      [options]="leadServiceOptions()"
                      [value]="selectedServiceId()"
                      (valueChange)="selectedServiceId.set($event)"
                    />
                  </div>
                }

                <!-- Prompt textarea -->
                <shared-textarea
                  [label]="'offertes.generate.promptLabel' | translate"
                  [rows]="3"
                  [placeholder]="'offertes.generate.promptPlaceholder' | translate"
                  [value]="generatePrompt()"
                  (valueChange)="generatePrompt.set($event)"
                />

                @if (generateError()) {
                  <div class="text-sm text-red-600 bg-red-50 px-3 py-2 rounded">
                    {{ generateError() }}
                  </div>
                }

                <div>
                  <shared-button
                    variant="secondary"
                    size="compact"
                    [disabled]="!generatePrompt().trim() || !selectedServiceId() || generating()"
                    [loading]="generating()"
                    (clicked)="generateQuote()"
                  >
                    <lucide-icon name="sparkles" class="h-4 w-4"></lucide-icon>
                    {{ generating() ? ('offertes.generate.generating' | translate) : ('offertes.generate.submit' | translate) }}
                  </shared-button>
                </div>
              </div>
            }
          </section>
        }

        <!-- Section 2: Line Items -->
        <section class="p-4 sm:p-6 border-b border-zinc-200 flex-1">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">02</span>
              <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
                {{ 'offertes.lineItems' | translate }}
              </h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-400">
                {{ 'offertes.pricingMode' | translate }}
              </span>
              <shared-select
                class="w-36"
                [options]="pricingModeOptions()"
                [value]="pricingMode()"
                (valueChange)="setPricingMode($event)"
              />
            </div>
          </div>

          <!-- Line items mobile cards -->
          <div class="sm:hidden space-y-3">
            @for (item of lineItems(); track item.id) {
              <div class="border border-zinc-200 rounded-lg bg-white p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <textarea
                    appGhostText
                    [ghostSearchFn]="catalogSearchFn"
                    (ghostAccepted)="onGhostAccepted(item.id, $event)"
                    [value]="item.description"
                    (input)="updateLineItem(item.id, 'description', $any($event.target).value)"
                    rows="2"
                    class="flex-1 px-3 py-2 text-sm bg-white border border-zinc-200 rounded transition-all focus:outline-none focus:border-black placeholder:text-zinc-400 resize-none"
                    [placeholder]="'offertes.catalogSearchPlaceholder' | translate"
                  ></textarea>
                  <button
                    type="button"
                    (click)="removeLineItem(item.id)"
                    class="text-zinc-400 hover:text-red-500 p-1 shrink-0"
                    [attr.aria-label]="'offertes.removeItem' | translate"
                  >
                    <lucide-icon name="trash-2" class="h-4 w-4"></lucide-icon>
                  </button>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <shared-input
                    [label]="'offertes.qty' | translate"
                    [value]="item.quantity"
                    (valueChange)="updateLineItem(item.id, 'quantity', $event)"
                    [placeholder]="'offertes.qtyPlaceholder' | translate"
                  />
                  <shared-number-input
                    [label]="'offertes.price' | translate"
                    [value]="item.unitPrice"
                    (valueChange)="updateLineItemPrice(item.id, $event)"
                    prefix="€"
                    [alignRight]="true"
                  />
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <shared-select
                    [label]="'offertes.tax' | translate"
                    [options]="taxRateOptions()"
                    [value]="item.taxRate"
                    (valueChange)="updateLineItemTaxRate(item.id, $event)"
                  />
                  <div class="flex flex-col justify-end">
                    <span class="text-xs text-zinc-400 mb-1">{{ 'offertes.total' | translate }}</span>
                    <span class="text-sm font-semibold text-right">{{ formatCurrency(getLineItemTotal(item)) }}</span>
                  </div>
                </div>

                <shared-checkbox
                  [dense]="true"
                  [label]="'offertes.optional' | translate"
                  [checked]="item.optional"
                  (checkedChange)="updateLineItemOptional(item.id, $event)"
                />
              </div>
            }
          </div>

          <!-- Line items table (desktop) -->
          <div class="hidden sm:block overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-zinc-200">
                  <th class="text-left py-3 px-2 text-xs font-bold uppercase tracking-wide text-zinc-500 w-24">
                    {{ 'offertes.qty' | translate }}
                  </th>
                  <th class="text-left py-3 px-2 text-xs font-bold uppercase tracking-wide text-zinc-500">
                    {{ 'offertes.description' | translate }}
                  </th>
                  <th class="text-right py-3 px-2 text-xs font-bold uppercase tracking-wide text-zinc-500 w-28">
                    {{ 'offertes.price' | translate }}
                  </th>
                  <th class="text-right py-3 px-2 text-xs font-bold uppercase tracking-wide text-zinc-500 w-32">
                    {{ 'offertes.tax' | translate }}
                  </th>
                  <th class="text-right py-3 px-2 text-xs font-bold uppercase tracking-wide text-zinc-500 w-28">
                    {{ 'offertes.total' | translate }}
                  </th>
                  <th class="text-left py-3 px-2 text-xs font-bold uppercase tracking-wide text-zinc-500 w-28">
                    {{ 'offertes.optional' | translate }}
                  </th>
                  <th class="w-10"></th>
                </tr>
              </thead>
              <tbody>
                @for (item of lineItems(); track item.id) {
                  <tr class="border-b border-zinc-100 group hover:bg-zinc-50 transition-colors">
                    <td class="py-2 px-2">
                      <shared-input
                        [value]="item.quantity"
                        (valueChange)="updateLineItem(item.id, 'quantity', $event)"
                        [placeholder]="'offertes.qtyPlaceholder' | translate"
                        class="w-20"
                      />
                    </td>
                    <td class="py-2 px-2">
                      <div class="relative">
                        <textarea
                          appGhostText
                          [ghostSearchFn]="catalogSearchFn"
                          (ghostAccepted)="onGhostAccepted(item.id, $event)"
                          [value]="item.description"
                          (input)="updateLineItem(item.id, 'description', $any($event.target).value)"
                          rows="1"
                          class="w-full px-4 py-3 text-sm bg-white border border-zinc-200 rounded transition-all duration-200 focus:outline-none focus:border-black placeholder:text-zinc-400 resize-y min-h-12"
                          [placeholder]="'offertes.catalogSearchPlaceholder' | translate"
                        ></textarea>
                      </div>
                    </td>
                    <td class="py-2 px-2">
                      <shared-number-input
                        [value]="item.unitPrice"
                        (valueChange)="updateLineItemPrice(item.id, $event)"
                        prefix="€"
                        [alignRight]="true"
                        class="w-24"
                      />
                    </td>
                    <td class="py-2 px-2">
                      <shared-select
                        class="w-28"
                        [options]="taxRateOptions()"
                        [value]="item.taxRate"
                        (valueChange)="updateLineItemTaxRate(item.id, $event)"
                      />
                    </td>
                    <td class="py-2 px-2 text-right font-medium text-zinc-900">
                      {{ formatCurrency(getLineItemTotal(item)) }}
                    </td>
                    <td class="py-2 px-2">
                      <shared-checkbox
                        [dense]="true"
                        [checked]="item.optional"
                        [ariaLabel]="'offertes.optional' | translate"
                        (checkedChange)="updateLineItemOptional(item.id, $event)"
                      />
                    </td>
                    <td class="py-2 px-2 text-center">
                      <button
                        type="button"
                        (click)="removeLineItem(item.id)"
                        class="opacity-0 group-hover:opacity-100 text-zinc-400 hover:text-red-500 p-1 transition-opacity"
                        [attr.aria-label]="'offertes.removeItem' | translate"
                      >
                        <lucide-icon name="trash-2" class="h-4 w-4"></lucide-icon>
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="mt-3">
            <button
              type="button"
              (click)="addLineItem()"
              class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-zinc-500 hover:text-zinc-800"
            >
              <lucide-icon name="plus" class="h-4 w-4"></lucide-icon>
              {{ 'offertes.addItem' | translate }}
            </button>
          </div>

          @if (lineItems().length === 0) {
            <div class="text-center py-8 text-zinc-400 text-sm">
              {{ 'offertes.noItemsYet' | translate }}
            </div>
          }
        </section>

        <!-- Section 3: Documents & Links -->
        <section class="p-4 sm:p-6 border-b border-zinc-200">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">03</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'offertes.documents' | translate }}
            </h2>
          </div>

          <app-attachment-panel
            [attachments]="attachmentDrafts()"
            (attachmentsChanged)="onAttachmentsChanged($event)"
            (manualUploadRequested)="onManualUploadRequested($event)"
            (previewRequested)="openPreview($event)"
          />

          <!-- URL links -->
          <div class="mt-4">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-2">
              {{ 'offertes.urls' | translate }}
            </h3>

            @if (urlDrafts().length > 0) {
              <div class="space-y-1 mb-3">
                @for (url of urlDrafts(); track url.uid) {
                  <div class="flex items-center gap-2 px-3 py-2 bg-white border border-zinc-200 rounded-lg group">
                    <lucide-icon name="link-2" class="h-4 w-4 text-zinc-400 shrink-0"></lucide-icon>
                    <span class="text-sm text-zinc-700 truncate flex-1">{{ url.label }}</span>
                    <a
                      [href]="url.href"
                      target="_blank"
                      rel="noopener"
                      class="text-xs text-blue-600 hover:underline shrink-0"
                    >
                      {{ 'offertes.open' | translate }}
                    </a>
                    <button
                      type="button"
                      (click)="removeUrl(url.uid)"
                      class="p-1 text-zinc-400 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-all"
                      [attr.aria-label]="'offertes.remove' | translate"
                    >
                      <lucide-icon name="trash-2" class="h-4 w-4"></lucide-icon>
                    </button>
                  </div>
                }
              </div>
            }

            <!-- Add URL form -->
            <div class="flex items-end gap-2">
              <div class="flex-1 min-w-0">
                <label for="urlLabelInput" class="block text-[10px] font-medium text-zinc-500 mb-0.5">{{ 'offertes.urlLabel' | translate }}</label>
                <input
                  #urlLabel
                  id="urlLabelInput"
                  type="text"
                  [placeholder]="'offertes.urlPlaceholder' | translate"
                  class="w-full rounded-md border border-zinc-300 px-2.5 py-1.5 text-sm text-zinc-800 placeholder:text-zinc-400 focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 focus:outline-none"
                />
              </div>
              <div class="flex-1 min-w-0">
                <label for="urlHrefInput" class="block text-[10px] font-medium text-zinc-500 mb-0.5">{{ 'offertes.urlHref' | translate }}</label>
                <input
                  #urlHref
                  id="urlHrefInput"
                  type="url"
                  [placeholder]="'offertes.urlHrefPlaceholder' | translate"
                  class="w-full rounded-md border border-zinc-300 px-2.5 py-1.5 text-sm text-zinc-800 placeholder:text-zinc-400 focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 focus:outline-none"
                />
              </div>
              <button
                type="button"
                (click)="addUrl(urlLabel.value, urlHref.value); urlLabel.value = ''; urlHref.value = ''"
                class="inline-flex items-center gap-1.5 rounded-md bg-zinc-100 px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-200 transition-colors shrink-0"
              >
                <lucide-icon name="plus" class="h-3.5 w-3.5"></lucide-icon>
                {{ 'offertes.addUrl' | translate }}
              </button>
            </div>
          </div>
        </section>

        
      </div>

      <!-- Sidebar: Summary -->
      <aside class="lg:w-80 xl:w-96 bg-zinc-50 border-l border-zinc-200 flex flex-col">
        <div class="p-4 sm:p-6 flex-1">
          <div class="flex items-center gap-3 mb-6">
            <span class="bg-black text-white text-xs font-bold px-1.5 py-0.5">04</span>
            <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">
              {{ 'offertes.summary' | translate }}
            </h2>
          </div>

          <!-- Totals -->
          <div class="space-y-4">
            <!-- Subtotal -->
            <div class="flex justify-between text-sm">
              <span class="text-zinc-500">{{ 'offertes.subtotal' | translate }}</span>
              <span class="font-medium">{{ formatCurrency(totals().subtotal) }}</span>
            </div>

            <!-- Discount -->
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 text-sm shrink-0">{{ 'offertes.discount' | translate }}</span>
              <div class="flex-1 flex items-center gap-2 justify-end">
                <shared-number-input
                  class="w-24"
                  [value]="summaryForm.controls.discountValue.value"
                  (valueChange)="setDiscountValue($event ?? 0)"
                  [min]="0"
                  [step]="0.01"
                  [alignRight]="true"
                  [prefix]="discountPrefix()"
                  [suffix]="discountSuffix()"
                />
                <shared-select
                  class="w-16"
                  [options]="discountTypeOptions()"
                  [value]="summaryForm.controls.discountType.value"
                  (valueChange)="setDiscountType($event)"
                />
              </div>
            </div>
            @if (totals().discountAmount > 0) {
              <div class="flex justify-between text-sm text-green-600">
                <span></span>
                <span>-{{ formatCurrency(totals().discountAmount) }}</span>
              </div>
            }

            <!-- Tax -->
            <div class="flex justify-between text-sm pt-2 border-t border-zinc-200">
              <span class="text-zinc-500">{{ 'offertes.tax' | translate }}</span>
              <span>{{ formatCurrency(totals().taxAmount) }}</span>
            </div>
            @if (taxBreakdown().length > 0) {
              <div class="space-y-1">
                @for (entry of taxBreakdown(); track entry.rate) {
                  <div class="flex justify-between text-xs text-zinc-400">
                    <span>{{ 'offertes.tax' | translate }} {{ entry.rate }}%</span>
                    <span>{{ formatCurrency(entry.amount) }}</span>
                  </div>
                }
              </div>
            }

            <!-- Total -->
            <div class="flex justify-between pt-4 border-t-2 border-zinc-300">
              <span class="text-lg font-bold uppercase">{{ 'offertes.totalAmount' | translate }}</span>
              <span class="text-2xl font-bold">{{ formatCurrency(totals().total) }}</span>
            </div>

            <div class="pt-4"></div>
          </div>
        </div>

      </aside>
    </div>
  }

  <shared-file-preview-dialog
    [isOpen]="previewOpen()"
    [title]="previewTitle()"
    [fileUrl]="previewUrl()"
    [fileName]="previewFileName()"
    [contentType]="previewContentType()"
    [isLoading]="previewLoading()"
    [error]="previewError()"
    (closed)="closePreview()"
  />
</div>
</file>

<file path="src/app/routes/offertes/quote-proposal/quote-annotation-list.component.html">
<div [class]="listClass()">
  @for (annotation of annotations(); track annotation.id) {
    <div
      class="border transition-all duration-300"
      [class.rounded-2xl]="variant() === 'mobile'"
      [class.rounded-xl]="variant() === 'desktop'"
      [class.border-blue-100]="annotation.authorType === 'customer'"
      [class.border-emerald-100]="annotation.authorType === 'agent'"
      [class.bg-blue-50/30]="annotation.authorType === 'customer'"
      [class.bg-emerald-50/40]="annotation.authorType === 'agent'"
      [class.ml-4]="annotation.authorType === 'agent' && variant() === 'desktop'"
      [class.ml-2]="annotation.authorType === 'agent' && variant() === 'mobile'"
      [class.p-3]="variant() === 'mobile'"
      [class.p-4]="variant() === 'desktop'"
    >
      <!-- Author & Time -->
      <div class="mb-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5">
          <div
            class="flex h-5 w-5 items-center justify-center rounded-full text-[10px]"
            [class.bg-blue-100]="annotation.authorType === 'customer'"
            [class.text-blue-600]="annotation.authorType === 'customer'"
            [class.bg-emerald-100]="annotation.authorType === 'agent'"
            [class.text-emerald-600]="annotation.authorType === 'agent'"
          >
            @if (annotation.authorType === 'customer') {
              <lucide-icon name="user" class="h-3 w-3"></lucide-icon>
            } @else {
              <lucide-icon name="shield-check" class="h-3 w-3"></lucide-icon>
            }
          </div>
          <span
            class="text-[10px] font-black uppercase tracking-widest"
            [class.text-blue-500]="annotation.authorType === 'customer'"
            [class.text-emerald-600]="annotation.authorType === 'agent'"
          >
            {{ annotation.authorType === 'customer'
              ? ('offertes.proposal.annotation.customer' | translate)
              : (organizationName() || ('offertes.proposal.annotation.agent' | translate))
            }}
          </span>
        </div>
        <span class="text-[9px] font-medium text-slate-400">
          {{ annotation.createdAt | date:'HH:mm' }}
        </span>
      </div>

      <div class="flex items-start gap-2">
        @if (variant() === 'mobile') {
          <p
            class="text-[12px] font-medium leading-snug text-slate-700"
            [class.text-emerald-900]="annotation.authorType === 'agent'"
          >{{ annotation.text }}</p>
        } @else {
          <p
            class="text-sm font-medium leading-snug text-zinc-700"
            [class.text-emerald-900]="annotation.authorType === 'agent'"
          >{{ annotation.text }}</p>
        }
      </div>

      @if (canEdit() && annotation.authorType === 'customer' && !lockEdits()) {
        <div class="mt-3 flex justify-end gap-3 pt-2">
          <button
            type="button"
            class="text-[10px] font-black uppercase tracking-wider text-red-500 hover:text-red-700 transition-colors"
            (click)="requestRemove.emit(annotation)"
            [disabled]="deletingId() === annotation.id"
          >
            {{ 'common.delete' | translate }}
          </button>
          <button
            type="button"
            class="text-[10px] font-black uppercase tracking-wider text-blue-600 hover:text-blue-800 transition-colors"
            (click)="requestEdit.emit(annotation)"
          >
            {{ 'common.edit' | translate }}
          </button>
        </div>
      }
    </div>
  }
</div>
</file>

