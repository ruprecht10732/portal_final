<file path="src/app/core/services/quotes.types.ts">
// Quote types — aligned with backend API (cents-based)


// Backend uses PascalCase enum values
export type QuoteStatus = 'Draft' | 'Sent' | 'Accepted' | 'Rejected' | 'Expired';

export type DiscountType = 'percentage' | 'fixed';

/**
 * Tax rate in basis points. 2100 = 21%, 900 = 9%, 0 = 0%.
 * The backend stores and returns BPS; the frontend converts for display.
 */

/** Legacy display-friendly rate (0 | 9 | 21). Used only in the UI. */
export type TaxRateDisplay = 0 | 9 | 21;

export type PricingMode = 'exclusive' | 'inclusive';

// ── API Response types (from backend) ─────────────────────────────────────────

export interface QuoteItemResponse {
  id: string;
  description: string;
  quantity: string;
  unitPriceCents: number;
  taxRateBps: number;
  isOptional: boolean;
  isSelected: boolean;
  sortOrder: number;
  totalBeforeTaxCents: number;
  totalTaxCents: number;
  lineTotalCents: number;
  catalogProductId?: string;
  annotations: AnnotationResponse[];
}

export interface VatBreakdown {
  rateBps: number;
  amountCents: number;
}

// ── Attachment & URL types ────────────────────────────────────────────────────

export type AttachmentSource = 'catalog' | 'manual';

export interface QuoteAttachmentResponse {
  id: string;
  filename: string;
  fileKey: string;
  source: AttachmentSource;
  catalogProductId?: string;
  enabled: boolean;
  sortOrder: number;
  createdAt: string;
}

export interface QuoteURLResponse {
  id: string;
  label: string;
  href: string;
  accepted: boolean;
  catalogProductId?: string;
  createdAt: string;
}

export interface QuoteAttachmentRequest {
  filename: string;
  fileKey: string;
  source: AttachmentSource;
  catalogProductId?: string;
  enabled: boolean;
  sortOrder: number;
}

export interface QuoteURLRequest {
  label: string;
  href: string;
  catalogProductId?: string;
}

export interface PresignAttachmentUploadRequest {
  fileName: string;
  contentType: string;
  sizeBytes: number;
}

export interface PresignedUploadResponse {
  uploadUrl: string;
  fileKey: string;
  expiresAt: number;
}

export interface PresignedDownloadResponse {
  downloadUrl: string;
  expiresAt: number;
}

export interface QuoteResponse {
  id: string;
  quoteNumber: string;
  leadId: string;
  leadServiceId?: string;
  createdById?: string;
  createdByFirstName?: string;
  createdByLastName?: string;
  createdByEmail?: string;
  customerFirstName?: string;
  customerLastName?: string;
  customerPhone?: string;
  customerEmail?: string;
  customerAddressStreet?: string;
  customerAddressHouseNumber?: string;
  customerAddressZipCode?: string;
  customerAddressCity?: string;
  status: QuoteStatus;
  pricingMode: PricingMode;
  discountType: DiscountType;
  discountValue: number; // percentage int or cents
  subtotalCents: number;
  discountAmountCents: number;
  taxTotalCents: number;
  totalCents: number;
  validUntil?: string;
  notes?: string;
  items: QuoteItemResponse[];
  attachments: QuoteAttachmentResponse[];
  urls: QuoteURLResponse[];
  pdfFileKey?: string;
  financingDisclaimer: boolean;
  createdAt: string;
  updatedAt: string;
}

export interface QuoteListResponse {
  items: QuoteResponse[];
  total: number;
  page: number;
  pageSize: number;
  totalPages: number;
}

export interface QuotePreviewLinkResponse {
  token: string;
  expiresAt?: string;
}

export interface CalculatedLineItem {
  description: string;
  quantity: string;
  unitPriceCents: number;
  taxRateBps: number;
  isOptional: boolean;
  totalBeforeTaxCents: number;
  totalTaxCents: number;
  lineTotalCents: number;
}

export interface QuoteCalculationResponse {
  lines: CalculatedLineItem[];
  subtotalCents: number;
  discountAmountCents: number;
  vatTotalCents: number;
  vatBreakdown: VatBreakdown[];
  totalCents: number;
}

// ── API Request types ─────────────────────────────────────────────────────────

export interface QuoteItemRequest {
  description: string;
  quantity: string;
  unitPriceCents: number;
  taxRateBps: number;
  isOptional: boolean;
  catalogProductId?: string;
}

export interface CreateQuoteRequest {
  leadId: string;
  leadServiceId?: string;
  pricingMode?: PricingMode;
  discountType?: DiscountType;
  discountValue?: number;
  validUntil?: string;
  notes?: string;
  items: QuoteItemRequest[];
  attachments?: QuoteAttachmentRequest[];
  urls?: QuoteURLRequest[];
  financingDisclaimer?: boolean;
}

export interface UpdateQuoteRequest {
  pricingMode?: PricingMode;
  discountType?: DiscountType;
  discountValue?: number;
  validUntil?: string;
  notes?: string;
  items?: QuoteItemRequest[];
  attachments?: QuoteAttachmentRequest[];
  urls?: QuoteURLRequest[];
  financingDisclaimer?: boolean;
}

export interface QuoteCalculationRequest {
  items: QuoteItemRequest[];
  pricingMode?: PricingMode;
  discountType?: DiscountType;
  discountValue?: number;
}

// ── Enriched frontend type (quote + lead info) ────────────────────────────────

// ── Helpers ───────────────────────────────────────────────────────────────────

/**
 * Parse numeric value from free-form quantity string.
 * Examples: "5 x" -> 5, "10 m²" -> 10, "3.5 uur" -> 3.5
 */
export function parseQuantityNumber(quantity: string): number {
  const match = /^([\d.,]+)/.exec(quantity);
  if (!match?.[1]) return 1;
  return Number.parseFloat(match[1].replace(',', '.')) || 1;
}

/** Convert a display tax rate (21) to basis points (2100). */
export function taxDisplayToBps(rate: TaxRateDisplay): number {
  return rate * 100;
}

/** Convert basis points (2100) to a display rate (21). */
export function taxBpsToDisplay(bps: number): TaxRateDisplay {
  return (bps / 100) as TaxRateDisplay;
}

/** Convert euros to cents. */
export function eurosToCents(euros: number): number {
  return Math.round(euros * 100);
}

/** Convert cents to euros. */
export function centsToEuros(cents: number): number {
  return cents / 100;
}

export function formatQuoteCustomerName(quote: QuoteResponse): string {
  const first = quote.customerFirstName ?? '';
  const last = quote.customerLastName ?? '';
  return `${first} ${last}`.trim();
}

export function formatQuoteCreatedBy(quote: QuoteResponse): string {
  const first = quote.createdByFirstName ?? '';
  const last = quote.createdByLastName ?? '';
  const fullName = `${first} ${last}`.trim();
  if (fullName) return fullName;
  return quote.createdByEmail ?? '';
}

// Status display helpers — keys match backend PascalCase enum
export const QUOTE_STATUS_LABELS: Record<QuoteStatus, string> = {
  Draft: 'Draft',
  Sent: 'Sent',
  Accepted: 'Accepted',
  Rejected: 'Rejected',
  Expired: 'Expired',
};

export const QUOTE_STATUS_COLORS: Record<QuoteStatus, string> = {
  Draft: 'bg-zinc-100 text-zinc-600',
  Sent: 'bg-blue-100 text-blue-700',
  Accepted: 'bg-green-100 text-green-700',
  Rejected: 'bg-red-100 text-red-700',
  Expired: 'bg-orange-100 text-orange-700',
};

export const TAX_RATE_OPTIONS: { label: string; value: TaxRateDisplay; bps: number }[] = [
  { label: '21% BTW', value: 21, bps: 2100 },
  { label: '9% BTW', value: 9, bps: 900 },
  { label: '0% (vrijgesteld)', value: 0, bps: 0 },
];

export const DISCOUNT_TYPE_OPTIONS: { label: string; value: DiscountType }[] = [
  { label: '%', value: 'percentage' },
  { label: '€', value: 'fixed' },
];

// ── Public Quote Proposal types ───────────────────────────────────────────────

export interface AnnotationResponse {
  id: string;
  itemId: string;
  authorType: 'customer' | 'agent';
  authorId?: string;
  text: string;
  isResolved: boolean;
  createdAt: string;
}

export interface PublicQuoteItemResponse {
  id: string;
  description: string;
  quantity: string;
  unitPriceCents: number;
  taxRateBps: number;
  isOptional: boolean;
  isSelected: boolean;
  sortOrder: number;
  totalBeforeTaxCents: number;
  totalTaxCents: number;
  lineTotalCents: number;
  annotations: AnnotationResponse[];
}

export interface PublicQuoteResponse {
  id: string;
  quoteNumber: string;
  status: QuoteStatus;
  pricingMode: PricingMode;
  organizationName: string;
  customerName: string;
  subtotalCents: number;
  discountAmountCents: number;
  taxTotalCents: number;
  totalCents: number;
  validUntil?: string;
  notes?: string;
  viewedAt?: string;
  acceptedAt?: string;
  rejectedAt?: string;
  financingDisclaimer: boolean;
  isReadOnly?: boolean;
  items: PublicQuoteItemResponse[];
  attachments: QuoteAttachmentResponse[];
  urls: QuoteURLResponse[];
  vatBreakdown: VatBreakdown[];
}

export interface ToggleItemResponse {
  subtotalCents: number;
  discountAmountCents: number;
  taxTotalCents: number;
  totalCents: number;
  vatBreakdown: VatBreakdown[];
}

export interface AcceptQuoteRequest {
  signatureName: string;
  signatureData: string;
}

export interface RejectQuoteRequest {
  reason?: string | undefined;
}

// ── Activity timeline ─────────────────────────────────────────────────────────

export interface QuoteActivityResponse {
  id: string;
  eventType: string;
  message: string;
  metadata?: Record<string, unknown>;
  createdAt: string;
}

// ── AI Generate types ─────────────────────────────────────────────────────────

export interface GenerateQuoteRequest {
  leadId: string;
  leadServiceId: string;
  prompt: string;
  quoteId?: string;
}

export interface GenerateQuoteResponse {
  quoteId: string;
  quoteNumber: string;
  itemCount: number;
}
</file>

<file path="src/app/routes/leads/lead-detail/lead-detail.component.html">
<div class="flex flex-col gap-4">
  <!-- ARIA Live Region for screen reader announcements -->
  <div aria-live="polite" aria-atomic="true" class="sr-only">
    {{ announcement() }}
  </div>

  <!-- Confirmation Dialog -->
  <shared-confirm-dialog
    [isOpen]="showConfirmDialog()"
    [title]="confirmDialogTitle()"
    [message]="confirmDialogMessage()"
    [confirmText]="'leads.detail.confirmLabel' | translate"
    [cancelText]="'leads.detail.cancel' | translate"
    confirmVariant="primary"
    (confirm)="confirmStatusChange()"
    (cancelled)="cancelConfirmDialog()"
  />

  <!-- Call Logger Dialog -->
  <shared-call-logger-dialog
    [isOpen]="showCallLoggerDialog()"
    [isProcessing]="callLoggerProcessing()"
    [result]="callLoggerResult()"
    [missingInformation]="callLoggerMissingInformation()"
    (submitSummary)="submitCallLogger($event)"
    (dismiss)="closeCallLogger()"
  />

  <app-lead-detail-top-section
    [lead]="lead()"
    [fullName]="getFullName()"
    [serviceTypeLabel]="headerServiceTypeLabel()"
    [status]="selectedService()?.status ?? null"
    [pipelineStage]="selectedService()?.pipelineStage ?? null"
    [noServiceLabel]="headerNoServiceLabel()"
    [statusMenuOpen]="statusMenuOpen()"
    [statusOptions]="statusOptions()"
    [selectedStatus]="selectedService()?.status ?? null"
    [statusLabelMap]="headerStatusLabels()"
    [energyLabelClass]="energyLabelClass()"
    [energyLabelVariant]="energyLabelVariant()"
    [phone]="lead() ? lead()!.consumer.phone : null"
    [email]="lead() ? (lead()!.consumer.email ?? null) : null"
    [hasSelectedService]="!!selectedService()"
    (back)="goBack()"
    (toggleStatusMenu)="toggleStatusMenu()"
    (closeStatusMenu)="closeStatusMenu()"
    (selectStatus)="selectStatus($event)"
    (createQuote)="createQuote()"
    (callClicked)="callLead()"
    (emailClicked)="emailLead()"
    (navigateClicked)="navigateToLead()"
    (logCallClicked)="openCallLogger()"
    (quoteClicked)="createQuote()"
  />

  @if (error()) {
    <div role="alert" aria-live="assertive" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">
      {{ error() }}
    </div>
  }

  @if (loading()) {
    <app-lead-detail-skeleton />
  }

  @if (lead(); as l) {
    <div class="px-4">
      <div class="lg:hidden mb-4">
        <a
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-black px-4 py-4 text-white font-semibold"
          [href]="getMapUrl()"
          target="_blank"
          rel="noopener"
        >
          {{ 'leads.detail.navigateToAddress' | translate }}
        </a>
      </div>

      <div class="lg:hidden flex flex-col gap-4">
        <app-lead-detail-info-cards
          [energyLabel]="energyLabel()"
          [leadEnrichment]="leadEnrichment()"
          [leadScore]="leadScore()"
          [lead]="l"
          [selectedService]="selectedService()"
        />

        <app-lead-detail-mobile-consumer-card
          [fullName]="getFullName()"
          [fullAddress]="getFullAddress()"
          [mapUrl]="getMapUrl()"
          [copiedAddress]="copiedAddress()"
          [phone]="l.consumer.phone"
          [email]="l.consumer.email ?? null"
          [role]="l.consumer.role"
          [assignedTo]="l.assignedAgentId ? getUserLabelById(l.assignedAgentId) : null"
          [hasSelectedService]="!!selectedService()"
          (openCallLogger)="openCallLogger()"
          (copyAddress)="copyAddress()"
        />

        <shared-card padding="none">
          <details>
            <summary class="cursor-pointer px-4 py-3 text-sm font-semibold">{{ 'leads.detail.notesActivity' | translate }}</summary>
            <div class="px-4 pb-4">
              <app-lead-detail-notes-panel
                #notePanelMobile
                [noteId]="'note-input-mobile'"
                [noteText]="noteText()"
                [noteType]="noteType()"
                [canSubmit]="canSubmitNote()"
                [isSaving]="noteSaving()"
                [activityFeed]="activityFeed()"
                [formatTimestamp]="formatHumanDateTime"
                [showHeader]="false"
                (noteTextChange)="noteText.set($event)"
                (noteTypeChange)="noteType.set($event)"
                (addNote)="addNote()"
              />
            </div>
          </details>
        </shared-card>

        <app-lead-detail-services-panel
          [services]="l.services"
          [selectedServiceId]="selectedServiceId()"
          [serviceTypeLabels]="serviceTypeLabels()"
          [statusLabels]="statusLabels()"
          [statusColors]="STATUS_COLORS"
          [showAddForm]="showAddServiceForm()"
          [serviceTypeOptions]="serviceTypeOptions()"
          [newServiceType]="newServiceType()"
          [newServiceConsumerNote]="newServiceConsumerNote()"
          [newServiceSource]="newServiceSource()"
          [closeCurrentService]="closeCurrentService()"
          [saving]="saving()"
          (openAdd)="openAddServiceForm()"
          (cancelAdd)="cancelAddService()"
          (addService)="addService()"
          (selectService)="selectService($event)"
          (newServiceTypeChange)="newServiceType.set($event)"
          (newServiceConsumerNoteChange)="newServiceConsumerNote.set($event)"
          (newServiceSourceChange)="newServiceSource.set($event)"
          (closeCurrentServiceChange)="closeCurrentService.set($event)"
        />
      </div>

      <div class="hidden lg:grid lg:grid-cols-[1fr_2fr] gap-4">
        <aside class="flex flex-col gap-4">
          <app-lead-detail-sidebar-info
            [fullAddress]="getFullAddress()"
            [mapUrl]="getMapUrl()"
            [latitude]="l.address.latitude ?? null"
            [longitude]="l.address.longitude ?? null"
            [fullName]="getFullName()"
            [phone]="l.consumer.phone"
            [email]="l.consumer.email ?? null"
            [role]="l.consumer.role"
            [assignedTo]="l.assignedAgentId ? getUserLabelById(l.assignedAgentId) : null"
            [hasSelectedService]="!!selectedService()"
            [copiedAddress]="copiedAddress()"
            (copyAddress)="copyAddress()"
            (openCallLogger)="openCallLogger()"
          />

          <shared-card>
            <app-lead-inquiry-card [lead]="l" [selectedService]="selectedService()"></app-lead-inquiry-card>
          </shared-card>

          <app-lead-detail-services-panel
            [services]="l.services"
            [selectedServiceId]="selectedServiceId()"
            [serviceTypeLabels]="serviceTypeLabels()"
            [statusLabels]="statusLabels()"
            [statusColors]="STATUS_COLORS"
            [showAddForm]="showAddServiceForm()"
            [serviceTypeOptions]="serviceTypeOptions()"
            [newServiceType]="newServiceType()"
            [newServiceConsumerNote]="newServiceConsumerNote()"
            [newServiceSource]="newServiceSource()"
            [closeCurrentService]="closeCurrentService()"
            [saving]="saving()"
            (openAdd)="openAddServiceForm()"
            (cancelAdd)="cancelAddService()"
            (addService)="addService()"
            (selectService)="selectService($event)"
            (newServiceTypeChange)="newServiceType.set($event)"
            (newServiceConsumerNoteChange)="newServiceConsumerNote.set($event)"
            (newServiceSourceChange)="newServiceSource.set($event)"
            (closeCurrentServiceChange)="closeCurrentService.set($event)"
          />

          <app-lead-detail-info-cards
            [energyLabel]="energyLabel()"
            [leadEnrichment]="leadEnrichment()"
            [leadScore]="leadScore()"
            [lead]="l"
            [selectedService]="selectedService()"
          />
        </aside>

        <main class="flex flex-col gap-4">
          <app-lead-detail-tabs-shell
            [tabs]="tabs()"
            [activeTab]="activeTab()"
            variant="pills"
            (tabChange)="onTabChange($event)"
          >
            @if (activeTab() === 'activity') {
              <app-lead-detail-notes-panel
                #notePanelDesktop
                [noteId]="'note-input-desktop'"
                [noteText]="noteText()"
                [noteType]="noteType()"
                [canSubmit]="canSubmitNote()"
                [isSaving]="noteSaving()"
                [activityFeed]="activityFeed()"
                [formatTimestamp]="formatHumanDateTime"
                (noteTextChange)="noteText.set($event)"
                (noteTypeChange)="noteType.set($event)"
                (addNote)="addNote()"
              />
            } @else if (activeTab() === 'appointments') {
              <app-lead-detail-appointments-tab
                [appointments]="appointments()"
                [appointmentsLoading]="appointmentsLoading()"
                [appointmentsError]="appointmentsError()"
                [showAppointmentForm]="showAppointmentForm()"
                [appointmentSaving]="appointmentSaving()"
                [appointmentDate]="appointmentDate()"
                [appointmentTime]="appointmentTime()"
                [appointmentDurationMinutes]="appointmentDurationMinutes()"
                [appointmentTitle]="appointmentTitle()"
                [appointmentLocation]="appointmentLocation()"
                [appointmentNotes]="appointmentNotes()"
                [selectedAppointmentId]="selectedAppointmentId()"
                [selectedAppointment]="selectedAppointment()"
                [minDate]="minDate()"
                [canSaveAppointment]="canSaveAppointment()"
                [canEditReport]="canEditReport()"
                [reportSaving]="reportSaving()"
                [reportMeasurements]="reportMeasurements()"
                [reportAccessDifficulty]="reportAccessDifficulty()"
                [reportNotes]="reportNotes()"
                [accessDifficultyOptions]="accessDifficultyOptions()"
                [attachmentsLoading]="attachmentsLoading()"
                [attachments]="attachments()"
                [attachmentFileKey]="attachmentFileKey()"
                [attachmentFileName]="attachmentFileName()"
                [attachmentContentType]="attachmentContentType()"
                [attachmentSizeBytes]="attachmentSizeBytes()"
                [attachmentSaving]="attachmentSaving()"
                [canAddAttachment]="canAddAttachment()"
                [formatHumanDateTime]="formatHumanDateTime"
                (toggleAppointmentForm)="toggleAppointmentForm()"
                (setAppointmentDate)="setAppointmentDate($event)"
                (setAppointmentTime)="setAppointmentTime($event)"
                (setAppointmentDurationMinutes)="setAppointmentDurationMinutes($event)"
                (setAppointmentTitle)="setAppointmentTitle($event)"
                (setAppointmentLocation)="setAppointmentLocation($event)"
                (setAppointmentNotes)="setAppointmentNotes($event)"
                (createAppointment)="createAppointment()"
                (selectAppointment)="selectAppointment($event)"
                (setReportMeasurements)="setReportMeasurements($event)"
                (setAccessDifficulty)="setAccessDifficulty($event)"
                (setReportNotes)="setReportNotes($event)"
                (saveVisitReport)="saveVisitReport()"
                (setAttachmentFileKey)="setAttachmentFileKey($event)"
                (setAttachmentFileName)="setAttachmentFileName($event)"
                (setAttachmentContentType)="setAttachmentContentType($event)"
                (setAttachmentSizeBytes)="setAttachmentSizeBytes($event)"
                (addAttachment)="addAttachment()"
              />
            } @else if (activeTab() === 'timeline') {
              <app-lead-detail-timeline-tab
                [timelineItems]="timelineItems()"
                [timelineLoading]="timelineLoading()"
                [timelineError]="timelineError()"
                [copiedContactMessage]="copiedContactMessage()"
                [leadPhone]="lead()!.consumer.phone"
                [leadEmail]="lead()!.consumer.email ?? null"
                [formatHumanDateTime]="formatHumanDateTime"
                [getTimelineTypeLabel]="getTimelineTypeLabel"
                [getTimelineTypeBadgeClass]="getTimelineTypeBadgeClass"
                [getTimelinePartnerSummary]="getTimelinePartnerSummary"
                [getTimelineEstimation]="getTimelineEstimation"
                [getTimelineRecommendedAction]="getTimelineRecommendedAction"
                [getTimelineContactMessage]="getTimelineContactMessage"
                [getTimelineMissingInformation]="getTimelineMissingInformation"
                [getTimelineScore]="getTimelineScore"
                [getTimelineDraftedQuote]="getTimelineDraftedQuote"
                (openCallLogger)="openCallLogger()"
                (openWhatsApp)="openWhatsApp($event.phone, $event.message)"
                (composeEmail)="composeEmail($event.email, $event.message)"
                (copyContactMessage)="copyContactMessage($event.itemId, $event.message)"
                (viewDraftQuote)="viewDraftQuote($event)"
              />
            } @else if (activeTab() === 'files') {
              <app-lead-detail-files-tab
                [hasSelectedService]="!!selectedService()"
                [serviceAttachmentError]="serviceAttachmentError()"
                [serviceAttachmentUploading]="serviceAttachmentUploading()"
                [serviceAttachmentsLoading]="serviceAttachmentsLoading()"
                [serviceAttachments]="serviceAttachments()"
                [serviceAttachmentDeleting]="serviceAttachmentDeleting()"
                [maxServiceAttachmentSizeBytes]="maxServiceAttachmentSizeBytes()"
                [formatFileSize]="formatFileSize"
                [presign]="presignServiceAttachment"
                [finalize]="finalizeServiceAttachment"
                (uploaded)="handleServiceAttachmentUploaded($any($event))"
                (uploadError)="handleServiceAttachmentError($event)"
                (uploadingChange)="serviceAttachmentUploading.set($event)"
                (downloadAttachment)="downloadServiceAttachment($event)"
                (deleteAttachment)="deleteServiceAttachment($event)"
              />
            }
          </app-lead-detail-tabs-shell>
        </main>
      </div>
    </div>
  }
</div>
