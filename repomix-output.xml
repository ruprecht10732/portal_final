<file path="src/app/routes/appointments/appointment-detail/appointment-detail.component.html">
<div class="flex flex-col w-full h-full">
  @if (loading()) {
    <div class="flex items-center justify-center flex-1">
      <div class="animate-spin h-8 w-8 border-2 border-zinc-300 border-t-black rounded-full"></div>
    </div>
  } @else if (!appointment()) {
    <div class="flex flex-col items-center justify-center flex-1 gap-4 p-6">
      <p class="text-zinc-500">{{ 'appointments.detail.notFound' | translate }}</p>
      <shared-button variant="secondary" (clicked)="goBack()">
        {{ 'common.back' | translate }}
      </shared-button>
    </div>
  } @else {
    <!-- Mobile layout -->
    <div class="sm:hidden flex flex-col pb-16">
      <nav class="sticky top-0 z-40 grid grid-cols-[40px_1fr_40px] items-center border-b border-gray-100 bg-white/70 px-4 py-4 backdrop-blur">
        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100/60 transition-transform active:scale-95"
          (click)="goBack()"
          [attr.aria-label]="'common.back' | translate"
        >
          <lucide-icon name="chevron-left" class="h-5 w-5 text-slate-700" aria-hidden="true"></lucide-icon>
        </button>
        <div class="flex flex-col items-center">
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">{{ 'appointments.detail.type' | translate }}</span>
          <span class="text-sm font-semibold tracking-tight truncate max-w-50">{{ appointment()!.title }}</span>
        </div>
        <div></div>
      </nav>

      <main>
        @if (error()) {
          <div class="bg-red-50 border-b border-red-500 text-red-900 p-4 text-sm font-medium flex items-start gap-3">
            <span class="font-bold uppercase text-red-600 shrink-0">{{ 'common.error' | translate }}</span>
            <span>{{ error() }}</span>
          </div>
        }

        <!-- Status section -->
        <div class="border-b border-gray-100 bg-white px-5 pb-5 pt-5">
          <div class="flex items-center gap-2 mb-4">
            <span
              class="rounded-full px-4 py-1.5 text-[13px] font-bold shadow-lg ring-4"
              [class]="
                appointment()!.status === 'scheduled' ? 'bg-blue-600 text-white ring-blue-200' :
                appointment()!.status === 'completed' ? 'bg-emerald-600 text-white ring-emerald-200' :
                appointment()!.status === 'cancelled' ? 'bg-zinc-600 text-white ring-zinc-200' :
                'bg-amber-500 text-white ring-amber-200'
              "
            >
              {{ getStatusLabel(appointment()!.status) }}
            </span>
          </div>

          <div class="flex flex-wrap gap-1.5">
            @for (opt of statusOptions(); track opt.value) {
              <button
                type="button"
                class="px-3 py-1.5 text-xs uppercase tracking-wider border rounded-full transition-colors"
                [class.bg-black]="appointment()!.status === opt.value"
                [class.text-white]="appointment()!.status === opt.value"
                [class.border-black]="appointment()!.status === opt.value"
                [class.bg-white]="appointment()!.status !== opt.value"
                [class.text-zinc-600]="appointment()!.status !== opt.value"
                [class.border-zinc-200]="appointment()!.status !== opt.value"
                [disabled]="saving()"
                (click)="updateStatus(opt.value)"
              >
                {{ opt.label }}
              </button>
            }
          </div>
        </div>

        <!-- Actions -->
        <div class="border-b border-gray-100 bg-white px-5 py-4">
          <div class="grid gap-2">
            @if (!isEditing()) {
              <shared-button variant="secondary" size="compact" [fullWidth]="true" (clicked)="toggleEdit()">
                <lucide-icon name="pencil" class="h-4 w-4"></lucide-icon>
                {{ 'common.edit' | translate }}
              </shared-button>
            }
            <shared-button variant="danger" size="compact" [fullWidth]="true" (clicked)="promptDelete()">
              <lucide-icon name="trash-2" class="h-4 w-4"></lucide-icon>
              {{ 'common.delete' | translate }}
            </shared-button>
          </div>
        </div>

        @if (isEditing()) {
          <!-- Edit form -->
          <div class="px-5 py-5">
            <form (ngSubmit)="saveAppointment()" class="space-y-5">
              <shared-input
                [label]="'appointments.detail.title' | translate"
                [value]="editTitle()"
                (valueChange)="editTitle.set($event)"
                [required]="true"
              />

              <shared-textarea
                [label]="'appointments.detail.description' | translate"
                [rows]="3"
                [value]="editDescription()"
                (valueChange)="editDescription.set($event)"
              />

              <shared-autocomplete
                [label]="'appointments.detail.location' | translate"
                [placeholder]="'appointments.form.locationPlaceholder' | translate"
                [value]="editLocation()"
                (valueChange)="onEditLocationChange($event)"
                [options]="editLocationOptions()"
                [filterMode]="'manual'"
              />

              <shared-input
                [label]="'appointments.detail.meetingLink' | translate"
                [placeholder]="'appointments.form.meetingLinkPlaceholder' | translate"
                [value]="editMeetingLink()"
                (valueChange)="editMeetingLink.set($event)"
                type="url"
              />

              <shared-input
                [label]="'appointments.detail.startTime' | translate"
                type="datetime-local"
                [value]="editStartTime()"
                (valueChange)="editStartTime.set($event)"
                [required]="true"
                [clearable]="false"
              />
              <shared-input
                [label]="'appointments.detail.endTime' | translate"
                type="datetime-local"
                [value]="editEndTime()"
                (valueChange)="editEndTime.set($event)"
                [required]="true"
                [clearable]="false"
              />

              <shared-checkbox
                [label]="'appointments.detail.allDay' | translate"
                [checked]="editAllDay()"
                (checkedChange)="editAllDay.set($event)"
              />

              <div class="grid grid-cols-2 gap-3 pt-4 border-t border-zinc-200">
                <shared-button variant="secondary" type="button" [fullWidth]="true" (clicked)="toggleEdit()">
                  {{ 'common.cancel' | translate }}
                </shared-button>
                <shared-button variant="primary" type="submit" [fullWidth]="true" [disabled]="!canSaveEdit() || saving()">
                  {{ 'common.save' | translate }}
                </shared-button>
              </div>
            </form>
          </div>
        } @else {
          <!-- Info display -->
          <div class="mt-4">
            <div class="border-y border-gray-100 bg-white">
              @if (appointment()!.description) {
                <div class="border-b border-gray-100 px-5 py-4">
                  <p class="text-sm text-zinc-600">{{ appointment()!.description }}</p>
                </div>
              }

              <div class="divide-y divide-gray-100">
                <div class="flex items-center gap-4 px-5 py-3.5">
                  <lucide-icon name="tag" class="h-4 w-4 text-zinc-400 shrink-0"></lucide-icon>
                  <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 w-20 shrink-0">{{ 'appointments.detail.type' | translate }}</span>
                  <span class="text-sm">{{ appointment()!.type }}</span>
                </div>

                <div class="flex items-center gap-4 px-5 py-3.5">
                  <lucide-icon name="clock" class="h-4 w-4 text-zinc-400 shrink-0"></lucide-icon>
                  <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 w-20 shrink-0">{{ 'appointments.detail.when' | translate }}</span>
                  <span class="text-sm">{{ appointment()!.startTime | date:'medium' }} - {{ appointment()!.endTime | date:'shortTime' }}</span>
                </div>

                @if (appointment()!.location) {
                  <div class="flex items-center gap-4 px-5 py-3.5">
                    <lucide-icon name="map-pin" class="h-4 w-4 text-zinc-400 shrink-0"></lucide-icon>
                    <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 w-20 shrink-0">{{ 'appointments.detail.location' | translate }}</span>
                    <span class="text-sm">{{ appointment()!.location }}</span>
                  </div>
                }

                @if (appointment()!.meetingLink) {
                  <div class="flex items-center gap-4 px-5 py-3.5">
                    <lucide-icon name="video" class="h-4 w-4 text-zinc-400 shrink-0"></lucide-icon>
                    <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 w-20 shrink-0">{{ 'appointments.detail.meetingLink' | translate }}</span>
                    <a class="text-sm text-blue-600 hover:text-blue-800 underline truncate" [href]="appointment()!.meetingLink" target="_blank" rel="noopener noreferrer">
                      {{ appointment()!.meetingLink }}
                    </a>
                  </div>
                }

                @if (appointment()!.lead) {
                  <div class="flex items-center gap-4 px-5 py-3.5">
                    <lucide-icon name="user" class="h-4 w-4 text-zinc-400 shrink-0"></lucide-icon>
                    <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 w-20 shrink-0">{{ 'appointments.detail.lead' | translate }}</span>
                    <div class="text-sm">
                      {{ appointment()!.lead!.firstName }} {{ appointment()!.lead!.lastName }}
                      <span class="block text-xs text-zinc-400">{{ appointment()!.lead!.phone }}</span>
                    </div>
                  </div>
                }
              </div>
            </div>
          </div>

          <!-- Visit Report Section -->
          @if (appointment()!.type === 'lead_visit') {
            <div class="mt-4">
              <div class="border-y border-gray-100 bg-white">
                <button
                  type="button"
                  class="w-full flex items-center justify-between px-5 py-4 text-left"
                  (click)="toggleVisitReport()"
                >
                  <span class="text-xs font-bold uppercase tracking-widest text-zinc-500">
                    {{ 'appointments.detail.visitReport.title' | translate }}
                  </span>
                  <lucide-icon
                    name="chevron-down"
                    class="h-4 w-4 text-zinc-400 transition-transform"
                    [class.rotate-180]="showVisitReport()"
                  ></lucide-icon>
                </button>

                @if (showVisitReport()) {
                  <form (ngSubmit)="saveVisitReport()" class="px-5 pb-5 space-y-4">
                    <shared-textarea
                      [label]="'appointments.detail.visitReport.measurements' | translate"
                      [rows]="2"
                      [value]="reportMeasurements()"
                      (valueChange)="reportMeasurements.set($event)"
                    />

                    <shared-select
                      [label]="'appointments.detail.visitReport.accessDifficulty' | translate"
                      [options]="accessDifficultySelectOptions()"
                      [value]="reportAccessDifficulty()"
                      (valueChange)="reportAccessDifficulty.set($event ?? '')"
                      [placeholder]="'common.select' | translate"
                    />

                    <shared-textarea
                      [label]="'appointments.detail.visitReport.notes' | translate"
                      [rows]="3"
                      [value]="reportNotes()"
                      (valueChange)="reportNotes.set($event)"
                    />

                    <shared-button variant="primary" type="submit" [fullWidth]="true" [disabled]="saving()">
                      {{ 'appointments.detail.visitReport.save' | translate }}
                    </shared-button>
                  </form>
                }
              </div>
            </div>
          }
        }
      </main>
    </div>

    <!-- Desktop layout -->
    <div class="hidden sm:flex flex-col h-full">
      <div class="border-b border-zinc-200">
        <shared-page-header
          [title]="appointment()!.title"
          [backAriaLabel]="'common.back' | translate"
          (back)="goBack()"
        >
          <div actions class="flex items-center gap-2">
            @if (!isEditing()) {
              <shared-button variant="secondary" size="compact" (clicked)="toggleEdit()">
                <lucide-icon name="pencil" class="h-4 w-4 mr-1.5" aria-hidden="true"></lucide-icon>
                {{ 'common.edit' | translate }}
              </shared-button>
            }
            <shared-button variant="danger" size="compact" (clicked)="promptDelete()">
              <lucide-icon name="trash-2" class="h-4 w-4 mr-1.5" aria-hidden="true"></lucide-icon>
              {{ 'common.delete' | translate }}
            </shared-button>
          </div>
        </shared-page-header>
      </div>

      @if (error()) {
        <div class="bg-red-50 border-b border-red-500 text-red-900 p-4 text-sm font-medium flex items-start gap-3">
          <span class="font-bold uppercase text-red-600 shrink-0">{{ 'common.error' | translate }}</span>
          <span>{{ error() }}</span>
        </div>
      }

      <div class="flex-1 overflow-y-auto p-4 sm:p-6">
        <!-- Status Section -->
        <div class="mb-6">
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full"
              [class.bg-blue-100]="appointment()!.status === 'scheduled'"
              [class.text-blue-800]="appointment()!.status === 'scheduled'"
              [class.bg-green-100]="appointment()!.status === 'completed'"
              [class.text-green-800]="appointment()!.status === 'completed'"
              [class.bg-zinc-100]="appointment()!.status === 'cancelled'"
              [class.text-zinc-800]="appointment()!.status === 'cancelled'"
              [class.bg-amber-100]="appointment()!.status === 'no_show'"
              [class.text-amber-800]="appointment()!.status === 'no_show'"
            >
              {{ getStatusLabel(appointment()!.status) }}
            </span>

            <div class="flex gap-1">
              @for (opt of statusOptions(); track opt.value) {
                <button
                  type="button"
                  class="px-2 py-1 text-xs uppercase tracking-wider border rounded transition-colors"
                  [class.bg-black]="appointment()!.status === opt.value"
                  [class.text-white]="appointment()!.status === opt.value"
                  [class.border-black]="appointment()!.status === opt.value"
                  [class.bg-white]="appointment()!.status !== opt.value"
                  [class.text-zinc-600]="appointment()!.status !== opt.value"
                  [class.border-zinc-200]="appointment()!.status !== opt.value"
                  [class.hover:border-zinc-400]="appointment()!.status !== opt.value"
                  [disabled]="saving()"
                  (click)="updateStatus(opt.value)"
                >
                  {{ opt.label }}
                </button>
              }
            </div>
          </div>
        </div>

        <!-- Main Content -->
        @if (isEditing()) {
          <form (ngSubmit)="saveAppointment()" class="space-y-5">
            <shared-input
              [label]="'appointments.detail.title' | translate"
              [value]="editTitle()"
              (valueChange)="editTitle.set($event)"
              [required]="true"
            />

            <shared-textarea
              [label]="'appointments.detail.description' | translate"
              [rows]="3"
              [value]="editDescription()"
              (valueChange)="editDescription.set($event)"
            />

            <shared-autocomplete
              [label]="'appointments.detail.location' | translate"
              [placeholder]="'appointments.form.locationPlaceholder' | translate"
              [value]="editLocation()"
              (valueChange)="onEditLocationChange($event)"
              [options]="editLocationOptions()"
              [filterMode]="'manual'"
            />

            <shared-input
              [label]="'appointments.detail.meetingLink' | translate"
              [placeholder]="'appointments.form.meetingLinkPlaceholder' | translate"
              [value]="editMeetingLink()"
              (valueChange)="editMeetingLink.set($event)"
              type="url"
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <shared-input
                [label]="'appointments.detail.startTime' | translate"
                type="datetime-local"
                [value]="editStartTime()"
                (valueChange)="editStartTime.set($event)"
                [required]="true"
                [clearable]="false"
              />
              <shared-input
                [label]="'appointments.detail.endTime' | translate"
                type="datetime-local"
                [value]="editEndTime()"
                (valueChange)="editEndTime.set($event)"
                [required]="true"
                [clearable]="false"
              />
            </div>

            <shared-checkbox
              [label]="'appointments.detail.allDay' | translate"
              [checked]="editAllDay()"
              (checkedChange)="editAllDay.set($event)"
            />

            <div class="flex gap-3 pt-4 border-t border-zinc-200">
              <shared-button variant="secondary" type="button" (clicked)="toggleEdit()">
                {{ 'common.cancel' | translate }}
              </shared-button>
              <shared-button variant="primary" type="submit" [disabled]="!canSaveEdit() || saving()">
                {{ 'common.save' | translate }}
              </shared-button>
            </div>
          </form>
        } @else {
          <shared-card padding="default" className="mb-6">
            @if (appointment()!.description) {
              <p class="text-sm text-zinc-600 mb-4">{{ appointment()!.description }}</p>
            }

            <dl class="space-y-3">
              <div class="flex gap-3">
                <dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 w-24 shrink-0">
                  {{ 'appointments.detail.type' | translate }}
                </dt>
                <dd class="text-sm">{{ appointment()!.type }}</dd>
              </div>

              <div class="flex gap-3">
                <dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 w-24 shrink-0">
                  {{ 'appointments.detail.when' | translate }}
                </dt>
                <dd class="text-sm">
                  {{ appointment()!.startTime | date:'medium' }} - {{ appointment()!.endTime | date:'shortTime' }}
                </dd>
              </div>

              @if (appointment()!.location) {
                <div class="flex gap-3">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 w-24 shrink-0">
                    {{ 'appointments.detail.location' | translate }}
                  </dt>
                  <dd class="text-sm">{{ appointment()!.location }}</dd>
                </div>
              }

              @if (appointment()!.meetingLink) {
                <div class="flex gap-3">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 w-24 shrink-0">
                    {{ 'appointments.detail.meetingLink' | translate }}
                  </dt>
                  <dd class="text-sm">
                    <a
                      class="text-blue-600 hover:text-blue-800 underline"
                      [href]="appointment()!.meetingLink"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{ appointment()!.meetingLink }}
                    </a>
                  </dd>
                </div>
              }

              @if (appointment()!.lead) {
                <div class="flex gap-3">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 w-24 shrink-0">
                    {{ 'appointments.detail.lead' | translate }}
                  </dt>
                  <dd class="text-sm">
                    {{ appointment()!.lead!.firstName }} {{ appointment()!.lead!.lastName }}
                    <span class="block text-xs text-zinc-400">{{ appointment()!.lead!.phone }}</span>
                  </dd>
                </div>
              }
            </dl>
          </shared-card>

          <!-- Visit Report Section (for lead_visit type) -->
          @if (appointment()!.type === 'lead_visit') {
            <div class="border border-zinc-200 rounded">
              <button
                type="button"
                class="w-full flex items-center justify-between p-4 text-left hover:bg-zinc-50 transition-colors"
                (click)="toggleVisitReport()"
              >
                <span class="text-xs font-bold uppercase tracking-widest text-zinc-500">
                  {{ 'appointments.detail.visitReport.title' | translate }}
                </span>
                <lucide-icon
                  name="chevron-down"
                  class="h-4 w-4 text-zinc-400 transition-transform"
                  [class.rotate-180]="showVisitReport()"
                ></lucide-icon>
              </button>

              @if (showVisitReport()) {
                <form (ngSubmit)="saveVisitReport()" class="p-4 pt-0 space-y-4">
                  <shared-textarea
                    [label]="'appointments.detail.visitReport.measurements' | translate"
                    [rows]="2"
                    [value]="reportMeasurements()"
                    (valueChange)="reportMeasurements.set($event)"
                  />

                  <shared-select
                    [label]="'appointments.detail.visitReport.accessDifficulty' | translate"
                    [options]="accessDifficultySelectOptions()"
                    [value]="reportAccessDifficulty()"
                    (valueChange)="reportAccessDifficulty.set($event ?? '')"
                    [placeholder]="'common.select' | translate"
                  />

                  <shared-textarea
                    [label]="'appointments.detail.visitReport.notes' | translate"
                    [rows]="3"
                    [value]="reportNotes()"
                    (valueChange)="reportNotes.set($event)"
                  />

                  <shared-button variant="primary" type="submit" [disabled]="saving()">
                    {{ 'appointments.detail.visitReport.save' | translate }}
                  </shared-button>
                </form>
              }
            </div>
          }
        }
      </div>
    </div>
  }

  <!-- Delete Confirmation -->
  <shared-confirm-dialog
    [isOpen]="showDeleteDialog()"
    [title]="'appointments.detail.deleteTitle' | translate"
    [message]="'appointments.detail.deleteMessage' | translate"
    [confirmText]="'common.delete' | translate"
    [cancelText]="'common.cancel' | translate"
    confirmVariant="danger"
    [confirmDisabled]="deleteInProgress()"
    (confirm)="confirmDelete()"
    (cancelled)="closeDeleteDialog()"
  />
</div>
</file>

<file path="src/app/routes/appointments/appointments-calendar/appointments-calendar.component.html">
<div class="appointments-calendar">
  <!-- Mobile layout -->
  <div class="sm:hidden flex flex-col pb-16">
    <nav class="sticky top-0 z-40 grid grid-cols-[40px_1fr_40px] items-center border-b border-gray-100 bg-white/70 px-4 py-4 backdrop-blur">
      <div></div>
      <div class="flex flex-col items-center">
        <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">{{ 'appointments.calendar' | translate }}</span>
      </div>
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-white shadow-lg transition-transform active:scale-95"
        (click)="onCreateClick()"
        [attr.aria-label]="'appointments.createNew' | translate"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </button>
    </nav>

    <main>
      @if (loading()) {
        <div class="flex items-center justify-center py-12">
          <div class="h-8 w-8 animate-spin rounded-full border-[3px] border-zinc-200 border-t-black"></div>
        </div>
      } @else if (calendarEvents().length === 0) {
        <div class="flex flex-col items-center justify-center py-16 px-6">
          <div class="h-12 w-12 rounded-full bg-zinc-100 flex items-center justify-center mb-4">
            <svg class="h-6 w-6 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-zinc-900">{{ 'appointments.calendar' | translate }}</p>
          <p class="text-xs text-zinc-400 mt-1">{{ 'appointments.calendarEmpty' | translate }}</p>
        </div>
      } @else {
        <div class="flex flex-col">
          @for (event of calendarEvents(); track event.id) {
            <button
              type="button"
              class="flex items-start gap-4 border-b border-gray-100 bg-white px-5 py-4 text-left transition-colors active:bg-zinc-50"
              (click)="onEventClick(event)"
            >
              <div class="flex flex-col items-center pt-0.5">
                <span
                  class="h-3 w-3 rounded-full"
                  [class]="
                    event.status === 'completed' ? 'bg-emerald-500' :
                    event.status === 'cancelled' ? 'bg-zinc-300' :
                    event.status === 'no_show' ? 'bg-amber-500' :
                    'bg-blue-500'
                  "
                ></span>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-slate-900 truncate">{{ event.title }}</h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  {{ event.start | date:'EEE d MMM, HH:mm' }} – {{ event.end | date:'HH:mm' }}
                </p>
              </div>
              <svg class="h-4 w-4 text-zinc-300 mt-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          }
        </div>
      }
    </main>
  </div>

  <!-- Desktop layout -->
  <div class="hidden sm:block">
    <header class="calendar-header">
      <h1>{{ 'appointments.calendar' | translate }}</h1>
      <shared-button variant="primary" (clicked)="onCreateClick()">
        {{ 'appointments.createNew' | translate }}
      </shared-button>
    </header>

    <div class="calendar-container">
      <shared-calendar-grid
        [events]="calendarEvents()"
        [(view)]="view"
        [maxVisibleEvents]="3"
        [showLegend]="false"
        [allowRange]="false"
        [dayViewStartHour]="8"
        [dayViewEndHour]="18"
        [dayViewTimeSlotMinutes]="30"
        (eventClick)="onEventClick($event)"
        (slotClick)="onSlotClick($event)"
      />
    </div>
  </div>

  @if (loading()) {
    <div class="loading-overlay hidden sm:flex">
      <span class="loading-spinner"></span>
    </div>
  }
</div>
</file>

<file path="src/app/routes/catalog/catalog-detail/catalog-detail.component.html">
<div class="flex flex-col w-full pb-16 sm:pb-0">
  <div class="border-b border-zinc-200">
    <shared-page-header
      [title]="product()?.title || ('catalog.products.loading' | translate)"
      [subtitle]="product()?.reference || ''"
      [backAriaLabel]="'catalog.products.goBack' | translate"
      (back)="goBack()"
    >
      @if (product()) {
        <div actions class="flex items-center gap-2">
          <shared-button
            type="button"
            variant="secondary"
            size="compact"
            [fullWidth]="false"
            (clicked)="edit()"
          >
            <lucide-icon name="pencil" class="h-4 w-4 mr-2" aria-hidden="true"></lucide-icon>
            {{ 'catalog.products.edit' | translate }}
          </shared-button>
          <shared-button
            type="button"
            variant="danger"
            size="compact"
            [fullWidth]="false"
            (clicked)="openDeleteDialog()"
          >
            <lucide-icon name="trash-2" class="h-4 w-4 mr-2" aria-hidden="true"></lucide-icon>
            {{ 'catalog.products.delete' | translate }}
          </shared-button>
        </div>
      }
    </shared-page-header>
  </div>

  <!-- Mobile actions -->
  @if (product()) {
    <div class="sm:hidden border-b border-gray-100 bg-white px-5 py-3">
      <div class="grid grid-cols-2 gap-2">
        <shared-button variant="secondary" size="compact" [fullWidth]="true" (clicked)="edit()">
          <lucide-icon name="pencil" class="h-4 w-4"></lucide-icon>
          {{ 'catalog.products.edit' | translate }}
        </shared-button>
        <shared-button variant="danger" size="compact" [fullWidth]="true" (clicked)="openDeleteDialog()">
          <lucide-icon name="trash-2" class="h-4 w-4"></lucide-icon>
          {{ 'catalog.products.delete' | translate }}
        </shared-button>
      </div>
    </div>
  }

  <!-- Error Alert -->
  @if (error()) {
    <div class="bg-red-50 border-b border-red-500 text-red-900 p-4 text-sm font-medium flex items-start gap-3">
      <span class="font-bold uppercase text-red-600 shrink-0">{{ 'catalog.products.errorLabel' | translate }}</span>
      <span>{{ error() }}</span>
    </div>
  }

  <!-- Loading State -->
  @if (loading()) {
    <div class="flex-1 flex flex-col items-center justify-center p-12 gap-4">
      <div class="animate-spin h-10 w-10 border-4 border-zinc-100 border-t-black"></div>
      <p class="text-xs font-mono uppercase text-zinc-400">{{ 'catalog.products.loading' | translate }}</p>
    </div>
  } @else if (product()) {
    <!-- Content -->
    <div class="flex-1 overflow-y-auto">
      <div class="w-full p-4 sm:p-6 lg:p-8 overflow-x-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-6">
          <div class="flex flex-col gap-6">
            <app-catalog-detail-basics-card
              [product]="product()!"
              [heroImageUrl]="heroImageUrl()"
              [formattedVatRate]="formattedVatRate()"
              [formattedPrice]="formattedPrice()"
              [formattedUnitPrice]="formattedUnitPrice()"
              [typeLabel]="typeLabel()"
              [typeVariant]="getTypeVariant(product()!.type)"
              [createdAt]="product()!.createdAt"
              [updatedAt]="product()!.updatedAt"
              [updateProduct]="onUpdateProduct"
              [vatRates]="vatRates()"
              [selectedVatRateId]="product()!.vatRateId"
              [typeOptions]="typeOptions()"
              [selectedType]="product()!.type"
              [onVatRateChange]="onVatRateChange"
              [onTypeChange]="onTypeChange"
              [heroImages]="heroImages()"
              [onSelectHeroImage]="onSelectHeroImage"
              [onPreviewHeroImage]="onPreviewHeroImage"
              [onDeleteHeroImage]="onDeleteHeroImage"
            />
          </div>

          <div class="flex flex-col gap-6">
            <!-- Assets Section -->
            <app-catalog-detail-assets-card
              [assetsCount]="assets().length"
              [assetsError]="assetsError()"
              [assetsLoading]="assetsLoading()"
              [imageAssets]="imageAssets()"
              [documentAssets]="documentAssets()"
              [termsAssets]="termsAssets()"
              [imagePreviewUrls]="imagePreviewUrls()"
              [formatFileSize]="onFormatFileSize"
              [previewAsset]="onPreviewAsset"
              [downloadAsset]="onDownloadAsset"
              [deleteAsset]="onDeleteAsset"
              [presignImageAsset]="presignImageAsset"
              [finalizeImageAsset]="finalizeImageAsset"
              [presignDocumentAsset]="presignDocumentAsset"
              [finalizeDocumentAsset]="finalizeDocumentAsset"
              [createTermsUrl]="onCreateTermsUrl"
              [onAssetUploaded]="onAssetUploaded"
              [onAssetError]="onAssetError"
            />

            <!-- Materials Section (for services only) -->
            @if (showMaterials()) {
              <app-catalog-detail-materials-card
                [materials]="materials()"
                [materialsLoading]="materialsLoading()"
                [formatMaterialPrice]="onFormatMaterialPrice"
                [openAddMaterialDialog]="onOpenAddMaterialDialog"
              />
            }
          </div>
        </div>
      </div>
    </div>
  }

  <!-- Delete Confirmation Dialog -->
  <shared-confirm-dialog
    [isOpen]="showDeleteDialog()"
    [title]="'catalog.products.deleteConfirmTitle' | translate"
    [message]="'catalog.products.deleteConfirmMessage' | translate"
    [confirmText]="'catalog.products.confirmDelete' | translate"
    [cancelText]="'catalog.products.cancel' | translate"
    confirmVariant="danger"
    [confirmDisabled]="deleting()"
    (confirm)="confirmDelete()"
    (cancelled)="closeDeleteDialog()"
  />

  <shared-file-preview-dialog
    [isOpen]="previewOpen()"
    [title]="previewTitle()"
    [fileUrl]="previewUrl()"
    [fileName]="previewFileName()"
    [contentType]="previewContentType()"
    [isLoading]="previewLoading()"
    [error]="previewError()"
    (closed)="closePreview()"
  />

  <shared-confirm-dialog
    [isOpen]="showDeleteAssetDialog()"
    [title]="deleteAssetTitleKey() | translate"
    [message]="deleteAssetMessageKey() | translate"
    [confirmText]="'catalog.products.confirmDelete' | translate"
    [cancelText]="'catalog.products.cancel' | translate"
    confirmVariant="danger"
    (confirm)="confirmDeleteAsset()"
    (cancelled)="closeDeleteAssetDialog()"
  />

  <shared-confirm-dialog
    [isOpen]="showAddMaterialDialog()"
    [title]="'catalog.products.addMaterialTitle' | translate"
    [confirmText]="'catalog.products.addSelected' | translate"
    [cancelText]="'catalog.products.cancel' | translate"
    confirmVariant="primary"
    [confirmDisabled]="addingMaterials() || selectedMaterialCount() === 0"
    (confirm)="addSelectedMaterials()"
    (cancelled)="closeAddMaterialDialog()"
  >
    <div class="max-h-64 overflow-y-auto">
      @if (availableMaterials().length === 0) {
        <p class="text-sm text-zinc-500 py-4 text-center">
          {{ 'catalog.products.noAvailableMaterials' | translate }}
        </p>
      } @else {
        <div class="divide-y divide-zinc-100">
          @for (material of availableMaterials(); track material.id) {
            <label class="flex items-center gap-3 p-3 hover:bg-zinc-50 cursor-pointer transition-colors">
              <input
                type="checkbox"
                [checked]="isMaterialSelected(material.id)"
                (change)="toggleMaterialSelection(material.id)"
                class="h-4 w-4 text-black border-zinc-300 rounded focus:ring-black"
              />
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-zinc-900 truncate">{{ material.title }}</p>
                <p class="text-xs text-zinc-500 font-mono">{{ material.reference }}</p>
              </div>
              <span class="text-sm font-medium text-zinc-600">{{ formatMaterialPrice(material.priceCents, material.unitPriceCents, material.unitLabel) }}</span>
            </label>
          }
        </div>
      }
    </div>
  </shared-confirm-dialog>
</div>
</file>

<file path="src/app/routes/dashboard/components/lead-heatmap/lead-heatmap.component.html">
<shared-card>
  <div class="flex flex-col gap-6 sm:gap-8">
    
    <div class="flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between">
      
      <div class="flex flex-col gap-1.5 max-w-2xl">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">
          {{ 'dashboard.heatmap.title' | translate }}
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          {{ 'dashboard.heatmap.subtitle' | translate }}
        </p>
      </div>

      <div class="flex flex-col gap-4 w-full xl:w-auto">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
          
          <div class="w-full sm:w-44">
            <shared-input
              type="date"
              [label]="'dashboard.heatmap.startDate' | translate"
              [value]="startDate()"
              (valueChange)="startDate.set($event)"
            />
          </div>
          
          <div class="w-full sm:w-44">
            <shared-input
              type="date"
              [label]="'dashboard.heatmap.endDate' | translate"
              [value]="endDate()"
              (valueChange)="endDate.set($event)"
            />
          </div>

          <div class="grid grid-cols-2 gap-2 w-full sm:w-auto sm:flex">
            <shared-button
              variant="primary"
              size="compact"
              [uppercase]="false"
              [fullWidth]="true"
              [disabled]="!canApply()"
              (clicked)="applyFilter()"
              class="sm:w-auto"
            >
              {{ 'dashboard.heatmap.apply' | translate }}
            </shared-button>
            
            <shared-button
              variant="secondary"
              size="compact"
              [uppercase]="false"
              [fullWidth]="true"
              (clicked)="clearFilter()"
              class="sm:w-auto"
            >
              {{ 'dashboard.heatmap.clear' | translate }}
            </shared-button>
          </div>
        </div>

        @if (dateRangeInvalid()) {
          <div class="flex items-center gap-2 rounded-md bg-red-50 px-3 py-2 text-xs font-medium text-red-700 animate-in slide-in-from-top-1 dark:bg-red-900/20 dark:text-red-400">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            {{ 'dashboard.heatmap.dateError' | translate }}
          </div>
        }
      </div>
    </div>

    <section 
      class="relative h-105 w-full overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 shadow-inner isolation-isolate dark:border-zinc-800 dark:bg-zinc-900" 
      [attr.aria-label]="'dashboard.heatmap.mapLabel' | translate"
    >
      <div #mapContainer class="h-full w-full"></div>

      @if (loading()) {
        <div class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-white/80 backdrop-blur-sm dark:bg-zinc-900/80" aria-live="polite">
          <div class="h-5 w-5 animate-spin rounded-full border-2 border-zinc-200 border-t-zinc-900 dark:border-zinc-700 dark:border-t-white"></div>
          <span class="text-xs font-medium text-zinc-600 dark:text-zinc-400">
            {{ 'dashboard.heatmap.loading' | translate }}
          </span>
        </div>
      } 
      
      @else if (error()) {
        <div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-white/95 backdrop-blur-sm dark:bg-zinc-900/95" aria-live="polite">
          <div class="flex flex-col items-center gap-2 p-4 text-center">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-red-50 text-red-600 dark:bg-red-900/20 dark:text-red-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <p class="text-sm font-medium text-zinc-900 dark:text-white">
              {{ error() | translate }}
            </p>
          </div>
        </div>
      } 
      
      @else if (!points().length) {
        <div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-white/50 backdrop-blur-[2px] dark:bg-zinc-900/50" aria-live="polite">
          <div class="flex flex-col items-center gap-2">
            <svg class="h-8 w-8 text-zinc-300 dark:text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">
              {{ 'dashboard.heatmap.empty' | translate }}
            </p>
          </div>
        </div>
      }
    </section>
  </div>
</shared-card>
