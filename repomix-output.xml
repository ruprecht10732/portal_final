export type PartnerRow = Partner & { logoUrl?: string | null } & Record<string, unknown>;

const MAX_LENGTHS = {
  businessName: 200,
  kvkNumber: 20,
  vatNumber: 20,
  addressLine1: 200,
  houseNumber: 20,
  addressLine2: 200,
  postalCode: 20,
  city: 120,
