.file-preview-dialog {
  position: fixed;
  inset: 0;
  z-index: 70;
  margin: auto;
  width: calc(100% - 2rem);
  max-width: 860px;
  border: 0;
  padding: 0;
  background: #ffffff;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
}

.file-preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #e4e4e7;
}

.file-preview-title {
  font-size: 0.95rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #18181b;
}

.file-preview-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  width: 32px;
  border-radius: 999px;
  border: 1px solid #e4e4e7;
  background: #ffffff;
  color: #71717a;
  transition: border-color 120ms ease, color 120ms ease;
}

.file-preview-close:hover {
  border-color: #d4d4d8;
  color: #18181b;
}

.file-preview-body {
  padding: 20px;
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-preview-image {
  max-width: 100%;
  max-height: 70vh;
  border-radius: 12px;
  border: 1px solid #e4e4e7;
  object-fit: contain;
  background: #fafafa;
}

.file-preview-frame {
  width: 100%;
  height: 70vh;
  border: 1px solid #e4e4e7;
  border-radius: 12px;
  background: #fafafa;
}

.file-preview-state {
  font-size: 0.85rem;
  color: #71717a;
}

.file-preview-error {
  font-size: 0.85rem;
  color: #b91c1c;
}

.file-preview-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 20px 20px;
}

.file-preview-link {
  font-size: 0.85rem;
  color: #18181b;
  text-decoration: underline;
}
