<div class="offer-page">
  @if (loading()) {
    <div class="loading-container">
      <div class="spinner"></div>
      <p>{{ 'partners.offer.loading' | translate }}</p>
    </div>
  } @else if (errorKey() && !offer()) {
    <div class="error-container">
      <div class="error-icon">&#9888;</div>
      <p>{{ errorKey() | translate }}</p>
    </div>
  } @else if (offer(); as o) {
    <header class="offer-header">
      @if (isPreview()) {
        <div class="status-banner" style="background: #dbeafe; color: #1e40af; margin-bottom: 16px;">
          {{ 'partners.offer.previewBanner' | translate }}
        </div>
      }
      <h1>{{ 'partners.offer.title' | translate }}</h1>
      <p class="org-name">{{ o.organizationName }}</p>
    </header>

    <!-- Status banner -->
    @if (!isActionable() || done()) {
      <div class="status-banner" [class.accepted]="done() === 'accepted' || o.status === 'accepted'"
           [class.rejected]="done() === 'rejected' || o.status === 'rejected'"
           [class.expired]="isExpired()">
        {{ statusLabelKey() | translate }}
      </div>
    }

    <!-- Offer details card -->
    <div class="offer-card">
      <div class="detail-row">
        <span class="label">{{ 'partners.offer.details.job' | translate }}</span>
        <span class="value">{{ o.jobSummary }}</span>
      </div>
      <div class="detail-row">
        <span class="label">{{ 'partners.offer.details.location' | translate }}</span>
        <span class="value">{{ o.city }}</span>
      </div>
      <div class="detail-row">
        <span class="label">{{ 'partners.offer.details.fee' | translate }}</span>
        <span class="value price">{{ priceDisplay() }}</span>
      </div>
      <div class="detail-row">
        <span class="label">{{ 'partners.offer.details.source' | translate }}</span>
        <span class="value">
          {{ o.pricingSource === 'quote'
            ? ('partners.offer.pricingSource.quote' | translate)
            : ('partners.offer.pricingSource.estimate' | translate) }}
        </span>
      </div>
      <div class="detail-row">
        <span class="label">{{ 'partners.offer.details.validUntil' | translate }}</span>
        <span class="value">{{ o.expiresAt | date:'d MMMM yyyy, HH:mm':'':'nl-NL' }}</span>
      </div>
    </div>

    <!-- Error after action attempt -->
    @if (errorKey()) {
      <div class="inline-error">{{ errorKey() | translate }}</div>
    }

    <!-- Action buttons -->
    @if (isActionable() && !done() && !showAcceptForm() && !showRejectForm()) {
      <div class="action-buttons">
        <button class="btn btn-primary" (click)="openAcceptForm()">
          {{ 'partners.offer.actions.accept' | translate }}
        </button>
        <button class="btn btn-secondary" (click)="openRejectForm()">
          {{ 'partners.offer.actions.reject' | translate }}
        </button>
      </div>
    }

    <!-- Accept form -->
    @if (showAcceptForm()) {
      <div class="form-section">
        <h2>{{ 'partners.offer.accept.title' | translate }}</h2>
        <p class="form-hint">{{ 'partners.offer.accept.hint' | translate }}</p>

        @for (slot of inspectionSlots(); track $index) {
          <div class="slot-row">
            <label>
              {{ 'partners.offer.accept.from' | translate }}
              <input type="datetime-local" [ngModel]="slot.start"
                     (ngModelChange)="updateInspectionSlotStart($index, $event)" />
            </label>
            <label>
              {{ 'partners.offer.accept.to' | translate }}
              <input type="datetime-local" [ngModel]="slot.end"
                     (ngModelChange)="updateInspectionSlotEnd($index, $event)" />
            </label>
            @if (inspectionSlots().length > 1) {
              <button class="btn-icon" type="button" (click)="removeInspectionSlot($index)"
                      [attr.aria-label]="'partners.offer.accept.removeSlotAria' | translate">&times;</button>
            }
          </div>
        }
        <button class="btn btn-link" type="button" (click)="addInspectionSlot()">
          {{ 'partners.offer.accept.addInspectionSlot' | translate }}
        </button>

        <h3>
          {{ 'partners.offer.accept.jobTitle' | translate }}
          <span class="optional">{{ 'partners.offer.accept.optional' | translate }}</span>
        </h3>
        @for (slot of jobSlots(); track $index) {
          <div class="slot-row">
            <label>
              {{ 'partners.offer.accept.from' | translate }}
              <input type="datetime-local" [ngModel]="slot.start"
                     (ngModelChange)="updateJobSlotStart($index, $event)" />
            </label>
            <label>
              {{ 'partners.offer.accept.to' | translate }}
              <input type="datetime-local" [ngModel]="slot.end"
                     (ngModelChange)="updateJobSlotEnd($index, $event)" />
            </label>
            <button class="btn-icon" type="button" (click)="removeJobSlot($index)"
                    [attr.aria-label]="'partners.offer.accept.removeSlotAria' | translate">&times;</button>
          </div>
        }
        <button class="btn btn-link" type="button" (click)="addJobSlot()">
          {{ 'partners.offer.accept.addJobSlot' | translate }}
        </button>

        <div class="form-actions">
          <button class="btn btn-primary" (click)="submitAccept()" [disabled]="accepting()">
            @if (accepting()) {
              {{ 'partners.offer.actions.busy' | translate }}
            } @else {
              {{ 'partners.offer.actions.confirmAccept' | translate }}
            }
          </button>
          <button class="btn btn-secondary" (click)="cancelForm()" [disabled]="accepting()">
            {{ 'partners.offer.actions.cancel' | translate }}
          </button>
        </div>
      </div>
    }

    <!-- Reject form -->
    @if (showRejectForm()) {
      <div class="form-section">
        <h2>{{ 'partners.offer.reject.title' | translate }}</h2>
        <label class="reject-label">
          {{ 'partners.offer.reject.reasonLabel' | translate }}
          <textarea rows="3" maxlength="500" [ngModel]="rejectReason()"
                    (ngModelChange)="rejectReason.set($event)"
                    [placeholder]="'partners.offer.reject.placeholder' | translate"></textarea>
        </label>
        <div class="form-actions">
          <button class="btn btn-danger" (click)="submitReject()" [disabled]="rejecting()">
            @if (rejecting()) {
              {{ 'partners.offer.actions.busy' | translate }}
            } @else {
              {{ 'partners.offer.actions.confirmReject' | translate }}
            }
          </button>
          <button class="btn btn-secondary" (click)="cancelForm()" [disabled]="rejecting()">
            {{ 'partners.offer.actions.cancel' | translate }}
          </button>
        </div>
      </div>
    }

    <!-- Success messages -->
    @if (done() === 'accepted') {
      <div class="success-message">
        <p>
          <strong>{{ 'partners.offer.success.thanks' | translate }}</strong>
          {{ 'partners.offer.success.accepted' | translate }}
        </p>
      </div>
    }
    @if (done() === 'rejected') {
      <div class="success-message rejected">
        <p>{{ 'partners.offer.success.rejected' | translate }}</p>
      </div>
    }
  }
</div>
</file>

