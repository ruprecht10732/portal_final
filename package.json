{
  "name": "my-portal-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ./scripts/build-with-stamp.mjs",
    "build:prod": "node ./scripts/build-with-stamp.mjs --configuration production",
    "build:portaldev": "node ./scripts/build-with-stamp.mjs --configuration portaldev",
    "build:publicdev": "node ./scripts/build-with-stamp.mjs --configuration publicdev",
    "start:portaldev": "ng serve --configuration portaldev",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "analyze:deps": "madge --ts-config tsconfig.app.json --circular --extensions ts src/main.ts",
    "analyze:orphans": "madge --ts-config tsconfig.app.json --orphans --extensions ts src/main.ts",
    "analyze:graph": "madge --ts-config tsconfig.app.json --extensions ts src/main.ts --image documentation/deps.svg",
    "analyze:json": "madge --ts-config tsconfig.app.json --extensions ts src/main.ts --json > documentation/deps.json",
    "docs:compodoc": "compodoc -p tsconfig.app.json -d documentation"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@angular/animations": "21.1.2",
    "@angular/aria": "21.1.2",
    "@angular/cdk": "21.1.2",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/platform-browser": "21.1.2",
    "@angular/router": "21.1.2",
    "@iplab/ngx-color-picker": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "chart.js": "^4.5.1",
    "dayjs": "1.11.19",
    "gsap": "3.12.5",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "libphonenumber-js": "1.12.36",
    "lucide-angular": "0.563.0",
    "marked": "^15.0.12",
    "ngx-quill": "^30.0.1",
    "ngx-translate-multi-http-loader": "20.0.0",
    "quill": "^2.0.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.2.0",
    "@angular/build": "21.1.2",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "21.1.2",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/leaflet": "^1.9.12",
    "@types/quill": "^2.0.14",
    "angular-eslint": "21.2.0",
    "eslint": "9.39.2",
    "jsdom": "27.4.0",
    "madge": "^8.0.0",
    "postcss": "8.5.6",
    "stylelint": "17.1.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.0.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.0.18"
  }
}
